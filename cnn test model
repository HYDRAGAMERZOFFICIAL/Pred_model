html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\"> Non-trainable params: </span><span style=\"color: #00af00; text-decoration-color: #00af00\">5,888</span> (23.00 KB)\n","</pre>\n"]},"metadata":{}}],"source":["# ============================================================\n","# U-NET SEMANTIC SEGMENTATION FOR WATER / LAND CLASSIFICATION\n","# Framework: TensorFlow / Keras\n","# Input: NDWI or multi-band satellite rasters (GeoTIFF)\n","# ============================================================\n","\n","!pip install rasterio tensorflow scikit-image -q\n","\n","import os\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import rasterio\n","import tensorflow as tf\n","from tensorflow.keras import layers, models, callbacks\n","from google.colab import files\n","\n","# ------------------------------------------------------------\n","# 0. CONFIG\n","# ------------------------------------------------------------\n","\n","PATCH_SIZE   = 256          # tile size fed into the network\n","STRIDE       = 256          # set < PATCH_SIZE for overlapping tiles\n","BATCH_SIZE   = 8\n","EPOCHS       = 50\n","N_CHANNELS   = 1            # 1 for NDWI-only, >1 if you stack bands (e.g. NIR, Green, SWIR)\n","SEED         = 42\n","\n","np.random.seed(SEED)\n","tf.random.set_seed(SEED)\n","\n","\n","# ------------------------------------------------------------\n","# 1. LOAD RASTER(S)\n","# ------------------------------------------------------------\n","# You need pairs of: input image (NDWI or multi-band stack) + label mask\n","# (0 = land, 1 = water). If you don't have hand-labeled masks yet,\n","# your Otsu output from the previous script is a usable starting point\n","# (weak/pseudo-labels) — swap it in for `label_path` below.\n","\n","def load_raster(path, band_indices=None):\n","    \"\"\"Read a GeoTIFF as (H, W, C) float32 array.\"\"\"\n","    with rasterio.open(path) as src:\n","        if band_indices is None:\n","            arr = src.read().astype(np.float32)          # (bands, H, W)\n","        else:\n","            arr = src.read(band_indices).astype(np.float32)\n","        arr = np.transpose(arr, (1, 2, 0))                # -> (H, W, C)\n","        nodata = src.nodata\n","    return arr, nodata\n","\n","\n","def normalize(img):\n","    \"\"\"Per-channel min-max normalization to [0, 1], NaN-safe.\"\"\"\n","    img = np.nan_to_num(img, nan=0.0)\n","    out = np.zeros_like(img, dtype=np.float32)\n","    for c in range(img.shape[-1]):\n","        band = img[..., c]\n","        mn, mx = band.min(), band.max()\n","        if mx > mn:\n","            out[..., c] = (band - mn) / (mx - mn)\n","    return out\n","\n","\n","# ------------------------------------------------------------\n","# 2. PATCH EXTRACTION (tiling)\n","# ------------------------------------------------------------\n","# Large satellite scenes can't be fed in whole — cut into fixed patches.\n","# Pads the image so it divides evenly by PATCH_SIZE.\n","\n","def extract_patches(image, mask, patch_size=PATCH_SIZE, stride=STRIDE):\n","    h, w = image.shape[:2]\n","    pad_h = (patch_size - h % patch_size) % patch_size\n","    pad_w = (patch_size - w % patch_size) % patch_size\n","\n","    image_p = np.pad(image, ((0, pad_h), (0, pad_w), (0, 0)), mode=\"reflect\")\n","    mask_p  = np.pad(mask,  ((0, pad_h), (0, pad_w)),          mode=\"reflect\")\n","\n","    img_patches, mask_patches = [], []\n","    H, W = image_p.shape[:2]\n","\n","    for y in range(0, H - patch_size + 1, stride):\n","        for x in range(0, W - patch_size + 1, stride):\n","            img_patches.append(image_p[y:y+patch_size, x:x+patch_size, :])\n","            mask_patches.append(mask_p[y:y+patch_size, x:x+patch_size])\n","\n","    return np.array(img_patches), np.array(mask_patches)\n","\n","\n","# ------------------------------------------------------------\n","# 3. U-NET MODEL\n","# ------------------------------------------------------------\n","\n","def conv_block(x, filters):\n","    x = layers.Conv2D(filters, 3, padding=\"same\", activation=\"relu\")(x)\n","    x = layers.BatchNormalization()(x)\n","    x = layers.Conv2D(filters, 3, padding=\"same\", activation=\"relu\")(x)\n","    x = layers.BatchNormalization()(x)\n","    return x\n","\n","\n","def build_unet(input_shape=(PATCH_SIZE, PATCH_SIZE, N_CHANNELS)):\n","    inputs = layers.Input(shape=input_shape)\n","\n","    # Encoder\n","    c1 = conv_block(inputs, 32); p1 = layers.MaxPooling2D()(c1)\n","    c2 = conv_block(p1, 64);     p2 = layers.MaxPooling2D()(c2)\n","    c3 = conv_block(p2, 128);    p3 = layers.MaxPooling2D()(c3)\n","    c4 = conv_block(p3, 256);    p4 = layers.MaxPooling2D()(c4)\n","\n","    # Bottleneck\n","    bn = conv_block(p4, 512)\n","\n","    # Decoder (with skip connections)\n","    u4 = layers.Conv2DTranspose(256, 2, strides=2, padding=\"same\")(bn)\n","    u4 = layers.Concatenate()([u4, c4]); c5 = conv_block(u4, 256)\n","\n","    u3 = layers.Conv2DTranspose(128, 2, strides=2, padding=\"same\")(c5)\n","    u3 = layers.Concatenate()([u3, c3]); c6 = conv_block(u3, 128)\n","\n","    u2 = layers.Conv2DTranspose(64, 2, strides=2, padding=\"same\")(c6)\n","    u2 = layers.Concatenate()([u2, c2]); c7 = conv_block(u2, 64)\n","\n","    u1 = layers.Conv2DTranspose(32, 2, strides=2, padding=\"same\")(c7)\n","    u1 = layers.Concatenate()([u1, c1]); c8 = conv_block(u1, 32)\n","\n","    outputs = layers.Conv2D(1, 1, activation=\"sigmoid\")(c8)\n","\n","    return models.Model(inputs, outputs, name=\"UNet\")\n","\n","\n","# ------------------------------------------------------------\n","# 4. LOSS + METRICS\n","# ------------------------------------------------------------\n","# Plain binary cross-entropy alone tends to underperform when water\n","# pixels are a minority class. Dice loss handles class imbalance\n","# much better, so we combine both.\n","\n","def dice_coef(y_true, y_pred, smooth=1e-6):\n","    y_true_f = tf.reshape(y_true, [-1])\n","    y_pred_f = tf.reshape(y_pred, [-1])\n","    intersection = tf.reduce_sum(y_true_f * y_pred_f)\n","    return (2. * intersection + smooth) / (\n","        tf.reduce_sum(y_true_f) + tf.reduce_sum(y_pred_f) + smooth\n","    )\n","\n","def dice_loss(y_true, y_pred):\n","    return 1 - dice_coef(y_true, y_pred)\n","\n","def bce_dice_loss(y_true, y_pred):\n","    bce = tf.keras.losses.binary_crossentropy(y_true, y_pred)\n","    return tf.reduce_mean(bce) + dice_loss(y_true, y_pred)\n","\n","def iou_metric(y_true, y_pred, smooth=1e-6):\n","    y_true_f = tf.reshape(y_true, [-1])\n","    y_pred_f = tf.cast(tf.reshape(y_pred, [-1]) > 0.5, tf.float32)\n","    intersection = tf.reduce_sum(y_true_f * y_pred_f)\n","    union = tf.reduce_sum(y_true_f) + tf.reduce_sum(y_pred_f) - intersection\n","    return (intersection + smooth) / (union + smooth)\n","\n","\n","# ------------------------------------------------------------\n","# 5. BUILD + COMPILE\n","# ------------------------------------------------------------\n","\n","model = build_unet()\n","model.compile(\n","    optimizer=tf.keras.optimizers.Adam(learning_rate=1e-4),\n","    loss=bce_dice_loss,\n","    metrics=[dice_coef, iou_metric, \"accuracy\"]\n",")\n","model.summary()\n","\n","\n","# ------------------------------------------------------------\n","# 6. LOAD DATA, BUILD TRAIN/VAL SPLIT\n","# ------------------------------------------------------------\n","# Fill in your actual paths. If you have several scenes, loop over\n","# them and concatenate the patch arrays.\n","#\n","# image_path = \"your_ndwi_or_stack.tif\"\n","# label_path = \"your_mask.tif\"        # binary 0/1 raster\n","#\n","# image, _ = load_raster(image_path)\n","# image = normalize(image)\n","# label, _ = load_raster(label_path)\n","# label = (label[..., 0] > 0).astype(np.float32)\n","#\n","# X, Y = extract_patches(image, label)\n","# Y = Y[..., np.newaxis]\n","#\n","# from sklearn.model_selection import train_test_split\n","# X_train, X_val, Y_train, Y_val = train_test_split(\n","#     X, Y, test_size=0.2, random_state=SEED\n","# )\n","\n","\n","# ------------------------------------------------------------\n","# 7. TRAIN\n","# ------------------------------------------------------------\n","# Uncomment once X_train/Y_train/X_val/Y_val are defined above.\n","#\n","# cb = [\n","#     callbacks.ModelCheckpoint(\"best_unet.h5\", save_best_only=True,\n","#                                monitor=\"val_iou_metric\", mode=\"max\"),\n","#     callbacks.EarlyStopping(patience=10, restore_best_weights=True,\n","#                              monitor=\"val_iou_metric\", mode=\"max\"),\n","#     callbacks.ReduceLROnPlateau(factor=0.5, patience=5, monitor=\"val_loss\")\n","# ]\n","#\n","# history = model.fit(\n","#     X_train, Y_train,\n","#     validation_data=(X_val, Y_val),\n","#     batch_size=BATCH_SIZE,\n","#     epochs=EPOCHS,\n","#     callbacks=cb\n","# )\n","#\n","# plt.plot(history.history[\"iou_metric\"], label=\"train IoU\")\n","# plt.plot(history.history[\"val_iou_metric\"], label=\"val IoU\")\n","# plt.xlabel(\"Epoch\"); plt.ylabel(\"IoU\"); plt.legend(); plt.show()\n","\n","\n","# ------------------------------------------------------------\n","# 8. SLIDING-WINDOW PREDICTION ON A FULL SCENE + STITCHING\n","# ------------------------------------------------------------\n","\n","def predict_full_raster(model, image, patch_size=PATCH_SIZE, stride=None):\n","    \"\"\"Run the trained model over a full raster via sliding window,\n","    averaging overlapping predictions, then crop back to original size.\"\"\"\n","    if stride is None:\n","        stride = patch_size\n","\n","    h, w = image.shape[:2]\n","    pad_h = (patch_size - h % patch_size) % patch_size\n","    pad_w = (patch_size - w % patch_size) % patch_size\n","    image_p = np.pad(image, ((0, pad_h), (0, pad_w), (0, 0)), mode=\"reflect\")\n","    H, W = image_p.shape[:2]\n","\n","    pred_sum   = np.zeros((H, W), dtype=np.float32)\n","    pred_count = np.zeros((H, W), dtype=np.float32)\n","\n","    for y in range(0, H - patch_size + 1, stride):\n","        for x in range(0, W - patch_size + 1, stride):\n","            patch = image_p[y:y+patch_size, x:x+patch_size, :]\n","            pred = model.predict(patch[np.newaxis, ...], verbose=0)[0, ..., 0]\n","            pred_sum[y:y+patch_size, x:x+patch_size]   += pred\n","            pred_count[y:y+patch_size, x:x+patch_size] += 1\n","\n","    pred_avg = pred_sum / np.maximum(pred_count, 1)\n","    return pred_avg[:h, :w]   # crop back to original size\n","\n","\n","# Example usage once training is done:\n","# new_image, _ = load_raster(\"new_scene.tif\")\n","# new_image = normalize(new_image)\n","# prob_map = predict_full_raster(model, new_image, stride=PATCH_SIZE // 2)\n","# binary_map = (prob_map > 0.5).astype(np.uint8)\n","#\n","# plt.figure(figsize=(12, 6))\n","# plt.subplot(1, 2, 1); plt.imshow(new_image[..., 0], cmap=\"gray\"); plt.title(\"Input\")\n","# plt.subplot(1, 2, 2); plt.imshow(binary_map, cmap=\"gray\"); plt.title(\"Predicted Water Mask\")\n","# plt.tight_layout(); plt.show()"]},{"cell_type":"code","source":["# ============================================================\n","# MULTI-TEMPORAL U-NET\n","# NDWI WATER SEGMENTATION + NEXT-PERIOD FORECAST\n","# ============================================================\n","\n","!pip install -q rasterio tensorflow scikit-image opencv-python\n","\n","import os\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import rasterio\n","import cv2\n","import tensorflow as tf\n","\n","from google.colab import files\n","from tensorflow.keras import layers, models, callbacks\n","\n","\n","# ============================================================\n","# 1. CONFIGURATION\n","# ============================================================\n","\n","INPUT_TIMESTEPS = 2\n","PATCH_SIZE = 64\n","STRIDE = 16\n","MIN_VALID_FRAC = 0.3\n","\n","BATCH_SIZE = 15\n","EPOCHS = 12\n","LEARNING_RATE = 1e-5\n","\n","SEED = 100\n","\n","np.random.seed(SEED)\n","tf.random.set_seed(SEED)\n","\n","\n","# ============================================================\n","# 2. UPLOAD NDWI FILES\n","# ============================================================\n","\n","print(\"Upload your NDWI GeoTIFF files.\")\n","print(\"Upload them in chronological order.\")\n","\n","uploaded = files.upload()\n","\n","uploaded_paths = list(uploaded.keys())\n","\n","print(\"\\nUploaded files:\")\n","for p in uploaded_paths:\n","    print(\"  \", p)\n","\n","\n","# ============================================================\n","# 3. CHECK FILES\n","# ============================================================\n","\n","if len(uploaded_paths) == 0:\n","    raise ValueError(\"No GeoTIFF files were uploaded.\")\n","\n","for path in uploaded_paths:\n","\n","    if not path.lower().endswith((\".tif\", \".tiff\")):\n","        raise ValueError(\n","            f\"{path} is not a TIFF file.\"\n","        )\n","\n","\n","# ============================================================\n","# 4. LOCATION REGISTRY\n","# ============================================================\n","\n","# For now, all uploaded files are treated as ONE location.\n","#\n","# Example:\n","#\n","# JAN_APR_22.tif\n","# MAY_AUG_22.tif\n","# SEP_DEC_22.tif\n","#\n","# Upload them chronologically.\n","\n","LOCATIONS = {\n","    \"location_01\": uploaded_paths\n","}\n","\n","\n","# ============================================================\n","# 5. LOAD NDWI\n","# ============================================================\n","\n","def load_ndwi(path):\n","\n","    with rasterio.open(path) as src:\n","\n","        image = src.read(1).astype(np.float32)\n","        nodata = src.nodata\n","\n","    # Valid pixels\n","    valid_mask = np.isfinite(image)\n","\n","    if nodata is not None:\n","        valid_mask &= image != nodata\n","\n","    # Remove extreme nodata values\n","    valid_mask &= image > -1e30\n","\n","    # Replace invalid pixels with zero\n","    image = np.where(\n","        valid_mask,\n","        image,\n","        0.0\n","    ).astype(np.float32)\n","\n","    return image, valid_mask\n","\n","\n","# ============================================================\n","# 6. NORMALIZATION\n","# ============================================================\n","\n","def normalize(image, valid_mask):\n","\n","    if valid_mask.sum() == 0:\n","        return np.zeros_like(\n","            image,\n","            dtype=np.float32\n","        )\n","\n","    values = image[valid_mask]\n","\n","    minimum = values.min()\n","    maximum = values.max()\n","\n","    normalized = np.zeros_like(\n","        image,\n","        dtype=np.float32\n","    )\n","\n","    if maximum > minimum:\n","\n","        normalized[valid_mask] = (\n","            (image[valid_mask] - minimum)\n","            /\n","            (maximum - minimum)\n","        )\n","\n","    return normalized\n","\n","\n","# ============================================================\n","# 7. OTSU PSEUDO LABEL\n","# ============================================================\n","\n","def otsu_binary_mask(image, valid_mask):\n","\n","    values = image[valid_mask]\n","\n","    if values.size == 0:\n","        return np.zeros_like(\n","            image,\n","            dtype=np.float32\n","        )\n","\n","    minimum = values.min()\n","    maximum = values.max()\n","\n","    if maximum <= minimum:\n","\n","        return np.zeros_like(\n","            image,\n","            dtype=np.float32\n","        )\n","\n","    # Convert valid NDWI pixels to 0-255\n","    gray_values = (\n","        (values - minimum)\n","        /\n","        (maximum - minimum)\n","        *\n","        255\n","    ).astype(np.uint8)\n","\n","    # Otsu threshold\n","    otsu_8bit, _ = cv2.threshold(\n","        gray_values.reshape(-1, 1),\n","        0,\n","        255,\n","        cv2.THRESH_BINARY + cv2.THRESH_OTSU\n","    )\n","\n","    # Convert threshold back to original NDWI scale\n","    otsu_threshold = (\n","        (otsu_8bit / 255.0)\n","        *\n","        (maximum - minimum)\n","        +\n","        minimum\n","    )\n","\n","    mask = np.zeros_like(\n","        image,\n","        dtype=np.float32\n","    )\n","\n","    mask[valid_mask] = (\n","        image[valid_mask] >= otsu_threshold\n","    ).astype(np.float32)\n","\n","    return mask\n","\n","\n","# ============================================================\n","# 8. PAD / CROP\n","# ============================================================\n","\n","def pad_or_crop(\n","    image,\n","    valid_mask,\n","    target_h,\n","    target_w\n","):\n","\n","    h, w = image.shape\n","\n","    output_image = np.zeros(\n","        (target_h, target_w),\n","        dtype=np.float32\n","    )\n","\n","    output_mask = np.zeros(\n","        (target_h, target_w),\n","        dtype=bool\n","    )\n","\n","    # Crop coordinates\n","    y0 = max(\n","        (h - target_h) // 2,\n","        0\n","    )\n","\n","    x0 = max(\n","        (w - target_w) // 2,\n","        0\n","    )\n","\n","    cropped_image = image[\n","        y0:y0 + target_h,\n","        x0:x0 + target_w\n","    ]\n","\n","    cropped_mask = valid_mask[\n","        y0:y0 + target_h,\n","        x0:x0 + target_w\n","    ]\n","\n","    ch, cw = cropped_image.shape\n","\n","    # Center placement\n","    py0 = max(\n","        (target_h - ch) // 2,\n","        0\n","    )\n","\n","    px0 = max(\n","        (target_w - cw) // 2,\n","        0\n","    )\n","\n","    output_image[\n","        py0:py0 + ch,\n","        px0:px0 + cw\n","    ] = cropped_image\n","\n","    output_mask[\n","        py0:py0 + ch,\n","        px0:px0 + cw\n","    ] = cropped_mask\n","\n","    return output_image, output_mask\n","\n","\n","# ============================================================\n","# 9. BUILD LOCATION SAMPLE\n","# ============================================================\n","\n","def build_location_sample(\n","    paths,\n","    target_h,\n","    target_w\n","):\n","\n","    # IMPORTANT:\n","    # Files are used in the upload order.\n","    # Do NOT automatically sort them because that can\n","    # destroy the intended temporal order.\n","\n","    loaded = [\n","        load_ndwi(path)\n","        for path in paths\n","    ]\n","\n","    images = [\n","        normalize(image, mask)\n","        for image, mask in loaded\n","    ]\n","\n","    valid_masks = [\n","        mask\n","        for _, mask in loaded\n","    ]\n","\n","    number_of_images = len(images)\n","\n","    # --------------------------------------------------------\n","    # CASE 1:\n","    # More than INPUT_TIMESTEPS\n","    # --------------------------------------------------------\n","\n","    if number_of_images >= INPUT_TIMESTEPS + 1:\n","\n","        input_images = images[\n","            -(INPUT_TIMESTEPS + 1):-1\n","        ]\n","\n","        target_image = images[-1]\n","        target_valid_mask = valid_masks[-1]\n","\n","    # --------------------------------------------------------\n","    # CASE 2:\n","    # Exactly INPUT_TIMESTEPS\n","    # --------------------------------------------------------\n","\n","    elif number_of_images >= INPUT_TIMESTEPS:\n","\n","        input_images = images[\n","            -INPUT_TIMESTEPS:\n","        ]\n","\n","        target_image = images[-1]\n","        target_valid_mask = valid_masks[-1]\n","\n","    # --------------------------------------------------------\n","    # CASE 3:\n","    # Only one image\n","    # --------------------------------------------------------\n","\n","    else:\n","\n","        input_images = (\n","            images\n","            +\n","            [images[-1]]\n","            *\n","            (\n","                INPUT_TIMESTEPS\n","                -\n","                number_of_images\n","            )\n","        )\n","\n","        target_image = images[-1]\n","        target_valid_mask = valid_masks[-1]\n","\n","    # Keep required number of temporal channels\n","    input_images = input_images[\n","        -INPUT_TIMESTEPS:\n","    ]\n","\n","    # Otsu pseudo-label\n","    target_label = otsu_binary_mask(\n","        target_image,\n","        target_valid_mask\n","    )\n","\n","    # Resize/crop temporal images\n","    resized_inputs = []\n","\n","    for image in input_images:\n","\n","        dummy_mask = np.ones_like(\n","            image,\n","            dtype=bool\n","        )\n","\n","        resized_image, _ = pad_or_crop(\n","            image,\n","            dummy_mask,\n","            target_h,\n","            target_w\n","        )\n","\n","        resized_inputs.append(\n","            resized_image\n","        )\n","\n","    # H × W × T\n","    input_stack = np.stack(\n","        resized_inputs,\n","        axis=-1\n","    )\n","\n","    # Target\n","    target_label, target_valid_mask = pad_or_crop(\n","        target_label,\n","        target_valid_mask,\n","        target_h,\n","        target_w\n","    )\n","\n","    return (\n","        input_stack.astype(np.float32),\n","        target_label.astype(np.float32),\n","        target_valid_mask.astype(np.float32)\n","    )\n","\n","\n","# ============================================================\n","# 10. PATCH EXTRACTION\n","# ============================================================\n","\n","def pixelate_slice(\n","    input_stack,\n","    target_label,\n","    target_valid_mask,\n","    patch_size=PATCH_SIZE,\n","    stride=STRIDE,\n","    min_valid_frac=MIN_VALID_FRAC\n","):\n","\n","    H, W = input_stack.shape[:2]\n","\n","    X = []\n","    Y = []\n","\n","    # Include final edge position\n","    y_positions = list(\n","        range(\n","            0,\n","            max(H - patch_size, 0) + 1,\n","            stride\n","        )\n","    )\n","\n","    x_positions = list(\n","        range(\n","            0,\n","            max(W - patch_size, 0) + 1,\n","            stride\n","        )\n","    )\n","\n","    # Make sure last area is covered\n","    if H > patch_size:\n","        last_y = H - patch_size\n","\n","        if last_y not in y_positions:\n","            y_positions.append(last_y)\n","\n","    if W > patch_size:\n","        last_x = W - patch_size\n","\n","        if last_x not in x_positions:\n","            x_positions.append(last_x)\n","\n","    for y in y_positions:\n","\n","        for x in x_positions:\n","\n","            input_patch = input_stack[\n","                y:y + patch_size,\n","                x:x + patch_size,\n","                :\n","            ]\n","\n","            label_patch = target_label[\n","                y:y + patch_size,\n","                x:x + patch_size\n","            ]\n","\n","            valid_patch = target_valid_mask[\n","                y:y + patch_size,\n","                x:x + patch_size\n","            ]\n","\n","            if valid_patch.size == 0:\n","                continue\n","\n","            if valid_patch.mean() < min_valid_frac:\n","                continue\n","\n","            ph, pw = input_patch.shape[:2]\n","\n","            # Pad incomplete patches\n","            if (\n","                ph < patch_size\n","                or\n","                pw < patch_size\n","            ):\n","\n","                padded_input = np.zeros(\n","                    (\n","                        patch_size,\n","                        patch_size,\n","                        INPUT_TIMESTEPS\n","                    ),\n","                    dtype=np.float32\n","                )\n","\n","                padded_label = np.zeros(\n","                    (patch_size, patch_size),\n","                    dtype=np.float32\n","                )\n","\n","                padded_mask = np.zeros(\n","                    (patch_size, patch_size),\n","                    dtype=np.float32\n","                )\n","\n","                padded_input[\n","                    :ph,\n","                    :pw,\n","                    :\n","                ] = input_patch\n","\n","                padded_label[\n","                    :ph,\n","                    :pw\n","                ] = label_patch\n","\n","                padded_mask[\n","                    :ph,\n","                    :pw\n","                ] = valid_patch\n","\n","                input_patch = padded_input\n","                label_patch = padded_label\n","                valid_patch = padded_mask\n","\n","            X.append(input_patch)\n","\n","            # Channel 0 = water label\n","            # Channel 1 = valid-pixel mask\n","            Y.append(\n","                np.stack(\n","                    [\n","                        label_patch,\n","                        valid_patch\n","                    ],\n","                    axis=-1\n","                )\n","            )\n","\n","    return (\n","        np.asarray(X, dtype=np.float32),\n","        np.asarray(Y, dtype=np.float32)\n","    )\n","\n","\n","# ============================================================\n","# 11. DATA AUGMENTATION\n","# ============================================================\n","\n","def augment(x, y):\n","\n","    if np.random.rand() < 0.5:\n","\n","        x = np.fliplr(x)\n","        y = np.fliplr(y)\n","\n","    if np.random.rand() < 0.5:\n","\n","        x = np.flipud(x)\n","        y = np.flipud(y)\n","\n","    k = np.random.randint(4)\n","\n","    x = np.rot90(x, k)\n","    y = np.rot90(y, k)\n","\n","    return (\n","        x.copy(),\n","        y.copy()\n","    )\n","\n","\n","# ============================================================\n","# 12. BUILD DATASET\n","# ============================================================\n","\n","def build_dataset(locations):\n","\n","    location_ids = list(\n","        locations.keys()\n","    )\n","\n","    # --------------------------------------------------------\n","    # Find common canvas size\n","    # --------------------------------------------------------\n","\n","    max_h = 0\n","    max_w = 0\n","\n","    for paths in locations.values():\n","\n","        for path in paths:\n","\n","            with rasterio.open(path) as src:\n","\n","                max_h = max(\n","                    max_h,\n","                    src.height\n","                )\n","\n","                max_w = max(\n","                    max_w,\n","                    src.width\n","                )\n","\n","    print(\n","        f\"\\nCanvas size: {max_h} × {max_w}\"\n","    )\n","\n","    # --------------------------------------------------------\n","    # Split by location\n","    # --------------------------------------------------------\n","\n","    np.random.shuffle(location_ids)\n","\n","    if len(location_ids) > 1:\n","\n","        number_validation = max(\n","            1,\n","            int(\n","                len(location_ids) * 0.2\n","            )\n","        )\n","\n","        val_ids = location_ids[\n","            :number_validation\n","        ]\n","\n","        train_ids = location_ids[\n","            number_validation:\n","        ]\n","\n","    else:\n","\n","        # With only one location, use it for training.\n","        train_ids = location_ids\n","        val_ids = []\n","\n","    # --------------------------------------------------------\n","    # Build split\n","    # --------------------------------------------------------\n","\n","    def build_split(ids):\n","\n","        X_all = []\n","        Y_all = []\n","\n","        for location_id in ids:\n","\n","            stack, label, mask = (\n","                build_location_sample(\n","                    locations[location_id],\n","                    max_h,\n","                    max_w\n","                )\n","            )\n","\n","            X, Y = pixelate_slice(\n","                stack,\n","                label,\n","                mask\n","            )\n","\n","            if len(X) == 0:\n","                continue\n","\n","            X_all.append(X)\n","            Y_all.append(Y)\n","\n","        if len(X_all) == 0:\n","\n","            return (\n","                np.empty(\n","                    (\n","                        0,\n","                        PATCH_SIZE,\n","                        PATCH_SIZE,\n","                        INPUT_TIMESTEPS\n","                    ),\n","                    dtype=np.float32\n","                ),\n","                np.empty(\n","                    (\n","                        0,\n","                        PATCH_SIZE,\n","                        PATCH_SIZE,\n","                        2\n","                    ),\n","                    dtype=np.float32\n","                )\n","            )\n","\n","        return (\n","            np.concatenate(\n","                X_all,\n","                axis=0\n","            ),\n","            np.concatenate(\n","                Y_all,\n","                axis=0\n","            )\n","        )\n","\n","    X_train, Y_train = build_split(\n","        train_ids\n","    )\n","\n","    X_val, Y_val = build_split(\n","        val_ids\n","    )\n","\n","    # --------------------------------------------------------\n","    # Augmentation\n","    # --------------------------------------------------------\n","\n","    if len(X_train) > 0:\n","\n","        augmented = [\n","            augment(x, y)\n","            for x, y in zip(\n","                X_train,\n","                Y_train\n","            )\n","        ]\n","\n","        aug_X, aug_Y = zip(\n","            *augmented\n","        )\n","\n","        X_train = np.concatenate(\n","            [\n","                X_train,\n","                np.asarray(aug_X)\n","            ],\n","            axis=0\n","        )\n","\n","        Y_train = np.concatenate(\n","            [\n","                Y_train,\n","                np.asarray(aug_Y)\n","            ],\n","            axis=0\n","        )\n","\n","    print(\n","        f\"\\nTraining patches: {len(X_train)}\"\n","    )\n","\n","    print(\n","        f\"Validation patches: {len(X_val)}\"\n","    )\n","\n","    print(\n","        f\"Training locations: {len(train_ids)}\"\n","    )\n","\n","    print(\n","        f\"Validation locations: {len(val_ids)}\"\n","    )\n","\n","    return (\n","        X_train,\n","        Y_train,\n","        X_val,\n","        Y_val,\n","        max_h,\n","        max_w\n","    )\n","\n","\n","# ============================================================\n","# 13. U-NET CONVOLUTION BLOCK\n","# ============================================================\n","\n","def conv_block(\n","    x,\n","    filters,\n","    dropout=0.1\n","):\n","\n","    x = layers.Conv2D(\n","        filters,\n","        3,\n","        padding=\"same\",\n","        activation=\"relu\"\n","    )(x)\n","\n","    x = layers.BatchNormalization()(x)\n","\n","    x = layers.Dropout(\n","        dropout\n","    )(x)\n","\n","    x = layers.Conv2D(\n","        filters,\n","        3,\n","        padding=\"same\",\n","        activation=\"relu\"\n","    )(x)\n","\n","    x = layers.BatchNormalization()(x)\n","\n","    return x\n","\n","\n","# ============================================================\n","# 14. U-NET\n","# ============================================================\n","\n","def build_unet(input_shape):\n","\n","    inputs = layers.Input(\n","        shape=input_shape,\n","        name=\"NDWI_INPUT\"\n","    )\n","\n","    # --------------------------------------------------------\n","    # Encoder\n","    # --------------------------------------------------------\n","\n","    c1 = conv_block(\n","        inputs,\n","        32\n","    )\n","\n","    p1 = layers.MaxPooling2D()(\n","        c1\n","    )\n","\n","    c2 = conv_block(\n","        p1,\n","        64\n","    )\n","\n","    p2 = layers.MaxPooling2D()(\n","        c2\n","    )\n","\n","    c3 = conv_block(\n","        p2,\n","        128\n","    )\n","\n","    p3 = layers.MaxPooling2D()(\n","        c3\n","    )\n","\n","    # --------------------------------------------------------\n","    # Bottleneck\n","    # --------------------------------------------------------\n","\n","    bottleneck = conv_block(\n","        p3,\n","        256\n","    )\n","\n","    # --------------------------------------------------------\n","    # Decoder\n","    # --------------------------------------------------------\n","\n","    u3 = layers.Conv2DTranspose(\n","        128,\n","        2,\n","        strides=2,\n","        padding=\"same\"\n","    )(bottleneck)\n","\n","    u3 = layers.Concatenate()(\n","        [u3, c3]\n","    )\n","\n","    c4 = conv_block(\n","        u3,\n","        128\n","    )\n","\n","    u2 = layers.Conv2DTranspose(\n","        64,\n","        2,\n","        strides=2,\n","        padding=\"same\"\n","    )(c4)\n","\n","    u2 = layers.Concatenate()(\n","        [u2, c2]\n","    )\n","\n","    c5 = conv_block(\n","        u2,\n","        64\n","    )\n","\n","    u1 = layers.Conv2DTranspose(\n","        32,\n","        2,\n","        strides=2,\n","        padding=\"same\"\n","    )(c5)\n","\n","    u1 = layers.Concatenate()(\n","        [u1, c1]\n","    )\n","\n","    c6 = conv_block(\n","        u1,\n","        32\n","    )\n","\n","    # --------------------------------------------------------\n","    # Output\n","    # --------------------------------------------------------\n","\n","    output = layers.Conv2D(\n","        1,\n","        1,\n","        activation=\"sigmoid\",\n","        name=\"WATER_OUTPUT\"\n","    )(c6)\n","\n","    return models.Model(\n","        inputs,\n","        output,\n","        name=\"MultiTemporalUNet\"\n","    )\n","\n","\n","# ============================================================\n","# 15. MASKED LOSS\n","# ============================================================\n","\n","def unpack_true(\n","    y_true,\n","    y_pred\n","):\n","\n","    label = y_true[..., 0]\n","\n","    valid_mask = y_true[..., 1]\n","\n","    prediction = y_pred[..., 0]\n","\n","    return (\n","        label,\n","        valid_mask,\n","        prediction\n","    )\n","\n","\n","def masked_bce_dice_loss(\n","    y_true,\n","    y_pred\n","):\n","\n","    label, mask, pred = unpack_true(\n","        y_true,\n","        y_pred\n","    )\n","\n","    pred = tf.clip_by_value(\n","        pred,\n","        1e-7,\n","        1 - 1e-7\n","    )\n","\n","    # Binary cross entropy\n","    bce = -(\n","        label * tf.math.log(pred)\n","        +\n","        (1 - label)\n","        *\n","        tf.math.log(1 - pred)\n","    )\n","\n","    bce = tf.reduce_sum(\n","        bce * mask\n","    ) / (\n","        tf.reduce_sum(mask)\n","        + 1e-6\n","    )\n","\n","    # Dice\n","    intersection = tf.reduce_sum(\n","        label * pred * mask\n","    )\n","\n","    denominator = (\n","        tf.reduce_sum(\n","            label * mask\n","        )\n","        +\n","        tf.reduce_sum(\n","            pred * mask\n","        )\n","    )\n","\n","    dice = (\n","        2.0 * intersection\n","        + 1e-6\n","    ) / (\n","        denominator\n","        + 1e-6\n","    )\n","\n","    return bce + (1.0 - dice)\n","\n","\n","# ============================================================\n","# 16. IOU\n","# ============================================================\n","\n","def masked_iou(\n","    y_true,\n","    y_pred\n","):\n","\n","    label, mask, pred = unpack_true(\n","        y_true,\n","        y_pred\n","    )\n","\n","    prediction = tf.cast(\n","        pred > 0.5,\n","        tf.float32\n","    )\n","\n","    intersection = tf.reduce_sum(\n","        label\n","        *\n","        prediction\n","        *\n","        mask\n","    )\n","\n","    union = tf.reduce_sum(\n","        tf.maximum(\n","            label,\n","            prediction\n","        )\n","        *\n","        mask\n","    )\n","\n","    return (\n","        intersection + 1e-6\n","    ) / (\n","        union + 1e-6\n","    )\n","\n","\n","# ============================================================\n","# 17. DICE\n","# ============================================================\n","\n","def masked_dice(\n","    y_true,\n","    y_pred\n","):\n","\n","    label, mask, pred = unpack_true(\n","        y_true,\n","        y_pred\n","    )\n","\n","    intersection = tf.reduce_sum(\n","        label * pred * mask\n","    )\n","\n","    denominator = (\n","        tf.reduce_sum(\n","            label * mask\n","        )\n","        +\n","        tf.reduce_sum(\n","            pred * mask\n","        )\n","    )\n","\n","    return (\n","        2.0 * intersection\n","        + 1e-6\n","    ) / (\n","        denominator\n","        + 1e-6\n","    )\n","\n","\n","# ============================================================\n","# 18. BUILD DATASET\n","# ============================================================\n","\n","(\n","    X_train,\n","    Y_train,\n","    X_val,\n","    Y_val,\n","    CANVAS_H,\n","    CANVAS_W\n",") = build_dataset(\n","    LOCATIONS\n",")\n","\n","\n","# ============================================================\n","# 19. CHECK DATA\n","# ============================================================\n","\n","if len(X_train) == 0:\n","\n","    raise ValueError(\n","        \"No training patches were generated. \"\n","        \"Check your NDWI files and MIN_VALID_FRAC.\"\n","    )\n","\n","\n","print(\"\\nInput shape:\")\n","print(X_train.shape)\n","\n","print(\"\\nTarget shape:\")\n","print(Y_train.shape)\n","\n","\n","# ============================================================\n","# 20. BUILD MODEL\n","# ============================================================\n","\n","model = build_unet(\n","    (\n","        PATCH_SIZE,\n","        PATCH_SIZE,\n","        INPUT_TIMESTEPS\n","    )\n",")\n","\n","model.compile(\n","    optimizer=tf.keras.optimizers.Adam(\n","        learning_rate=LEARNING_RATE\n","    ),\n","    loss=masked_bce_dice_loss,\n","    metrics=[\n","        masked_iou,\n","        masked_dice\n","    ]\n",")\n","\n","model.summary()\n","\n","\n","# ============================================================\n","# 21. CALLBACKS\n","# ============================================================\n","\n","training_callbacks = []\n","\n","# Only use validation callbacks when validation data exists\n","if len(X_val) > 0:\n","\n","    training_callbacks.extend(\n","        [\n","            callbacks.ModelCheckpoint(\n","                \"best_unet.keras\",\n","                save_best_only=True,\n","                monitor=\"val_masked_iou\",\n","                mode=\"max\"\n","            ),\n","\n","            callbacks.EarlyStopping(\n","                patience=15,\n","                restore_best_weights=True,\n","                monitor=\"val_masked_iou\",\n","                mode=\"max\"\n","            ),\n","\n","            callbacks.ReduceLROnPlateau(\n","                factor=0.5,\n","                patience=6,\n","                monitor=\"val_loss\"\n","            )\n","        ]\n","    )\n","\n","else:\n","\n","    training_callbacks.extend(\n","        [\n","            callbacks.ModelCheckpoint(\n","                \"best_unet.keras\",\n","                save_best_only=True,\n","                monitor=\"loss\",\n","                mode=\"min\"\n","            ),\n","\n","            callbacks.EarlyStopping(\n","                patience=15,\n","                restore_best_weights=True,\n","                monitor=\"loss\",\n","                mode=\"min\"\n","            ),\n","\n","            callbacks.ReduceLROnPlateau(\n","                factor=0.5,\n","                patience=6,\n","                monitor=\"loss\"\n","            )\n","        ]\n","    )\n","\n","\n","# ============================================================\n","# 22. TRAIN\n","# ============================================================\n","\n","if len(X_val) > 0:\n","\n","    history = model.fit(\n","        X_train,\n","        Y_train,\n","        validation_data=(\n","            X_val,\n","            Y_val\n","        ),\n","        batch_size=BATCH_SIZE,\n","        epochs=EPOCHS,\n","        callbacks=training_callbacks,\n","        shuffle=True\n","    )\n","\n","else:\n","\n","    history = model.fit(\n","        X_train,\n","        Y_train,\n","        batch_size=BATCH_SIZE,\n","        epochs=EPOCHS,\n","        callbacks=training_callbacks,\n","        shuffle=True\n","    )\n","\n","\n","# ============================================================\n","# 23. TRAINING GRAPH\n","# ============================================================\n","\n","plt.figure(\n","    figsize=(12, 5)\n",")\n","\n","plt.plot(\n","    history.history[\"loss\"],\n","    label=\"Training Loss\"\n",")\n","\n","if \"val_loss\" in history.history:\n","\n","    plt.plot(\n","        history.history[\"val_loss\"],\n","        label=\"Validation Loss\"\n","    )\n","\n","plt.xlabel(\"Epoch\")\n","plt.ylabel(\"Loss\")\n","plt.title(\"Training Loss\")\n","\n","plt.legend()\n","plt.grid(True)\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 24. IOU GRAPH\n","# ============================================================\n","\n","plt.figure(\n","    figsize=(12, 5)\n",")\n","\n","plt.plot(\n","    history.history[\"masked_iou\"],\n","    label=\"Training IoU\"\n",")\n","\n","if \"val_masked_iou\" in history.history:\n","\n","    plt.plot(\n","        history.history[\"val_masked_iou\"],\n","        label=\"Validation IoU\"\n","    )\n","\n","plt.xlabel(\"Epoch\")\n","plt.ylabel(\"IoU\")\n","plt.title(\"Water Segmentation IoU\")\n","\n","plt.legend()\n","plt.grid(True)\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 25. PREDICTION FUNCTION\n","# ============================================================\n","\n","def predict_water(\n","    model,\n","    image_paths,\n","    canvas_size\n","):\n","\n","    loaded = [\n","        load_ndwi(path)\n","        for path in image_paths\n","    ]\n","\n","    images = [\n","        normalize(image, mask)\n","        for image, mask in loaded\n","    ]\n","\n","    if len(images) >= INPUT_TIMESTEPS:\n","\n","        input_images = images[\n","            -INPUT_TIMESTEPS:\n","        ]\n","\n","    else:\n","\n","        input_images = (\n","            images\n","            +\n","            [images[-1]]\n","            *\n","            (\n","                INPUT_TIMESTEPS\n","                -\n","                len(images)\n","            )\n","        )\n","\n","    resized = []\n","\n","    for image in input_images:\n","\n","        dummy_mask = np.ones_like(\n","            image,\n","            dtype=bool\n","        )\n","\n","        resized_image, _ = pad_or_crop(\n","            image,\n","            dummy_mask,\n","            canvas_size[0],\n","            canvas_size[1]\n","        )\n","\n","        resized.append(\n","            resized_image\n","        )\n","\n","    stack = np.stack(\n","        resized,\n","        axis=-1\n","    )\n","\n","    H, W = canvas_size\n","\n","    probability = np.zeros(\n","        (H, W),\n","        dtype=np.float32\n","    )\n","\n","    count = np.zeros(\n","        (H, W),\n","        dtype=np.float32\n","    )\n","\n","    step = max(\n","        PATCH_SIZE // 2,\n","        1\n","    )\n","\n","    y_positions = list(\n","        range(\n","            0,\n","            max(H - PATCH_SIZE, 0) + 1,\n","            step\n","        )\n","    )\n","\n","    x_positions = list(\n","        range(\n","            0,\n","            max(W - PATCH_SIZE, 0) + 1,\n","            step\n","        )\n","    )\n","\n","    if H > PATCH_SIZE:\n","\n","        last_y = H - PATCH_SIZE\n","\n","        if last_y not in y_positions:\n","            y_positions.append(last_y)\n","\n","    if W > PATCH_SIZE:\n","\n","        last_x = W - PATCH_SIZE\n","\n","        if last_x not in x_positions:\n","            x_positions.append(last_x)\n","\n","    for y in y_positions:\n","\n","        for x in x_positions:\n","\n","            patch = stack[\n","                y:y + PATCH_SIZE,\n","                x:x + PATCH_SIZE,\n","                :\n","            ]\n","\n","            ph, pw = patch.shape[:2]\n","\n","            padded = np.zeros(\n","                (\n","                    1,\n","                    PATCH_SIZE,\n","                    PATCH_SIZE,\n","                    INPUT_TIMESTEPS\n","                ),\n","                dtype=np.float32\n","            )\n","\n","            padded[\n","                0,\n","                :ph,\n","                :pw,\n","                :\n","            ] = patch\n","\n","            prediction = model.predict(\n","                padded,\n","                verbose=0\n","            )[0, :ph, :pw, 0]\n","\n","            probability[\n","                y:y + ph,\n","                x:x + pw\n","            ] += prediction\n","\n","            count[\n","                y:y + ph,\n","                x:x + pw\n","            ] += 1\n","\n","    probability /= np.maximum(\n","        count,\n","        1\n","    )\n","\n","    binary = (\n","        probability > 0.5\n","    ).astype(np.uint8)\n","\n","    return (\n","        probability,\n","        binary\n","    )\n","\n","\n","# ============================================================\n","# 26. RUN PREDICTION\n","# ============================================================\n","\n","probability_map, water_mask = predict_water(\n","    model,\n","    LOCATIONS[\"location_01\"],\n","    (CANVAS_H, CANVAS_W)\n",")\n","\n","\n","# ============================================================\n","# 27. DISPLAY RESULT\n","# ============================================================\n","\n","plt.figure(\n","    figsize=(14, 5)\n",")\n","\n","plt.subplot(\n","    1,\n","    2,\n","    1\n",")\n","\n","plt.imshow(\n","    probability_map,\n","    cmap=\"Blues\",\n","    vmin=0,\n","    vmax=1\n",")\n","\n","plt.title(\n","    \"Water Probability\"\n",")\n","\n","plt.colorbar()\n","\n","\n","plt.subplot(\n","    1,\n","    2,\n","    2\n",")\n","\n","plt.imshow(\n","    water_mask,\n","    cmap=\"gray\",\n","    vmin=0,\n","    vmax=1\n",")\n","\n","plt.title(\n","    \"Predicted Water Mask\"\n",")\n","\n","plt.colorbar()\n","\n","\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# ============================================================\n","# 28. SAVE RESULT\n","# ============================================================\n","\n","np.save(\n","    \"water_probability.npy\",\n","    probability_map\n",")\n","\n","np.save(\n","    \"water_mask.npy\",\n","    water_mask\n",")\n","\n","print(\"\\nFinished.\")\n","print(\"Saved:\")\n","print(\"  water_probability.npy\")\n","print(\"  water_mask.npy\")\n","print(\"  best_unet.keras\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"nPac-i2Ooa29","executionInfo":{"status":"ok","timestamp":1787049569632,"user_tz":-330,"elapsed":137397,"user":{"displayName":"Naturesworld","userId":"00808670514782698905"}},"outputId":"97811cd1-9fc5-4e23-a308-3747ae256e50"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Upload your NDWI GeoTIFF files.\n","Upload them in chronological order.\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","     <input type=\"file\" id=\"files-c3ac5ae9-095c-4324-bdd8-c2ee3f6b6c36\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-c3ac5ae9-095c-4324-bdd8-c2ee3f6b6c36\">\n","      Upload widget is only available when the 