he the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saving NDWI_MAY_AUG_22.tif to NDWI_MAY_AUG_22.tif\n","Uploaded file: NDWI_MAY_AUG_22.tif\n","Image shape: (162, 97)\n","Total pixels: 15714\n","Number of valid pixels: 7991\n","Minimum NDWI: -0.8259311\n","Maximum NDWI: 0.3063209\n","\n","======================================\n","          OTSU THRESHOLD RESULT\n","======================================\n","Image size              : 97 × 162\n","Total pixels             : 15714\n","Valid pixels used        : 7991\n","Minimum NDWI             : -0.8259311\n","Maximum NDWI             : 0.3063209\n","Otsu threshold (8-bit)  : 135.00\n","Otsu threshold (NDWI)    : -0.2265036\n","======================================\n","\n","Binary classification:\n","NDWI >= -0.2265036  →  White (255)\n","NDWI <  -0.2265036  →  Black (0)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x1200 with 5 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# ============================================================\n","# OTSU THRESHOLDING FOR NDWI IMAGE\n","# + GRAYSCALE IMAGE\n","# + BINARY IMAGE\n","# + WATER AREA CALCULATION\n","# ============================================================\n","\n","!pip install rasterio opencv-python matplotlib -q\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import rasterio\n","import cv2\n","\n","from google.colab import files\n","\n","\n","# ------------------------------------------------------------\n","# 1. UPLOAD TIFF FILE\n","# ------------------------------------------------------------\n","\n","uploaded = files.upload()\n","\n","tif_files = [\n","    f for f in uploaded.keys()\n","    if f.lower().endswith((\".tif\", \".tiff\"))\n","]\n","\n","if len(tif_files) == 0:\n","    raise ValueError(\"Please upload a TIFF file.\")\n","\n","image_path = tif_files[0]\n","\n","print(\"Uploaded file:\", image_path)\n","\n","\n","# ------------------------------------------------------------\n","# 2. READ NDWI TIFF\n","# ------------------------------------------------------------\n","\n","with rasterio.open(image_path) as src:\n","\n","    image = src.read(1).astype(np.float64)\n","\n","    nodata = src.nodata\n","\n","    # Actual raster information\n","    width = src.width\n","    height = src.height\n","\n","    transform = src.transform\n","    crs = src.crs\n","\n","    # Actual pixel dimensions from TIFF\n","    pixel_width = abs(src.transform.a)\n","    pixel_height = abs(src.transform.e)\n","\n","\n","print(\"Image shape:\", image.shape)\n","\n","\n","# ------------------------------------------------------------\n","# 3. IDENTIFY VALID PIXELS\n","# ------------------------------------------------------------\n","\n","valid_mask = np.isfinite(image)\n","\n","if nodata is not None:\n","    valid_mask &= (image != nodata)\n","\n","valid_pixels = image[valid_mask]\n","\n","\n","if len(valid_pixels) == 0:\n","    raise ValueError(\"No valid pixels found.\")\n","\n","\n","# ------------------------------------------------------------\n","# 4. BASIC INFORMATION\n","# ------------------------------------------------------------\n","\n","min_val = np.min(valid_pixels)\n","max_val = np.max(valid_pixels)\n","\n","print(\"\\n==============================================\")\n","print(\"              IMAGE INFORMATION\")\n","print(\"==============================================\")\n","\n","print(\"Image size          :\", width, \"×\", height)\n","\n","print(\"Total pixels        :\", image.size)\n","\n","print(\"Valid pixels        :\", len(valid_pixels))\n","\n","print(\"Minimum NDWI        :\", min_val)\n","\n","print(\"Maximum NDWI        :\", max_val)\n","\n","print(\"Pixel width         :\", pixel_width)\n","\n","print(\"Pixel height        :\", pixel_height)\n","\n","print(\"CRS                 :\", crs)\n","\n","print(\"==============================================\")\n","\n","\n","# ============================================================\n","# 5. CONVERT NDWI TO GRAYSCALE\n","# ============================================================\n","#\n","# This is ONLY for visualization / 8-bit Otsu processing.\n","#\n","# The original NDWI values are NOT changed.\n","#\n","# Minimum NDWI -> 0\n","# Maximum NDWI -> 255\n","# ============================================================\n","\n","if max_val == min_val:\n","\n","    raise ValueError(\n","        \"All valid NDWI pixels have the same value.\"\n","    )\n","\n","\n","gray_image = np.zeros_like(\n","    image,\n","    dtype=np.uint8\n",")\n","\n","\n","gray_image[valid_mask] = (\n","    (\n","        image[valid_mask] - min_val\n","    )\n","    /\n","    (\n","        max_val - min_val\n","    )\n","    * 255\n",").astype(np.uint8)\n","\n","\n","gray_valid = gray_image[valid_mask]\n","\n","\n","# ============================================================\n","# 6. OTSU THRESHOLD\n","# ============================================================\n","\n","otsu_8bit, _ = cv2.threshold(\n","    gray_valid,\n","    0,\n","    255,\n","    cv2.THRESH_BINARY + cv2.THRESH_OTSU\n",")\n","\n","\n","# ------------------------------------------------------------\n","# Convert 8-bit threshold back to original NDWI\n","# ------------------------------------------------------------\n","\n","otsu_ndwi = (\n","    (\n","        otsu_8bit / 255.0\n","    )\n","    *\n","    (\n","        max_val - min_val\n","    )\n","    +\n","    min_val\n",")\n","\n","\n","# ============================================================\n","# 7. CREATE BINARY IMAGE\n","# ============================================================\n","#\n","# Water:\n","#\n","#     NDWI >= Otsu NDWI\n","#\n","# Binary value:\n","#\n","#     Water     = 255\n","#     Non-water = 0\n","# ============================================================\n","\n","binary_image = np.zeros_like(\n","    image,\n","    dtype=np.uint8\n",")\n","\n","\n","water_mask = (\n","    valid_mask &\n","    (image >= otsu_ndwi)\n",")\n","\n","\n","non_water_mask = (\n","    valid_mask &\n","    (image < otsu_ndwi)\n",")\n","\n","\n","binary_image[water_mask] = 255\n","\n","\n","# ============================================================\n","# 8. COUNT WATER / NON-WATER PIXELS\n","# ============================================================\n","\n","water_pixel_count = np.sum(\n","    water_mask\n",")\n","\n","non_water_pixel_count = np.sum(\n","    non_water_mask\n",")\n","\n","invalid_pixel_count = (\n","    image.size -\n","    len(valid_pixels)\n",")\n","\n","\n","# ============================================================\n","# 9. AREA CALCULATION\n","# ============================================================\n","#\n","# IMPORTANT:\n","#\n","# We DO NOT use:\n","#\n","#     sum(binary_image)\n","#\n","# because water pixels contain value 255.\n","#\n","# Instead:\n","#\n","#     number of water pixels\n","#                  ×\n","#     actual pixel area\n","#\n","# ============================================================\n","\n","\n","# ------------------------------------------------------------\n","# Pixel area\n","# ------------------------------------------------------------\n","\n","pixel_area = (\n","    pixel_width *\n","    pixel_height\n",")\n","\n","\n","# ------------------------------------------------------------\n","# Check whether CRS is projected or geographic\n","# ------------------------------------------------------------\n","\n","if crs is not None and crs.is_projected:\n","\n","    # Usually metres for UTM/projected satellite data\n","    pixel_area_m2 = pixel_area\n","\n","    water_area_m2 = (\n","        water_pixel_count *\n","        pixel_area_m2\n","    )\n","\n","    non_water_area_m2 = (\n","        non_water_pixel_count *\n","        pixel_area_m2\n","    )\n","\n","    water_area_km2 = (\n","        water_area_m2 /\n","        1_000_000\n","    )\n","\n","    non_water_area_km2 = (\n","        non_water_area_m2 /\n","        1_000_000\n","    )\n","\n","    area_method = (\n","        \"Projected CRS: \"\n","        \"pixel width × pixel height\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# Geographic CRS\n","# ------------------------------------------------------------\n","\n","elif crs is not None and crs.is_geographic:\n","\n","    print(\"\\nWARNING:\")\n","    print(\n","        \"TIFF uses latitude/longitude coordinates.\"\n","    )\n","\n","    print(\n","        \"Pixel dimensions are in degrees.\"\n","    )\n","\n","    print(\n","        \"Geographic pixel area calculation is required.\"\n","    )\n","\n","    # --------------------------------------------------------\n","    # For geographic CRS, calculate approximate area using\n","    # latitude-dependent Earth surface distance.\n","    # --------------------------------------------------------\n","\n","    from pyproj import Geod\n","\n","    geod = Geod(\n","        ellps=\"WGS84\"\n","    )\n","\n","    water_rows, water_cols = np.where(\n","        water_mask\n","    )\n","\n","    water_area_m2 = 0.0\n","\n","    for row, col in zip(\n","        water_rows,\n","        water_cols\n","    ):\n","\n","        x1, y1 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ul\"\n","        )\n","\n","        x2, y2 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ur\"\n","        )\n","\n","        x3, y3 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"lr\"\n","        )\n","\n","        x4, y4 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ll\"\n","        )\n","\n","        area, perimeter = (\n","            geod.polygon_area_perimeter(\n","                [x1, x2, x3, x4],\n","                [y1, y2, y3, y4]\n","            )\n","        )\n","\n","        water_area_m2 += abs(area)\n","\n","\n","    # Non-water area\n","    non_water_rows, non_water_cols = np.where(\n","        non_water_mask\n","    )\n","\n","    non_water_area_m2 = 0.0\n","\n","    for row, col in zip(\n","        non_water_rows,\n","        non_water_cols\n","    ):\n","\n","        x1, y1 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ul\"\n","        )\n","\n","        x2, y2 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ur\"\n","        )\n","\n","        x3, y3 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"lr\"\n","        )\n","\n","        x4, y4 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ll\"\n","        )\n","\n","        area, perimeter = (\n","            geod.polygon_area_perimeter(\n","                [x1, x2, x3, x4],\n","                [y1, y2, y3, y4]\n","            )\n","        )\n","\n","        non_water_area_m2 += abs(area)\n","\n","\n","    water_area_km2 = (\n","        water_area_m2 /\n","        1_000_000\n","    )\n","\n","    non_water_area_km2 = (\n","        non_water_area_m2 /\n","        1_000_000\n","    )\n","\n","    area_method = (\n","        \"Geographic CRS: \"\n","        \"geodesic pixel area\"\n","    )\n","\n","\n","else:\n","\n","    raise ValueError(\n","        \"CRS information is missing.\"\n","    )\n","\n","\n","# ============================================================\n","# 10. CONVERT AREA TO HECTARES\n","# ============================================================\n","\n","water_area_hectares = (\n","    water_area_m2 /\n","    10_000\n",")\n","\n","\n","non_water_area_hectares = (\n","    non_water_area_m2 /\n","    10_000\n",")\n","\n","\n","# ============================================================\n","# 11. FINAL OTSU + AREA RESULTS\n","# ============================================================\n","\n","print(\"\\n\")\n","print(\"=\" * 60)\n","print(\"             OTSU THRESHOLD RESULT\")\n","print(\"=\" * 60)\n","\n","print(\n","    f\"Minimum NDWI          : \"\n","    f\"{min_val:.10f}\"\n",")\n","\n","print(\n","    f\"Maximum NDWI          : \"\n","    f\"{max_val:.10f}\"\n",")\n","\n","print(\n","    f\"Otsu grayscale value  : \"\n","    f\"{otsu_8bit:.2f}\"\n",")\n","\n","print(\n","    f\"Otsu NDWI threshold   : \"\n","    f\"{otsu_ndwi:.10f}\"\n",")\n","\n","print(\"-\" * 60)\n","\n","print(\n","    f\"Water pixels          : \"\n","    f\"{water_pixel_count}\"\n",")\n","\n","print(\n","    f\"Non-water pixels      : \"\n","    f\"{non_water_pixel_count}\"\n",")\n","\n","print(\n","    f\"Invalid pixels        : \"\n","    f\"{invalid_pixel_count}\"\n",")\n","\n","print(\"=\" * 60)\n","\n","\n","# ============================================================\n","# 12. AREA RESULTS\n","# ============================================================\n","\n","print(\"\\n\")\n","print(\"=\" * 60)\n","print(\"               AREA CALCULATION\")\n","print(\"=\" * 60)\n","\n","print(\n","    f\"Pixel width           : \"\n","    f\"{pixel_width}\"\n",")\n","\n","print(\n","    f\"Pixel height          : \"\n","    f\"{pixel_height}\"\n",")\n","\n","print(\n","    f\"Pixel area            : \"\n","    f\"{pixel_area:.8f}\"\n",")\n","\n","print(\n","    f\"Area method           : \"\n","    f\"{area_method}\"\n",")\n","\n","print(\"-\" * 60)\n","\n","print(\n","    f\"Water area            : \"\n","    f\"{water_area_m2:.4f} m²\"\n",")\n","\n","print(\n","    f\"Water area            : \"\n","    f\"{water_area_hectares:.4f} hectares\"\n",")\n","\n","print(\n","    f\"Water area            : \"\n","    f\"{water_area_km2:.8f} km²\"\n",")\n","\n","print(\"-\" * 60)\n","\n","print(\n","    f\"Non-water area        : \"\n","    f\"{non_water_area_m2:.4f} m²\"\n",")\n","\n","print(\n","    f\"Non-water area        : \"\n","    f\"{non_water_area_hectares:.4f} hectares\"\n",")\n","\n","print(\n","    f\"Non-water area        : \"\n","    f\"{non_water_area_km2:.8f} km²\"\n",")\n","\n","print(\"=\" * 60)\n","\n","\n","# ============================================================\n","# 13. WATER PERCENTAGE\n","# ============================================================\n","\n","water_percentage = (\n","    water_pixel_count /\n","    len(valid_pixels)\n",") * 100\n","\n","\n","non_water_percentage = (\n","    non_water_pixel_count /\n","    len(valid_pixels)\n",") * 100\n","\n","\n","print(\"\\n\")\n","print(\"=\" * 60)\n","print(\"             CLASSIFICATION\")\n","print(\"=\" * 60)\n","\n","print(\n","    f\"Water percentage      : \"\n","    f\"{water_percentage:.2f}%\"\n",")\n","\n","print(\n","    f\"Non-water percentage  : \"\n","    f\"{non_water_percentage:.2f}%\"\n",")\n","\n","print(\"=\" * 60)\n","\n","\n","# ============================================================\n","# 14. DISPLAY FIVE OUTPUTS\n","# ============================================================\n","\n","plt.figure(\n","    figsize=(18, 14)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 1 — ORIGINAL NDWI IMAGE\n","# ------------------------------------------------------------\n","\n","plt.subplot(\n","    2, 3, 1\n",")\n","\n","original_display = np.where(\n","    valid_mask,\n","    image,\n","    np.nan\n",")\n","\n","im1 = plt.imshow(\n","    original_display,\n","    cmap=\"gray\"\n",")\n","\n","plt.title(\n","    \"Original NDWI Image\"\n",")\n","\n","plt.xlabel(\n","    \"Column\"\n",")\n","\n","plt.ylabel(\n","    \"Row\"\n",")\n","\n","plt.colorbar(\n","    im1,\n","    label=\"NDWI\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 2 — GRAYSCALE IMAGE\n","# ------------------------------------------------------------\n","\n","plt.subplot(\n","    2, 3, 2\n",")\n","\n","gray_display = np.where(\n","    valid_mask,\n","    gray_image,\n","    np.nan\n",")\n","\n","plt.imshow(\n","    gray_display,\n","    cmap=\"gray\",\n","    vmin=0,\n","    vmax=255\n",")\n","\n","plt.title(\n","    f\"8-bit Grayscale Image\\n\"\n","    f\"Otsu = {otsu_8bit:.0f}\"\n",")\n","\n","plt.xlabel(\n","    \"Column\"\n",")\n","\n","plt.ylabel(\n","    \"Row\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 3 — GRAY LEVEL HISTOGRAM\n","# ------------------------------------------------------------\n","\n","plt.subplot(\n","    2, 3, 3\n",")\n","\n","plt.hist(\n","    gray_valid,\n","    bins=256,\n","    range=(0, 255)\n",")\n","\n","plt.title(\n","    \"Gray Level Histogram\"\n",")\n","\n","plt.xlabel(\n","    \"Gray Level\"\n",")\n","\n","plt.ylabel(\n","    \"Pixel Count\"\n",")\n","\n","plt.xlim(\n","    0,\n","    255\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 4 — BINARY IMAGE\n","# ------------------------------------------------------------\n","\n","plt.subplot(\n","    2, 3, 4\n",")\n","\n","plt.imshow(\n","    binary_image,\n","    cmap=\"gray\",\n","    vmin=0,\n","    vmax=255\n",")\n","\n","plt.title(\n","    f\"Binary Water Image\\n\"\n","    f\"Water Pixels = {water_pixel_count}\"\n",")\n","\n","plt.xlabel(\n","    \"Column\"\n",")\n","\n","plt.ylabel(\n","    \"Row\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 5 — HISTOGRAM WITH OTSU\n","# ------------------------------------------------------------\n","\n","plt.subplot(\n","    2, 3, 5\n",")\n","\n","plt.hist(\n","    gray_valid,\n","    bins=256,\n","    range=(0, 255)\n",")\n","\n","plt.axvline(\n","    otsu_8bit,\n","    linestyle=\"--\",\n","    linewidth=2,\n","    label=(\n","        f\"Otsu = \"\n","        f\"{otsu_8bit:.0f}\"\n","    )\n",")\n","\n","plt.title(\n","    \"Gray Histogram + Otsu Threshold\"\n",")\n","\n","plt.xlabel(\n","    \"Gray Level\"\n",")\n","\n","plt.ylabel(\n","    \"Pixel Count\"\n",")\n","\n","plt.xlim(\n","    0,\n","    255\n",")\n","\n","plt.legend()\n","\n","\n","# ------------------------------------------------------------\n","# 6 — AREA INFORMATION\n","# ------------------------------------------------------------\n","\n","plt.subplot(\n","    2, 3, 6\n",")\n","\n","plt.axis(\n","    \"off\"\n",")\n","\n","area_text = (\n","    \"AREA RESULT\\n\\n\"\n","    f\"Water pixels: {water_pixel_count:,}\\n\\n\"\n","    f\"Pixel area: {pixel_area:.4f}\\n\\n\"\n","    f\"Water area:\\n\"\n","    f\"{water_area_m2:,.2f} m²\\n\\n\"\n","    f\"{water_area_hectares:.4f} ha\\n\\n\"\n","    f\"{water_area_km2:.6f} km²\"\n",")\n","\n","plt.text(\n","    0.05,\n","    0.5,\n","    area_text,\n","    fontsize=12,\n","    verticalalignment=\"center\"\n",")\n","\n","\n","plt.suptitle(\n","    \"NDWI Otsu Classification and Area Analysis\",\n","    fontsize=18\n",")\n","\n","plt.tight_layout()\n","\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"M21To8bgjLNv","executionInfo":{"status":"ok","timestamp":1787125577336,"user_tz":-330,"elapsed":27576,"user":{"displayName":"Naturesworld","userId":"00808670514782698905"}},"outputId":"efeda173-d85a-4f53-c1c3-405163fda25c"},"execution_count":2,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","     <input type=\"file\" id=\"files-091716d6-d07d-4af7-aa68-63bd994ff322\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-091716d6-d07d-4af7-aa68-63bd994ff322\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saving NDWI_JAN_APR_22.tif to NDWI_JAN_APR_22.tif\n","Saving NDWI_SEP_DEC_22.tif to NDWI_SEP_DEC_22.tif\n","Saving NDWI_MAY_AUG_22.tif to NDWI_MAY_AUG_22 (1).tif\n","Uploaded file: NDWI_JAN_APR_22.tif\n","Image shape: (162, 97)\n","\n","==============================================\n","              IMAGE INFORMATION\n","==============================================\n","Image size          : 97 × 162\n","Total pixels        : 15714\n","Valid pixels        : 7991\n","Minimum NDWI        : -0.731712281703949\n","Maximum NDWI        : 0.033218786120414734\n","Pixel width         : 8.98315360824157e-05\n","Pixel height        : 8.983153086419803e-05\n","CRS                 : EPSG:4326\n","==============================================\n","\n","WARNING:\n","TIFF uses latitude/longitude coordinates.\n","Pixel dimensions are in degrees.\n","Geographic pixel area calculation is required.\n","\n","\n","============================================================\n","             OTSU THRESHOLD RESULT\n","============================================================\n","Minimum NDWI          : -0.7317122817\n","Maximum NDWI          : 0.0332187861\n","Otsu grayscale value  : 143.00\n","Otsu NDWI threshold   : -0.3027509378\n","------------------------------------------------------------\n","Water pixels          : 4514\n","Non-water pixels      : 3477\n","Invalid pixels        : 7723\n","============================================================\n","\n","\n","============================================================\n","               AREA CALCULATION\n","============================================================\n","Pixel width           : 8.98315360824157e-05\n","Pixel height          : 8.983153086419803e-05\n","Pixel area            : 0.00000001\n","Area method           : Geographic CRS: geodesic pixel area\n","------------------------------------------------------------\n","Water area            : 437034.1787 m²\n","Water area            : 43.7034 hectares\n","Water area            : 0.43703418 km²\n","------------------------------------------------------------\n","Non-water area        : 336634.6309 m²\n","Non-water area        : 33.6635 hectares\n","Non-water area        : 0.33663463 km²\n","============================================================\n","\n","\n","============================================================\n","             CLASSIFICATION\n","============================================================\n","Water percentage      : 56.49%\n","Non-water percentage  : 43.51%\n","============================================================\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x1400 with 7 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# ============================================================\n","# OTSU THRESHOLDING FOR NDWI IMAGE\n","# + GRAYSCALE IMAGE\n","# + BINARY IMAGE\n","# + WATER AREA CALCULATION\n","# ============================================================\n","\n","!pip install rasterio opencv-python matplotlib -q\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import rasterio\n","import cv2\n","\n","from google.colab import files\n","\n","\n","# ------------------------------------------------------------\n","# 1. UPLOAD TIFF FILE\n","# ------------------------------------------------------------\n","\n","uploaded = files.upload()\n","\n","tif_files = [\n","    f for f in uploaded.keys()\n","    if f.lower().endswith((\".tif\", \".tiff\"))\n","]\n","\n","if len(tif_files) == 0:\n","    raise ValueError(\"Please upload a TIFF file.\")\n","\n","image_path = tif_files[0]\n","\n","print(\"Uploaded file:\", image_path)\n","\n","\n","# ------------------------------------------------------------\n","# 2. READ NDWI TIFF\n","# ------------------------------------------------------------\n","\n","with rasterio.open(image_path) as src:\n","\n","    image = src.read(1).astype(np.float64)\n","\n","    nodata = src.nodata\n","\n","    # Actual raster information\n","    width = src.width\n","    height = src.height\n","\n","    transform = src.transform\n","    crs = src.crs\n","\n","    # Actual pixel dimensions from TIFF\n","    pixel_width = abs(src.transform.a)\n","    pixel_height = abs(src.transform.e)\n","\n","\n","print(\"Image shape:\", image.shape)\n","\n","\n","# ------------------------------------------------------------\n","# 3. IDENTIFY VALID PIXELS\n","# ------------------------------------------------------------\n","\n","valid_mask = np.isfinite(image)\n","\n","if nodata is not None:\n","    valid_mask &= (image != nodata)\n","\n","valid_pixels = image[valid_mask]\n","\n","\n","if len(valid_pixels) == 0:\n","    raise ValueError(\"No valid pixels found.\")\n","\n","\n","# ------------------------------------------------------------\n","# 4. BASIC INFORMATION\n","# ------------------------------------------------------------\n","\n","min_val = np.min(valid_pixels)\n","max_val = np.max(valid_pixels)\n","\n","print(\"\\n==============================================\")\n","print(\"              IMAGE INFORMATION\")\n","print(\"==============================================\")\n","\n","print(\"Image size          :\", width, \"×\", height)\n","\n","print(\"Total pixels        :\", image.size)\n","\n","print(\"Valid pixels        :\", len(valid_pixels))\n","\n","print(\"Minimum NDWI        :\", min_val)\n","\n","print(\"Maximum NDWI        :\", max_val)\n","\n","print(\"Pixel width         :\", pixel_width)\n","\n","print(\"Pixel height        :\", pixel_height)\n","\n","print(\"CRS                 :\", crs)\n","\n","print(\"==============================================\")\n","\n","\n","# ============================================================\n","# 5. CONVERT NDWI TO GRAYSCALE\n","# ============================================================\n","#\n","# This is ONLY for visualization / 8-bit Otsu processing.\n","#\n","# The original NDWI values are NOT changed.\n","#\n","# Minimum NDWI -> 0\n","# Maximum NDWI -> 255\n","# ============================================================\n","\n","if max_val == min_val:\n","\n","    raise ValueError(\n","        \"All valid NDWI pixels have the same value.\"\n","    )\n","\n","\n","gray_image = np.zeros_like(\n","    image,\n","    dtype=np.uint8\n",")\n","\n","\n","gray_image[valid_mask] = (\n","    (\n","        image[valid_mask] - min_val\n","    )\n","    /\n","    (\n","        max_val - min_val\n","    )\n","    * 255\n",").astype(np.uint8)\n","\n","\n","gray_valid = gray_image[valid_mask]\n","\n","\n","# ============================================================\n","# 6. OTSU THRESHOLD\n","# ============================================================\n","\n","otsu_8bit, _ = cv2.threshold(\n","    gray_valid,\n","    0,\n","    255,\n","    cv2.THRESH_BINARY + cv2.THRESH_OTSU\n",")\n","\n","\n","# ------------------------------------------------------------\n","# Convert 8-bit threshold back to original NDWI\n","# ------------------------------------------------------------\n","\n","otsu_ndwi = (\n","    (\n","        otsu_8bit / 255.0\n","    )\n","    *\n","    (\n","        max_val - min_val\n","    )\n","    +\n","    min_val\n",")\n","\n","\n","# ============================================================\n","# 7. CREATE BINARY IMAGE\n","# ============================================================\n","#\n","# Water:\n","#\n","#     NDWI >= Otsu NDWI\n","#\n","# Binary value:\n","#\n","#     Water     = 255\n","#     Non-water = 0\n","# ============================================================\n","\n","binary_image = np.zeros_like(\n","    image,\n","    dtype=np.uint8\n",")\n","\n","\n","water_mask = (\n","    valid_mask &\n","    (image >= otsu_ndwi)\n",")\n","\n","\n","non_water_mask = (\n","    valid_mask &\n","    (image < otsu_ndwi)\n",")\n","\n","\n","binary_image[water_mask] = 255\n","\n","\n","# ============================================================\n","# 8. COUNT WATER / NON-WATER PIXELS\n","# ============================================================\n","\n","water_pixel_count = np.sum(\n","    water_mask\n",")\n","\n","non_water_pixel_count = np.sum(\n","    non_water_mask\n",")\n","\n","invalid_pixel_count = (\n","    image.size -\n","    len(valid_pixels)\n",")\n","\n","\n","# ============================================================\n","# 9. AREA CALCULATION\n","# ============================================================\n","#\n","# IMPORTANT:\n","#\n","# We DO NOT use:\n","#\n","#     sum(binary_image)\n","#\n","# because water pixels contain value 255.\n","#\n","# Instead:\n","#\n","#     number of water pixels\n","#                  ×\n","#     actual pixel area\n","#\n","# ============================================================\n","\n","\n","# ------------------------------------------------------------\n","# Pixel area\n","# ------------------------------------------------------------\n","\n","pixel_area = (\n","    pixel_width *\n","    pixel_height\n",")\n","\n","\n","# ------------------------------------------------------------\n","# Check whether CRS is projected or geographic\n","# ------------------------------------------------------------\n","\n","if crs is not None and crs.is_projected:\n","\n","    # Usually metres for UTM/projected satellite data\n","    pixel_area_m2 = pixel_area\n","\n","    water_area_m2 = (\n","        water_pixel_count *\n","        pixel_area_m2\n","    )\n","\n","    non_water_area_m2 = (\n","        non_water_pixel_count *\n","        pixel_area_m2\n","    )\n","\n","    water_area_km2 = (\n","        water_area_m2 /\n","        1_000_000\n","    )\n","\n","    non_water_area_km2 = (\n","        non_water_area_m2 /\n","        1_000_000\n","    )\n","\n","    area_method = (\n","        \"Projected CRS: \"\n","        \"pixel width × pixel height\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# Geographic CRS\n","# ------------------------------------------------------------\n","\n","elif crs is not None and crs.is_geographic:\n","\n","    print(\"\\nWARNING:\")\n","    print(\n","        \"TIFF uses latitude/longitude coordinates.\"\n","    )\n","\n","    print(\n","        \"Pixel dimensions are in degrees.\"\n","    )\n","\n","    print(\n","        \"Geographic pixel area calculation is required.\"\n","    )\n","\n","    # --------------------------------------------------------\n","    # For geographic CRS, calculate approximate area using\n","    # latitude-dependent Earth surface distance.\n","    # --------------------------------------------------------\n","\n","    from pyproj import Geod\n","\n","    geod = Geod(\n","        ellps=\"WGS84\"\n","    )\n","\n","    water_rows, water_cols = np.where(\n","        water_mask\n","    )\n","\n","    water_area_m2 = 0.0\n","\n","    for row, col in zip(\n","        water_rows,\n","        water_cols\n","    ):\n","\n","        x1, y1 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ul\"\n","        )\n","\n","        x2, y2 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ur\"\n","        )\n","\n","        x3, y3 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"lr\"\n","        )\n","\n","        x4, y4 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ll\"\n","        )\n","\n","        area, perimeter = (\n","            geod.polygon_area_perimeter(\n","                [x1, x2, x3, x4],\n","                [y1, y2, y3, y4]\n","            )\n","        )\n","\n","        water_area_m2 += abs(area)\n","\n","\n","    # Non-water area\n","    non_water_rows, non_water_cols = np.where(\n","        non_water_mask\n","    )\n","\n","    non_water_area_m2 = 0.0\n","\n","    for row, col in zip(\n","        non_water_rows,\n","        non_water_cols\n","    ):\n","\n","        x1, y1 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ul\"\n","        )\n","\n","        x2, y2 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ur\"\n","        )\n","\n","        x3, y3 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"lr\"\n","        )\n","\n","        x4, y4 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ll\"\n","        )\n","\n","        area, perimeter = (\n","            geod.polygon_area_perimeter(\n","                [x1, x2, x3, x4],\n","                [y1, y2, y3, y4]\n","            )\n","        )\n","\n","        non_water_area_m2 += abs(area)\n","\n","\n","    water_area_km2 = (\n","        water_area_m2 /\n","        1_000_000\n","    )\n","\n","    non_water_area_km2 = (\n","        non_water_area_m2 /\n","        1_000_000\n","    )\n","\n","    area_method = (\n","        \"Geographic CRS: \"\n","        \"geodesic pixel area\"\n","    )\n","\n","\n","else:\n","\n","    raise ValueError(\n","        \"CRS information is missing.\"\n","    )\n","\n","\n","# ============================================================\n","# 10. CONVERT AREA TO HECTARES\n","# ============================================================\n","\n","water_area_hectares = (\n","    water_area_m2 /\n","    10_000\n",")\n","\n","\n","non_water_area_hectares = (\n","    non_water_area_m2 /\n","    10_000\n",")\n","\n","\n","# ============================================================\n","# 11. FINAL OTSU + AREA RESULTS\n","# ============================================================\n","\n","print(\"\\n\")\n","print(\"=\" * 60)\n","print(\"             OTSU THRESHOLD RESULT\")\n","print(\"=\" * 60)\n","\n","print(\n","    f\"Minimum NDWI          : \"\n","    f\"{min_val:.10f}\"\n",")\n","\n","print(\n","    f\"Maximum NDWI          : \"\n","    f\"{max_val:.10f}\"\n",")\n","\n","print(\n","    f\"Otsu grayscale value  : \"\n","    f\"{otsu_8bit:.2f}\"\n",")\n","\n","print(\n","    f\"Otsu NDWI threshold   : \"\n","    f\"{otsu_ndwi:.10f}\"\n",")\n","\n","print(\"-\" * 60)\n","\n","print(\n","    f\"Water pixels          : \"\n","    f\"{water_pixel_count}\"\n",")\n","\n","print(\n","    f\"Non-water pixels      : \"\n","    f\"{non_water_pixel_count}\"\n",")\n","\n","print(\n","    f\"Invalid pixels        : \"\n","    f\"{invalid_pixel_count}\"\n",")\n","\n","print(\"=\" * 60)\n","\n","\n","# ============================================================\n","# 12. AREA RESULTS\n","# ============================================================\n","\n","print(\"\\n\")\n","print(\"=\" * 60)\n","print(\"               AREA CALCULATION\")\n","print(\"=\" * 60)\n","\n","print(\n","    f\"Pixel width           : \"\n","    f\"{pixel_width}\"\n",")\n","\n","print(\n","    f\"Pixel height          : \"\n","    f\"{pixel_height}\"\n",")\n","\n","print(\n","    f\"Pixel area            : \"\n","    f\"{pixel_area:.8f}\"\n",")\n","\n","print(\n","    f\"Area method           : \"\n","    f\"{area_method}\"\n",")\n","\n","print(\"-\" * 60)\n","\n","print(\n","    f\"Water area            : \"\n","    f\"{water_area_m2:.4f} m²\"\n",")\n","\n","print(\n","    f\"Water area            : \"\n","    f\"{water_area_hectares:.4f} hectares\"\n",")\n","\n","print(\n","    f\"Water area            : \"\n","    f\"{water_area_km2:.8f} km²\"\n",")\n","\n","print(\"-\" * 60)\n","\n","print(\n","    f\"Non-water area        : \"\n","    f\"{non_water_area_m2:.4f} m²\"\n",")\n","\n","print(\n","    f\"Non-water area        : \"\n","    f\"{non_water_area_hectares:.4f} hectares\"\n",")\n","\n","print(\n","    f\"Non-water area        : \"\n","    f\"{non_water_area_km2:.8f} km²\"\n",")\n","\n","print(\"=\" * 60)\n","\n","\n","# ============================================================\n","# 13. WATER PERCENTAGE\n","# ============================================================\n","\n","water_percentage = (\n","    water_pixel_count /\n","    len(valid_pixels)\n",") * 100\n","\n","\n","non_water_percentage = (\n","    non_water_pixel_count /\n","    len(valid_pixels)\n",") * 100\n","\n","\n","print(\"\\n\")\n","print(\"=\" * 60)\n","print(\"             CLASSIFICATION\")\n","print(\"=\" * 60)\n","\n","print(\n","    f\"Water percentage      : \"\n","    f\"{water_percentage:.2f}%\"\n",")\n","\n","print(\n","    f\"Non-water percentage  : \"\n","    f\"{non_water_percentage:.2f}%\"\n",")\n","\n","print(\"=\" * 60)\n","\n","\n","# ============================================================\n","# 14. DISPLAY FIVE OUTPUTS\n","# ============================================================\n","\n","plt.figure(\n","    figsize=(18, 14)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 1 — ORIGINAL NDWI IMAGE\n","# ------------------------------------------------------------\n","\n","plt.subplot(\n","    2, 3, 1\n",")\n","\n","original_display = np.where(\n","    valid_mask,\n","    image,\n","    np.nan\n",")\n","\n","im1 = plt.imshow(\n","    original_display,\n","    cmap=\"gray\"\n",")\n","\n","plt.title(\n","    \"Original NDWI Image\"\n",")\n","\n","plt.xlabel(\n","    \"Column\"\n",")\n","\n","plt.ylabel(\n","    \"Row\"\n",")\n","\n","plt.colorbar(\n","    im1,\n","    label=\"NDWI\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 2 — GRAYSCALE IMAGE\n","# ------------------------------------------------------------\n","\n","plt.subplot(\n","    2, 3, 2\n",")\n","\n","gray_display = np.where(\n","    valid_mask,\n","    gray_image,\n","    np.nan\n",")\n","\n","plt.imshow(\n","    gray_display,\n","    cmap=\"gray\",\n","    vmin=0,\n","    vmax=255\n",")\n","\n","plt.title(\n","    f\"8-bit Grayscale Image\\n\"\n","    f\"Otsu = {otsu_8bit:.0f}\"\n",")\n","\n","plt.xlabel(\n","    \"Column\"\n",")\n","\n","plt.ylabel(\n","    \"Row\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 3 — GRAY LEVEL HISTOGRAM\n","# ------------------------------------------------------------\n","\n","plt.subplot(\n","    2, 3, 3\n",")\n","\n","plt.hist(\n","    gray_valid,\n","    bins=256,\n","    range=(0, 255)\n",")\n","\n","plt.title(\n","    \"Gray Level Histogram\"\n",")\n","\n","plt.xlabel(\n","    \"Gray Level\"\n",")\n","\n","plt.ylabel(\n","    \"Pixel Count\"\n",")\n","\n","plt.xlim(\n","    0,\n","    255\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 4 — BINARY IMAGE\n","# ------------------------------------------------------------\n","\n","plt.subplot(\n","    2, 3, 4\n",")\n","\n","plt.imshow(\n","    binary_image,\n","    cmap=\"gray\",\n","    vmin=0,\n","    vmax=255\n",")\n","\n","plt.title(\n","    f\"Binary Water Image\\n\"\n","    f\"Water Pixels = {water_pixel_count}\"\n",")\n","\n","plt.xlabel(\n","    \"Column\"\n",")\n","\n","plt.ylabel(\n","    \"Row\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 5 — HISTOGRAM WITH OTSU\n","# ------------------------------------------------------------\n","\n","plt.subplot(\n","    2, 3, 5\n",")\n","\n","plt.hist(\n","    gray_valid,\n","    bins=256,\n","    range=(0, 255)\n",")\n","\n","plt.axvline(\n","    otsu_8bit,\n","    linestyle=\"--\",\n","    linewidth=2,\n","    label=(\n","        f\"Otsu = \"\n","        f\"{otsu_8bit:.0f}\"\n","    )\n",")\n","\n","plt.title(\n","    \"Gray Histogram + Otsu Threshold\"\n",")\n","\n","plt.xlabel(\n","    \"Gray Level\"\n",")\n","\n","plt.ylabel(\n","    \"Pixel Count\"\n",")\n","\n","plt.xlim(\n","    0,\n","    255\n",")\n","\n","plt.legend()\n","\n","\n","# ------------------------------------------------------------\n","# 6 — AREA INFORMATION\n","# ------------------------------------------------------------\n","\n","plt.subplot(\n","    2, 3, 6\n",")\n","\n","plt.axis(\n","    \"off\"\n",")\n","\n","area_text = (\n","    \"AREA RESULT\\n\\n\"\n","    f\"Water pixels: {water_pixel_count:,}\\n\\n\"\n","    f\"Pixel area: {pixel_area:.4f}\\n\\n\"\n","    f\"Water area:\\n\"\n","    f\"{water_area_m2:,.2f} m²\\n\\n\"\n","    f\"{water_area_hectares:.4f} ha\\n\\n\"\n","    f\"{water_area_km2:.6f} km²\"\n",")\n","\n","plt.text(\n","    0.05,\n","    0.5,\n","    area_text,\n","    fontsize=12,\n","    verticalalignment=\"center\"\n",")\n","\n","\n","plt.suptitle(\n","    \"NDWI Otsu Classification and Area Analysis\",\n","    fontsize=18\n",")\n","\n","plt.tight_layout()\n","\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"pvpU_8uW_Q6a","executionInfo":{"status":"ok","timestamp":1787125658791,"user_tz":-330,"elapsed":17182,"user":{"displayName":"Naturesworld","userId":"00808670514782698905"}},"outputId":"a0011ea4-0057-4e10-d972-ed9eb11ead76"},"execution_count":3,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","     <input type=\"file\" id=\"files-9bcbdda2-9628-4774-9148-41603112f0d1\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-9bcbdda2-9628-4774-9148-41603112f0d1\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saving NDWI_MAY_AUG_22.tif to NDWI_MAY_AUG_22 (2).tif\n","Uploaded file: NDWI_MAY_AUG_22 (2).tif\n","Image shape: (162, 97)\n","\n","==============================================\n","              IMAGE INFORMATION\n","==============================================\n","Image size          : 97 × 162\n","Total pixels        : 15714\n","Valid pixels        : 7991\n","Minimum NDWI        : -0.8259310722351074\n","Maximum NDWI        : 0.3063209056854248\n","Pixel width         : 8.98315360824157e-05\n","Pixel height        : 8.983153086419803e-05\n","CRS                 : EPSG:4326\n","==============================================\n","\n","WARNING:\n","TIFF uses latitude/longitude coordinates.\n","Pixel dimensions are in degrees.\n","Geographic pixel area calculation is required.\n","\n","\n","============================================================\n","             OTSU THRESHOLD RESULT\n","============================================================\n","Minimum NDWI          : -0.8259310722\n","Maximum NDWI          : 0.3063209057\n","Otsu grayscale value  : 135.00\n","Otsu NDWI threshold   : -0.2265035545\n","------------------------------------------------------------\n","Water pixels          : 4350\n","Non-water pixels      : 3641\n","Invalid pixels        : 7723\n","============================================================\n","\n","\n","============================================================\n","               AREA CALCULATION\n","============================================================\n","Pixel width           : 8.98315360824157e-05\n","Pixel height          : 8.983153086419803e-05\n","Pixel area            : 0.00000001\n","Area method           : Geographic CRS: geodesic pixel area\n","------------------------------------------------------------\n","Water area            : 421155.9541 m²\n","Water area            : 42.1156 hectares\n","Water area            : 0.42115595 km²\n","------------------------------------------------------------\n","Non-water area        : 352512.8556 m²\n","Non-water area        : 35.2513 hectares\n","Non-water area        : 0.35251286 km²\n","============================================================\n","\n","\n","============================================================\n","             CLASSIFICATION\n","============================================================\n","Water percentage      : 54.44%\n","Non-water percentage  : 45.56%\n","============================================================\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x1400 with 7 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# ============================================================\n","# OTSU THRESHOLDING FOR NDWI IMAGE\n","# + GRAYSCALE IMAGE\n","# + BINARY IMAGE\n","# + WATER AREA CALCULATION\n","# ============================================================\n","\n","!pip install rasterio opencv-python matplotlib -q\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import rasterio\n","import cv2\n","\n","from google.colab import files\n","\n","\n","# ------------------------------------------------------------\n","# 1. UPLOAD TIFF FILE\n","# ------------------------------------------------------------\n","\n","uploaded = files.upload()\n","\n","tif_files = [\n","    f for f in uploaded.keys()\n","    if f.lower().endswith((\".tif\", \".tiff\"))\n","]\n","\n","if len(tif_files) == 0:\n","    raise ValueError(\"Please upload a TIFF file.\")\n","\n","image_path = tif_files[0]\n","\n","print(\"Uploaded file:\", image_path)\n","\n","\n","# ------------------------------------------------------------\n","# 2. READ NDWI TIFF\n","# ------------------------------------------------------------\n","\n","with rasterio.open(image_path) as src:\n","\n","    image = src.read(1).astype(np.float64)\n","\n","    nodata = src.nodata\n","\n","    # Actual raster information\n","    width = src.width\n","    height = src.height\n","\n","    transform = src.transform\n","    crs = src.crs\n","\n","    # Actual pixel dimensions from TIFF\n","    pixel_width = abs(src.transform.a)\n","    pixel_height = abs(src.transform.e)\n","\n","\n","print(\"Image shape:\", image.shape)\n","\n","\n","# ------------------------------------------------------------\n","# 3. IDENTIFY VALID PIXELS\n","# ------------------------------------------------------------\n","\n","valid_mask = np.isfinite(image)\n","\n","if nodata is not None:\n","    valid_mask &= (image != nodata)\n","\n","valid_pixels = image[valid_mask]\n","\n","\n","if len(valid_pixels) == 0:\n","    raise ValueError(\"No valid pixels found.\")\n","\n","\n","# ------------------------------------------------------------\n","# 4. BASIC INFORMATION\n","# ------------------------------------------------------------\n","\n","min_val = np.min(valid_pixels)\n","max_val = np.max(valid_pixels)\n","\n","print(\"\\n==============================================\")\n","print(\"              IMAGE INFORMATION\")\n","print(\"==============================================\")\n","\n","print(\"Image size          :\", width, \"×\", height)\n","\n","print(\"Total pixels        :\", image.size)\n","\n","print(\"Valid pixels        :\", len(valid_pixels))\n","\n","print(\"Minimum NDWI        :\", min_val)\n","\n","print(\"Maximum NDWI        :\", max_val)\n","\n","print(\"Pixel width         :\", pixel_width)\n","\n","print(\"Pixel height        :\", pixel_height)\n","\n","print(\"CRS                 :\", crs)\n","\n","print(\"==============================================\")\n","\n","\n","# ============================================================\n","# 5. CONVERT NDWI TO GRAYSCALE\n","# ============================================================\n","#\n","# This is ONLY for visualization / 8-bit Otsu processing.\n","#\n","# The original NDWI values are NOT changed.\n","#\n","# Minimum NDWI -> 0\n","# Maximum NDWI -> 255\n","# ============================================================\n","\n","if max_val == min_val:\n","\n","    raise ValueError(\n","        \"All valid NDWI pixels have the same value.\"\n","    )\n","\n","\n","gray_image = np.zeros_like(\n","    image,\n","    dtype=np.uint8\n",")\n","\n","\n","gray_image[valid_mask] = (\n","    (\n","        image[valid_mask] - min_val\n","    )\n","    /\n","    (\n","        max_val - min_val\n","    )\n","    * 255\n",").astype(np.uint8)\n","\n","\n","gray_valid = gray_image[valid_mask]\n","\n","\n","# ============================================================\n","# 6. OTSU THRESHOLD\n","# ============================================================\n","\n","otsu_8bit, _ = cv2.threshold(\n","    gray_valid,\n","    0,\n","    255,\n","    cv2.THRESH_BINARY + cv2.THRESH_OTSU\n",")\n","\n","\n","# ------------------------------------------------------------\n","# Convert 8-bit threshold back to original NDWI\n","# ------------------------------------------------------------\n","\n","otsu_ndwi = (\n","    (\n","        otsu_8bit / 255.0\n","    )\n","    *\n","    (\n","        max_val - min_val\n","    )\n","    +\n","    min_val\n",")\n","\n","\n","# ============================================================\n","# 7. CREATE BINARY IMAGE\n","# ============================================================\n","#\n","# Water:\n","#\n","#     NDWI >= Otsu NDWI\n","#\n","# Binary value:\n","#\n","#     Water     = 255\n","#     Non-water = 0\n","# ============================================================\n","\n","binary_image = np.zeros_like(\n","    image,\n","    dtype=np.uint8\n",")\n","\n","\n","water_mask = (\n","    valid_mask &\n","    (image >= otsu_ndwi)\n",")\n","\n","\n","non_water_mask = (\n","    valid_mask &\n","    (image < otsu_ndwi)\n",")\n","\n","\n","binary_image[water_mask] = 255\n","\n","\n","# ============================================================\n","# 8. COUNT WATER / NON-WATER PIXELS\n","# ============================================================\n","\n","water_pixel_count = np.sum(\n","    water_mask\n",")\n","\n","non_water_pixel_count = np.sum(\n","    non_water_mask\n",")\n","\n","invalid_pixel_count = (\n","    image.size -\n","    len(valid_pixels)\n",")\n","\n","\n","# ============================================================\n","# 9. AREA CALCULATION\n","# ============================================================\n","#\n","# IMPORTANT:\n","#\n","# We DO NOT use:\n","#\n","#     sum(binary_image)\n","#\n","# because water pixels contain value 255.\n","#\n","# Instead:\n","#\n","#     number of water pixels\n","#                  ×\n","#     actual pixel area\n","#\n","# ============================================================\n","\n","\n","# ------------------------------------------------------------\n","# Pixel area\n","# ------------------------------------------------------------\n","\n","pixel_area = (\n","    pixel_width *\n","    pixel_height\n",")\n","\n","\n","# ------------------------------------------------------------\n","# Check whether CRS is projected or geographic\n","# ------------------------------------------------------------\n","\n","if crs is not None and crs.is_projected:\n","\n","    # Usually metres for UTM/projected satellite data\n","    pixel_area_m2 = pixel_area\n","\n","    water_area_m2 = (\n","        water_pixel_count *\n","        pixel_area_m2\n","    )\n","\n","    non_water_area_m2 = (\n","        non_water_pixel_count *\n","        pixel_area_m2\n","    )\n","\n","    water_area_km2 = (\n","        water_area_m2 /\n","        1_000_000\n","    )\n","\n","    non_water_area_km2 = (\n","        non_water_area_m2 /\n","        1_000_000\n","    )\n","\n","    area_method = (\n","        \"Projected CRS: \"\n","        \"pixel width × pixel height\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# Geographic CRS\n","# ------------------------------------------------------------\n","\n","elif crs is not None and crs.is_geographic:\n","\n","    print(\"\\nWARNING:\")\n","    print(\n","        \"TIFF uses latitude/longitude coordinates.\"\n","    )\n","\n","    print(\n","        \"Pixel dimensions are in degrees.\"\n","    )\n","\n","    print(\n","        \"Geographic pixel area calculation is required.\"\n","    )\n","\n","    # --------------------------------------------------------\n","    # For geographic CRS, calculate approximate area using\n","    # latitude-dependent Earth surface distance.\n","    # --------------------------------------------------------\n","\n","    from pyproj import Geod\n","\n","    geod = Geod(\n","        ellps=\"WGS84\"\n","    )\n","\n","    water_rows, water_cols = np.where(\n","        water_mask\n","    )\n","\n","    water_area_m2 = 0.0\n","\n","    for row, col in zip(\n","        water_rows,\n","        water_cols\n","    ):\n","\n","        x1, y1 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ul\"\n","        )\n","\n","        x2, y2 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ur\"\n","        )\n","\n","        x3, y3 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"lr\"\n","        )\n","\n","        x4, y4 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ll\"\n","        )\n","\n","        area, perimeter = (\n","            geod.polygon_area_perimeter(\n","                [x1, x2, x3, x4],\n","                [y1, y2, y3, y4]\n","            )\n","        )\n","\n","        water_area_m2 += abs(area)\n","\n","\n","    # Non-water area\n","    non_water_rows, non_water_cols = np.where(\n","        non_water_mask\n","    )\n","\n","    non_water_area_m2 = 0.0\n","\n","    for row, col in zip(\n","        non_water_rows,\n","        non_water_cols\n","    ):\n","\n","        x1, y1 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ul\"\n","        )\n","\n","        x2, y2 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ur\"\n","        )\n","\n","        x3, y3 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"lr\"\n","        )\n","\n","        x4, y4 = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col,\n","            offset=\"ll\"\n","        )\n","\n","        area, perimeter = (\n","            geod.polygon_area_perimeter(\n","                [x1, x2, x3, x4],\n","                [y1, y2, y3, y4]\n","            )\n","        )\n","\n","        non_water_area_m2 += abs(area)\n","\n","\n","    water_area_km2 = (\n","        water_area_m2 /\n","        1_000_000\n","    )\n","\n","    non_water_area_km2 = (\n","        non_water_area_m2 /\n","        1_000_000\n","    )\n","\n","    area_method = (\n","        \"Geographic CRS: \"\n","        \"geodesic pixel area\"\n","    )\n","\n","\n","else:\n","\n","    raise ValueError(\n","        \"CRS information is missing.\"\n","    )\n","\n","\n","# ============================================================\n","# 10. CONVERT AREA TO HECTARES\n","# ============================================================\n","\n","water_area_hectares = (\n","    water_area_m2 /\n","    10_000\n",")\n","\n","\n","non_water_area_hectares = (\n","    non_water_area_m2 /\n","    10_000\n",")\n","\n","\n","# ============================================================\n","# 11. FINAL OTSU + AREA RESULTS\n","# ============================================================\n","\n","print(\"\\n\")\n","print(\"=\" * 60)\n","print(\"             OTSU THRESHOLD RESULT\")\n","print(\"=\" * 60)\n","\n","print(\n","    f\"Minimum NDWI          : \"\n","    f\"{min_val:.10f}\"\n",")\n","\n","print(\n","    f\"Maximum NDWI          : \"\n","    f\"{max_val:.10f}\"\n",")\n","\n","print(\n","    f\"Otsu grayscale value  : \"\n","    f\"{otsu_8bit:.2f}\"\n",")\n","\n","print(\n","    f\"Otsu NDWI threshold   : \"\n","    f\"{otsu_ndwi:.10f}\"\n",")\n","\n","print(\"-\" * 60)\n","\n","print(\n","    f\"Water pixels          : \"\n","    f\"{water_pixel_count}\"\n",")\n","\n","print(\n","    f\"Non-water pixels      : \"\n","    f\"{non_water_pixel_count}\"\n",")\n","\n","print(\n","    f\"Invalid pixels        : \"\n","    f\"{invalid_pixel_count}\"\n",")\n","\n","print(\"=\" * 60)\n","\n","\n","# ============================================================\n","# 12. AREA RESULTS\n","# ============================================================\n","\n","print(\"\\n\")\n","print(\"=\" * 60)\n","print(\"               AREA CALCULATION\")\n","print(\"=\" * 60)\n","\n","print(\n","    f\"Pixel width           : \"\n","    f\"{pixel_width}\"\n",")\n","\n","print(\n","    f\"Pixel height          : \"\n","    f\"{pixel_height}\"\n",")\n","\n","print(\n","    f\"Pixel area            : \"\n","    f\"{pixel_area:.8f}\"\n",")\n","\n","print(\n","    f\"Area method           : \"\n","    f\"{area_method}\"\n",")\n","\n","print(\"-\" * 60)\n","\n","print(\n","    f\"Water area            : \"\n","    f\"{water_area_m2:.4f} m²\"\n",")\n","\n","print(\n","    f\"Water area            : \"\n","    f\"{water_area_hectares:.4f} hectares\"\n",")\n","\n","print(\n","    f\"Water area            : \"\n","    f\"{water_area_km2:.8f} km²\"\n",")\n","\n","print(\"-\" * 60)\n","\n","print(\n","    f\"Non-water area        : \"\n","    f\"{non_water_area_m2:.4f} m²\"\n",")\n","\n","print(\n","    f\"Non-water area        : \"\n","    f\"{non_water_area_hectares:.4f} hectares\"\n",")\n","\n","print(\n","    f\"Non-water area        : \"\n","    f\"{non_water_area_km2:.8f} km²\"\n",")\n","\n","print(\"=\" * 60)\n","\n","\n","# ============================================================\n","# 13. WATER PERCENTAGE\n","# ============================================================\n","\n","water_percentage = (\n","    water_pixel_count /\n","    len(valid_pixels)\n",") * 100\n","\n","\n","non_water_percentage = (\n","    non_water_pixel_count /\n","    len(valid_pixels)\n",") * 100\n","\n","\n","print(\"\\n\")\n","print(\"=\" * 60)\n","print(\"             