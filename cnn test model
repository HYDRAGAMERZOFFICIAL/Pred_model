   os.makedirs(\n","        directory,\n","        exist_ok=True\n","    )\n","\n","print(\"Project created:\")\n","print(PROJECT_DIR)\n","\n","# ============================================================\n","# CONFIGURATION\n","# ============================================================\n","\n","INPUT_TIMESTEPS = 2\n","\n","PATCH_SIZE = 64\n","STRIDE = 16\n","\n","BATCH_SIZE = 16\n","EPOCHS = 40\n","\n","LEARNING_RATE = 1e-4\n","\n","MIN_VALID_FRAC = 0.50\n","\n","LOWER_PERCENTILE = 2\n","UPPER_PERCENTILE = 98\n","\n","VALIDATION_SEQUENCES = 2\n","\n","PREDICTION_THRESHOLD = 0.5\n","\n","# ============================================================\n","# UPLOAD\n","# ============================================================\n","\n","print(\"\\nUpload:\")\n","print(\"  - NDWI GeoTIFFs\")\n","print(\"  - CSV/XLSX depth datasets\")\n","print(\"  - XML metadata if available\")\n","\n","uploaded = files.upload()\n","\n","if not uploaded:\n","\n","    raise ValueError(\n","        \"No files were uploaded.\"\n","    )\n","\n","# ============================================================\n","# ORGANIZE UPLOADED FILES\n","# ============================================================\n","\n","for filename in uploaded.keys():\n","\n","    lower = filename.lower()\n","\n","    if lower.endswith(\n","        (\".tif\", \".tiff\")\n","    ):\n","\n","        destination = os.path.join(\n","            RASTER_DIR,\n","            os.path.basename(filename)\n","        )\n","\n","    elif lower.endswith(\n","        (\".csv\", \".xlsx\", \".xls\")\n","    ):\n","\n","        destination = os.path.join(\n","            TABULAR_DIR,\n","            os.path.basename(filename)\n","        )\n","\n","    elif lower.endswith(\".xml\"):\n","\n","        destination = os.path.join(\n","            METADATA_DIR,\n","            os.path.basename(filename)\n","        )\n","\n","    else:\n","\n","        print(\n","            \"Ignoring:\",\n","            filename\n","        )\n","\n","        continue\n","\n","    shutil.copy(\n","        filename,\n","        destination\n","    )\n","\n","print(\"\\nFiles organized.\")\n","\n","# ============================================================\n","# FIND FILES\n","# ============================================================\n","\n","tif_paths = [\n","    os.path.join(RASTER_DIR, f)\n","    for f in os.listdir(RASTER_DIR)\n","    if f.lower().endswith(\n","        (\".tif\", \".tiff\")\n","    )\n","]\n","\n","csv_paths = [\n","    os.path.join(TABULAR_DIR, f)\n","    for f in os.listdir(TABULAR_DIR)\n","    if f.lower().endswith(\n","        (\".csv\", \".xlsx\", \".xls\")\n","    )\n","]\n","\n","xml_paths = [\n","    os.path.join(METADATA_DIR, f)\n","    for f in os.listdir(METADATA_DIR)\n","    if f.lower().endswith(\".xml\")\n","]\n","\n","# ============================================================\n","# CHRONOLOGICAL SORT\n","# ============================================================\n","\n","def temporal_sort_key(path):\n","\n","    filename = os.path.basename(\n","        path\n","    ).upper()\n","\n","    year_match = re.search(\n","        r\"20\\d{2}\",\n","        filename\n","    )\n","\n","    if year_match:\n","\n","        year = int(\n","            year_match.group()\n","        )\n","\n","    else:\n","\n","        year = 9999\n","\n","    if \"JAN_APR\" in filename:\n","\n","        period = 1\n","\n","    elif \"MAY_AUG\" in filename:\n","\n","        period = 2\n","\n","    elif \"SEP_DEC\" in filename:\n","\n","        period = 3\n","\n","    else:\n","\n","        period = 99\n","\n","    return (\n","        year,\n","        period,\n","        filename\n","    )\n","\n","\n","tif_paths = sorted(\n","    tif_paths,\n","    key=temporal_sort_key\n",")\n","\n","# ============================================================\n","# SHOW TEMPORAL DATASET\n","# ============================================================\n","\n","print(\"\\n================================================\")\n","print(\"TEMPORAL NDWI DATASET\")\n","print(\"================================================\")\n","\n","for i, path in enumerate(tif_paths):\n","\n","    print(\n","        f\"{i:02d} | \"\n","        f\"{os.path.basename(path)}\"\n","    )\n","\n","print(\n","    \"\\nNumber of raster periods:\",\n","    len(tif_paths)\n",")\n","\n","# ============================================================\n","# EXPECTED ORDER CHECK\n","# ============================================================\n","\n","if len(tif_paths) < INPUT_TIMESTEPS + 1:\n","\n","    print(\n","        \"\\nWARNING:\"\n","        \"\\nNot enough periods for genuine forecasting.\"\n","    )\n","\n","else:\n","\n","    print(\n","        \"\\nGenuine temporal forecasting is available.\"\n","    )\n","\n","# ============================================================\n","# LOAD TABULAR DATA\n","# ============================================================\n","\n","tabular_frames = []\n","\n","for path in csv_paths:\n","\n","    try:\n","\n","        if path.lower().endswith(\n","            \".csv\"\n","        ):\n","\n","            df = pd.read_csv(\n","                path\n","            )\n","\n","        else:\n","\n","            df = pd.read_excel(\n","                path\n","            )\n","\n","        df[\"source_file\"] = os.path.basename(\n","            path\n","        )\n","\n","        tabular_frames.append(\n","            df\n","        )\n","\n","        print(\n","            f\"\\nLoaded {os.path.basename(path)}\"\n","        )\n","\n","        print(\n","            \"Shape:\",\n","            df.shape\n","        )\n","\n","        print(\n","            \"Columns:\",\n","            list(df.columns)\n","        )\n","\n","    except Exception as e:\n","\n","        print(\n","            \"Could not load:\",\n","            path,\n","            e\n","        )\n","\n","if tabular_frames:\n","\n","    tabular_df = pd.concat(\n","        tabular_frames,\n","        ignore_index=True,\n","        sort=False\n","    )\n","\n","else:\n","\n","    tabular_df = None\n","\n","# ============================================================\n","# RASTER LOADER\n","# ============================================================\n","\n","def load_raster(path):\n","\n","    with rasterio.open(path) as src:\n","\n","        image = src.read(\n","            1\n","        ).astype(\n","            np.float32\n","        )\n","\n","        valid = np.isfinite(\n","            image\n","        )\n","\n","        if src.nodata is not None:\n","\n","            valid &= (\n","                image != src.nodata\n","            )\n","\n","        profile = src.profile.copy()\n","\n","        transform = src.transform\n","\n","        crs = src.crs\n","\n","        height = src.height\n","\n","        width = src.width\n","\n","    valid &= (\n","        image > -1e30\n","    )\n","\n","    image = np.where(\n","        valid,\n","        image,\n","        np.nan\n","    ).astype(\n","        np.float32\n","    )\n","\n","    return (\n","        image,\n","        valid,\n","        profile,\n","        transform,\n","        crs,\n","        height,\n","        width\n","    )\n","\n","# ============================================================\n","# CHECK RASTER GRID\n","# ============================================================\n","\n","def validate_rasters(paths):\n","\n","    reference = None\n","\n","    for path in paths:\n","\n","        (\n","            image,\n","            valid,\n","            profile,\n","            transform,\n","            crs,\n","            height,\n","            width\n","        ) = load_raster(path)\n","\n","        current = {\n","            \"height\": height,\n","            \"width\": width,\n","            \"transform\": transform,\n","            \"crs\": crs\n","        }\n","\n","        if reference is None:\n","\n","            reference = current\n","\n","        else:\n","\n","            if (\n","                height\n","                != reference[\"height\"]\n","            ):\n","\n","                raise ValueError(\n","                    f\"Height mismatch: {path}\"\n","                )\n","\n","            if (\n","                width\n","                != reference[\"width\"]\n","            ):\n","\n","                raise ValueError(\n","                    f\"Width mismatch: {path}\"\n","                )\n","\n","            if (\n","                transform\n","                != reference[\"transform\"]\n","            ):\n","\n","                raise ValueError(\n","                    f\"Transform mismatch: {path}\"\n","                )\n","\n","            if (\n","                crs\n","                != reference[\"crs\"]\n","            ):\n","\n","                raise ValueError(\n","                    f\"CRS mismatch: {path}\"\n","                )\n","\n","    return reference\n","\n","\n","reference = validate_rasters(\n","    tif_paths\n",")\n","\n","CANVAS_H = reference[\"height\"]\n","CANVAS_W = reference[\"width\"]\n","\n","REFERENCE_TRANSFORM = (\n","    reference[\"transform\"]\n",")\n","\n","REFERENCE_CRS = reference[\"crs\"]\n","\n","print(\"\\nRaster grid:\")\n","print(\n","    CANVAS_H,\n","    \"x\",\n","    CANVAS_W\n",")\n","\n","print(\n","    \"CRS:\",\n","    REFERENCE_CRS\n",")\n","\n","# ============================================================\n","# NORMALIZATION\n","# ============================================================\n","\n","def normalize_ndwi(\n","    image,\n","    valid_mask\n","):\n","\n","    result = np.zeros_like(\n","        image,\n","        dtype=np.float32\n","    )\n","\n","    values = image[\n","        valid_mask\n","    ]\n","\n","    if len(values) == 0:\n","\n","        return result\n","\n","    low = np.percentile(\n","        values,\n","        LOWER_PERCENTILE\n","    )\n","\n","    high = np.percentile(\n","        values,\n","        UPPER_PERCENTILE\n","    )\n","\n","    if high <= low:\n","\n","        return result\n","\n","    clipped = np.clip(\n","        image[\n","            valid_mask\n","        ],\n","        low,\n","        high\n","    )\n","\n","    result[\n","        valid_mask\n","    ] = (\n","        clipped - low\n","    ) / (\n","        high - low\n","    )\n","\n","    return result\n","\n","# ============================================================\n","# OTSU LABEL\n","# ============================================================\n","\n","def otsu_label(\n","    image,\n","    valid_mask\n","):\n","\n","    values = image[\n","        valid_mask\n","    ]\n","\n","    label = np.zeros_like(\n","        image,\n","        dtype=np.float32\n","    )\n","\n","    if len(values) < 2:\n","\n","        return label, np.nan\n","\n","    threshold = cv2.threshold(\n","        cv2.normalize(\n","            values,\n","            None,\n","            0,\n","            255,\n","            cv2.NORM_MINMAX\n","        ).astype(np.uint8),\n","        0,\n","        255,\n","        cv2.THRESH_BINARY +\n","        cv2.THRESH_OTSU\n","    )[0]\n","\n","    original_min = values.min()\n","    original_max = values.max()\n","\n","    original_threshold = (\n","        original_min\n","        +\n","        (\n","            threshold / 255.0\n","        )\n","        *\n","        (\n","            original_max\n","            -\n","            original_min\n","        )\n","    )\n","\n","    label[\n","        valid_mask\n","    ] = (\n","        image[\n","            valid_mask\n","        ]\n","        >= original_threshold\n","    ).astype(\n","        np.float32\n","    )\n","\n","    return (\n","        label,\n","        original_threshold\n","    )\n","\n","# ============================================================\n","# LOAD TEMPORAL RASTERS\n","# ============================================================\n","\n","records = []\n","\n","for path in tif_paths:\n","\n","    image, valid, profile, transform, crs, h, w = load_raster(\n","        path\n","    )\n","\n","    normalized = normalize_ndwi(\n","        image,\n","        valid\n","    )\n","\n","    label, threshold = otsu_label(\n","        image,\n","        valid\n","    )\n","\n","    records.append({\n","\n","        \"path\": path,\n","\n","        \"image\": image,\n","\n","        \"normalized\": normalized,\n","\n","        \"valid\": valid.astype(\n","            np.float32\n","        ),\n","\n","        \"label\": label,\n","\n","        \"otsu_threshold\": threshold\n","\n","    })\n","\n","    print(\n","        os.path.basename(path),\n","        \"| Otsu:\",\n","        threshold\n","    )\n","\n","# ============================================================\n","# BUILD TEMPORAL SEQUENCES\n","# ============================================================\n","\n","def build_sequences(records):\n","\n","    sequences = []\n","\n","    n = len(records)\n","\n","    if n < INPUT_TIMESTEPS + 1:\n","\n","        return sequences\n","\n","    for target in range(\n","        INPUT_TIMESTEPS,\n","        n\n","    ):\n","\n","        inputs = list(\n","            range(\n","                target -\n","                INPUT_TIMESTEPS,\n","                target\n","            )\n","        )\n","\n","        sequences.append({\n","\n","            \"inputs\": inputs,\n","\n","            \"target\": target\n","\n","        })\n","\n","    return sequences\n","\n","\n","sequences = build_sequences(\n","    records\n",")\n","\n","print(\n","    \"\\nForecast sequences:\",\n","    len(sequences)\n",")\n","\n","for i, seq in enumerate(\n","    sequences\n","):\n","\n","    print(\n","        i,\n","        \"INPUT:\",\n","        seq[\"inputs\"],\n","        \"TARGET:\",\n","        seq[\"target\"]\n","    )\n","\n","# ============================================================\n","# PATCH POSITIONS\n","# ============================================================\n","\n","def patch_positions(\n","    height,\n","    width\n","):\n","\n","    ys = list(\n","        range(\n","            0,\n","            max(\n","                height -\n","                PATCH_SIZE,\n","                0\n","            ) + 1,\n","            STRIDE\n","        )\n","    )\n","\n","    xs = list(\n","        range(\n","            0,\n","            max(\n","                width -\n","                PATCH_SIZE,\n","                0\n","            ) + 1,\n","            STRIDE\n","        )\n","    )\n","\n","    if height > PATCH_SIZE:\n","\n","        last_y = (\n","            height -\n","            PATCH_SIZE\n","        )\n","\n","        if last_y not in ys:\n","\n","            ys.append(\n","                last_y\n","            )\n","\n","    if width > PATCH_SIZE:\n","\n","        last_x = (\n","            width -\n","            PATCH_SIZE\n","        )\n","\n","        if last_x not in xs:\n","\n","            xs.append(\n","                last_x\n","            )\n","\n","    if height <= PATCH_SIZE:\n","\n","        ys = [0]\n","\n","    if width <= PATCH_SIZE:\n","\n","        xs = [0]\n","\n","    return ys, xs\n","\n","# ============================================================\n","# EXTRACT PATCHES\n","# ============================================================\n","\n","def extract_patches(\n","    sequence\n","):\n","\n","    inputs = [\n","\n","        records[i][\"normalized\"]\n","\n","        for i in sequence[\"inputs\"]\n","\n","    ]\n","\n","    target = records[\n","        sequence[\"target\"]\n","    ][\"label\"]\n","\n","    valid = records[\n","        sequence[\"target\"]\n","    ][\"valid\"]\n","\n","    X = []\n","\n","    Y = []\n","\n","    ys, xs = patch_positions(\n","        CANVAS_H,\n","        CANVAS_W\n","    )\n","\n","    for y in ys:\n","\n","        for x in xs:\n","\n","            stack = np.stack(\n","\n","                [\n","                    image[\n","                        y:y+PATCH_SIZE,\n","                        x:x+PATCH_SIZE\n","                    ]\n","\n","                    for image in inputs\n","                ],\n","\n","                axis=-1\n","            )\n","\n","            target_patch = target[\n","                y:y+PATCH_SIZE,\n","                x:x+PATCH_SIZE\n","            ]\n","\n","            valid_patch = valid[\n","                y:y+PATCH_SIZE,\n","                x:x+PATCH_SIZE\n","            ]\n","\n","            if (\n","                valid_patch.size == 0\n","            ):\n","\n","                continue\n","\n","            if (\n","                valid_patch.mean()\n","                <\n","                MIN_VALID_FRAC\n","            ):\n","\n","                continue\n","\n","            ph, pw = target_patch.shape\n","\n","            padded_x = np.zeros(\n","                (\n","                    PATCH_SIZE,\n","                    PATCH_SIZE,\n","                    INPUT_TIMESTEPS\n","                ),\n","                dtype=np.float32\n","            )\n","\n","            padded_y = np.zeros(\n","                (\n","                    PATCH_SIZE,\n","                    PATCH_SIZE,\n","                    2\n","                ),\n","                dtype=np.float32\n","            )\n","\n","            padded_x[\n","                :ph,\n","                :pw,\n","                :\n","            ] = stack\n","\n","            padded_y[\n","                :ph,\n","                :pw,\n","                0\n","            ] = target_patch\n","\n","            padded_y[\n","                :ph,\n","                :pw,\n","                1\n","            ] = valid_patch\n","\n","            X.append(\n","                padded_x\n","            )\n","\n","            Y.append(\n","                padded_y\n","            )\n","\n","    return (\n","        np.asarray(X),\n","        np.asarray(Y)\n","    )\n","\n","# ============================================================\n","# TRAIN / VALIDATION SPLIT\n","# ============================================================\n","\n","if len(sequences) < 3:\n","\n","    raise ValueError(\n","        \"At least 3 temporal sequences are recommended.\"\n","    )\n","\n","train_sequences = sequences[\n","    :-VALIDATION_SEQUENCES\n","]\n","\n","val_sequences = sequences[\n","    -VALIDATION_SEQUENCES:\n","]\n","\n","print(\n","    \"\\nTraining sequences:\",\n","    len(train_sequences)\n",")\n","\n","print(\n","    \"Validation sequences:\",\n","    len(val_sequences)\n",")\n","\n","# ============================================================\n","# BUILD DATASET\n","# ============================================================\n","\n","def build_dataset(\n","    sequence_list\n","):\n","\n","    X_all = []\n","\n","    Y_all = []\n","\n","    for sequence in sequence_list:\n","\n","        X, Y = extract_patches(\n","            sequence\n","        )\n","\n","        if len(X) > 0:\n","\n","            X_all.append(X)\n","\n","            Y_all.append(Y)\n","\n","    if not X_all:\n","\n","        return (\n","            np.empty(\n","                (\n","                    0,\n","                    PATCH_SIZE,\n","                    PATCH_SIZE,\n","                    INPUT_TIMESTEPS\n","                ),\n","                dtype=np.float32\n","            ),\n","\n","            np.empty(\n","                (\n","                    0,\n","                    PATCH_SIZE,\n","                    PATCH_SIZE,\n","                    2\n","                ),\n","                dtype=np.float32\n","            )\n","        )\n","\n","    return (\n","        np.concatenate(\n","            X_all\n","        ),\n","\n","        np.concatenate(\n","            Y_all\n","        )\n","    )\n","\n","\n","X_train, Y_train = build_dataset(\n","    train_sequences\n",")\n","\n","X_val, Y_val = build_dataset(\n","    val_sequences\n",")\n","\n","print(\n","    \"\\nX_train:\",\n","    X_train.shape\n",")\n","\n","print(\n","    \"Y_train:\",\n","    Y_train.shape\n",")\n","\n","print(\n","    \"X_val:\",\n","    X_val.shape\n",")\n","\n","print(\n","    \"Y_val:\",\n","    Y_val.shape\n",")\n","\n","# ============================================================\n","# U-NET\n","# ============================================================\n","\n","def conv_block(\n","    x,\n","    filters\n","):\n","\n","    x = layers.Conv2D(\n","        filters,\n","        3,\n","        padding=\"same\"\n","    )(x)\n","\n","    x = layers.BatchNormalization()(x)\n","\n","    x = layers.ReLU()(x)\n","\n","    x = layers.Conv2D(\n","        filters,\n","        3,\n","        padding=\"same\"\n","    )(x)\n","\n","    x = layers.BatchNormalization()(x)\n","\n","    x = layers.ReLU()(x)\n","\n","    return x\n","\n","\n","def build_unet():\n","\n","    inputs = layers.Input(\n","        shape=(\n","            PATCH_SIZE,\n","            PATCH_SIZE,\n","            INPUT_TIMESTEPS\n","        )\n","    )\n","\n","    c1 = conv_block(\n","        inputs,\n","        32\n","    )\n","\n","    p1 = layers.MaxPooling2D()(\n","        c1\n","    )\n","\n","    c2 = conv_block(\n","        p1,\n","        64\n","    )\n","\n","    p2 = layers.MaxPooling2D()(\n","        c2\n","    )\n","\n","    c3 = conv_block(\n","        p2,\n","        128\n","    )\n","\n","    p3 = layers.MaxPooling2D()(\n","        c3\n","    )\n","\n","    bottleneck = conv_block(\n","        p3,\n","        256\n","    )\n","\n","    u3 = layers.Conv2DTranspose(\n","        128,\n","        2,\n","        strides=2,\n","        padding=\"same\"\n","    )(bottleneck)\n","\n","    u3 = layers.Concatenate()(\n","        [u3, c3]\n","    )\n","\n","    c4 = conv_block(\n","        u3,\n","        128\n","    )\n","\n","    u2 = layers.Conv2DTranspose(\n","        64,\n","        2,\n","        strides=2,\n","        padding=\"same\"\n","    )(c4)\n","\n","    u2 = layers.Concatenate()(\n","        [u2, c2]\n","    )\n","\n","    c5 = conv_block(\n","        u2,\n","        64\n","    )\n","\n","    u1 = layers.Conv2DTranspose(\n","        32,\n","        2,\n","        strides=2,\n","        padding=\"same\"\n","    )(c5)\n","\n","    u1 = layers.Concatenate()(\n","        [u1, c1]\n","    )\n","\n","    c6 = conv_block(\n","        u1,\n","        32\n","    )\n","\n","    output = layers.Conv2D(\n","        1,\n","        1,\n","        activation=\"sigmoid\"\n","    )(c6)\n","\n","    return models.Model(\n","        inputs,\n","        output,\n","        name=\"NDWI_MultiTemporal_UNet\"\n","    )\n","\n","model = build_unet()\n","\n","model.summary()\n","\n","# ============================================================\n","# MASKED LOSS\n","# ============================================================\n","\n","def masked_bce_dice(\n","    y_true,\n","    y_pred\n","):\n","\n","    label = y_true[\n","        ..., 0\n","    ]\n","\n","    valid = y_true[\n","        ..., 1\n","    ]\n","\n","    pred = y_pred[\n","        ..., 0\n","    ]\n","\n","    pred = tf.clip_by_value(\n","        pred,\n","        1e-7,\n","        1 - 1e-7\n","    )\n","\n","    bce = -(\n","        label *\n","        tf.math.log(pred)\n","        +\n","        (1-label) *\n","        tf.math.log(1-pred)\n","    )\n","\n","    bce = tf.reduce_sum(\n","        bce * valid\n","    ) / (\n","        tf.reduce_sum(valid)\n","        + 1e-6\n","    )\n","\n","    intersection = tf.reduce_sum(\n","        label *\n","        pred *\n","        valid\n","    )\n","\n","    denominator = (\n","        tf.reduce_sum(\n","            label * valid\n","        )\n","        +\n","        tf.reduce_sum(\n","            pred * valid\n","        )\n","    )\n","\n","    dice = (\n","        2 * intersection\n","        + 1e-6\n","    ) / (\n","        denominator\n","        + 1e-6\n","    )\n","\n","    return bce + (\n","        1 - dice\n","    )\n","\n","# ============================================================\n","# IOU\n","# ============================================================\n","\n","def masked_iou(\n","    y_true,\n","    y_pred\n","):\n","\n","    label = y_true[\n","        ..., 0\n","    ]\n","\n","    valid = y_true[\n","        ..., 1\n","    ]\n","\n","    pred = tf.cast(\n","        y_pred[..., 0] >= 0.5,\n","        tf.float32\n","    )\n","\n","    intersection = tf.reduce_sum(\n","        label *\n","        pred *\n","        valid\n","    )\n","\n","    union = tf.reduce_sum(\n","        tf.maximum(\n","            label,\n","            pred\n","        )\n","        *\n","        valid\n","    )\n","\n","    return (\n","        intersection + 1e-6\n","    ) / (\n","        union + 1e-6\n","    )\n","\n","# ============================================================\n","# COMPILE\n","# ============================================================\n","\n","model.compile(\n","\n","    optimizer=tf.keras.optimizers.Adam(\n","        learning_rate=LEARNING_RATE\n","    ),\n","\n","    loss=masked_bce_dice,\n","\n","    metrics=[\n","        masked_iou\n","    ]\n",")\n","\n","# ============================================================\n","# CALLBACKS\n","# ============================================================\n","\n","checkpoint_path = os.path.join(\n","    MODEL_DIR,\n","    \"best_unet.keras\"\n",")\n","\n","training_callbacks = [\n","\n","    callbacks.ModelCheckpoint(\n","        checkpoint_path,\n","        monitor=\"val_masked_iou\",\n","        mode=\"max\",\n","        save_best_only=True\n","    ),\n","\n","    callbacks.EarlyStopping(\n","        monitor=\"val_masked_iou\",\n","        mode=\"max\",\n","        patience=8,\n","        restore_best_weights=True\n","    ),\n","\n","    callbacks.ReduceLROnPlateau(\n","        monitor=\"val_loss\",\n","        factor=0.5,\n","        patience=4,\n","        min_lr=1e-7\n","    )\n","]\n","\n","# ============================================================\n","# TRAIN\n","# ============================================================\n","\n","history = model.fit(\n","\n","    X_train,\n","    Y_train,\n","\n","    validation_data=(\n","        X_val,\n","        Y_val\n","    ),\n","\n","    epochs=EPOCHS,\n","\n","    batch_size=BATCH_SIZE,\n","\n","    shuffle=True,\n","\n","    callbacks=training_callbacks,\n","\n","    verbose=1\n",")\n","\n","# ============================================================\n","# TRAINING GRAPH\n","# ============================================================\n","\n","plt.figure(\n","    figsize=(10,5)\n",")\n","\n","plt.plot(\n","    history.history[\"loss\"],\n","    label=\"Training Loss\"\n",")\n","\n","plt.plot(\n","    history.history[\"val_loss\"],\n","    label=\"Validation Loss\"\n",")\n","\n","plt.xlabel(\"Epoch\")\n","\n","plt.ylabel(\"Loss\")\n","\n","plt.title(\n","    \"NDWI U-Net Training\"\n",")\n","\n","plt.legend()\n","\n","plt.grid()\n","\n","plt.savefig(\n","    os.path.join(\n","        OUTPUT_DIR,\n","        \"training_history.png\"\n","    ),\n","    dpi=200,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()\n","\n","# ============================================================\n","# PREDICT NEXT PERIOD\n","# ============================================================\n","\n","def predict_next_period():\n","\n","    stack = np.stack(\n","\n","        [\n","            r[\"normalized\"]\n","            for r in records[\n","                -INPUT_TIMESTEPS:\n","            ]\n","        ],\n","\n","        axis=-1\n","    )\n","\n","    probability = np.zeros(\n","        (\n","            CANVAS_H,\n","            CANVAS_W\n","        ),\n","        dtype=np.float32\n","    )\n","\n","    count = np.zeros(\n","        (\n","            CANVAS_H,\n","            CANVAS_W\n","        ),\n","        dtype=np.float32\n","    )\n","\n","    ys, xs = patch_positions(\n","        CANVAS_H,\n","        CANVAS_W\n","    )\n","\n","    for y in ys:\n","\n","        for x in xs:\n","\n","            patch = stack[\n","                y:y+PATCH_SIZE,\n","                x:x+PATCH_SIZE,\n","                :\n","            ]\n","\n","            ph, pw = patch.shape[:2]\n","\n","            padded = np.zeros(\n","                (\n","                    1,\n","                    PATCH_SIZE,\n","                    PATCH_SIZE,\n","                    INPUT_TIMESTEPS\n","                ),\n","                dtype=np.float32\n","            )\n","\n","            padded[\n","                0,\n","                :ph,\n","                :pw,\n","                :\n","            ] = patch\n","\n","            prediction = model.predict(\n","                padded,\n","                verbose=0\n","            )[0, :ph, :pw, 0]\n","\n","            probability[\n","                y:y+ph,\n","                x:x+pw\n","            ] += prediction\n","\n","            count[\n","                y:y+ph,\n","                x:x+pw\n","            ] += 1\n","\n","    probability /= np.maximum(\n","        count,\n","        1\n","    )\n","\n","    mask = (\n","        probability\n","        >=\n","        PREDICTION_THRESHOLD\n","    ).astype(\n","        np.uint8\n","    )\n","\n","    return (\n","        probability,\n","        mask\n","    )\n","\n","probability_map, water_mask = (\n","    predict_next_period()\n",")\n","\n","# ============================================================\n","# DISPLAY\n","# ============================================================\n","\n","fig, axes = plt.subplots(\n","    1,\n","    3,\n","    figsize=(15,5)\n",")\n","\n","axes[0].imshow(\n","    records[-1][\"normalized\"],\n","    cmap=\"viridis\",\n","    vmin=0,\n","    vmax=1\n",")\n","\n","axes[0].set_title(\n","    \"Latest NDWI\"\n",")\n","\n","axes[1].imshow(\n","    probability_map,\n","    cmap=\"Blues\",\n","    vmin=0,\n","    vmax=1\n",")\n","\n","axes[1].set_title(\n","    \"Predicted Water Probability\"\n",")\n","\n","axes[2].imshow(\n","    water_mask,\n","    cmap=\"gray\",\n","    vmin=0,\n","    vmax=1\n",")\n","\n","axes[2].set_title(\n","    \"Predicted Water Mask\"\n",")\n","\n","for ax in axes:\n","\n","    ax.axis(\"off\")\n","\n","plt.tight_layout()\n","\n","plt.show()\n","\n","# ============================================================\n","# SAVE PROBABILITY GEOTIFF\n","# ============================================================\n","\n","reference_profile = rasterio.open(\n","    tif_paths[0]\n",").profile.copy()\n","\n","reference_profile.update(\n","    count=1,\n","    dtype=\"float32\",\n","    compress=\"deflate\"\n",")\n","\n","reference_profile.pop(\n","    \"nodata\",\n","    None\n",")\n","\n","reference_profile.pop(\n","    \"blockxsize\",\n","    None\n",")\n","\n","reference_profile.pop(\n","    \"blockysize\",\n","    None\n",")\n","\n","reference_profile.pop(\n","    \"tiled\",\n","    None\n",")\n","\n","probability_path = os.path.join(\n","    OUTPUT_DIR,\n","    \"predicted_water_probability.tif\"\n",")\n","\n","with rasterio.open(\n","    probability_path,\n","    \"w\",\n","    **reference_profile\n",") as dst:\n","\n","    dst.write(\n","        probability_map.astype(\n","            np.float32\n","        ),\n","        1\n","    )\n","\n","# ============================================================\n","# SAVE MASK GEOTIFF\n","# ============================================================\n","\n","mask_profile = reference_profile.copy()\n","\n","mask_profile.update(\n","    dtype=\"uint8\"\n",")\n","\n","mask_path = os.path.join(\n","    OUTPUT_DIR,\n","    \"predicted_water_mask.tif\"\n",")\n","\n","with rasterio.open(\n","    mask_path,\n","    \"w\",\n","    **mask_profile\n",") as dst:\n","\n","    dst.write(\n","        water_mask.astype(\n","            np.uint8\n","        ),\n","        1\n","    )\n","\n","# ============================================================\n","# SAVE METADATA\n","# ============================================================\n","\n","metadata = {\n","\n","    \"model\":\n","        \"NDWI_MultiTemporal_UNet\",\n","\n","    \"input_timesteps\":\n","        INPUT_TIMESTEPS,\n","\n","    \"patch_size\":\n","        PATCH_SIZE,\n","\n","    \"stride\":\n","        STRIDE,\n","\n","    \"epochs\":\n","        EPOCHS,\n","\n","    \"training_sequences\":\n","        len(train_sequences),\n","\n","    \"validation_sequences\":\n","        len(val_sequences),\n","\n","    \"training_patches\":\n","        int(len(X_train)),\n","\n","    \"validation_patches\":\n","        int(len(X_val)),\n","\n","    \"input_rasters\":\n","        [\n","            os.path.basename(\n","                p\n","            )\n","            for p in tif_paths\n","        ],\n","\n","    \"prediction_inputs\":\n","        [\n","            os.path.basename(\n","                p\n","            )\n","            for p in tif_paths[\n","                -INPUT_TIMESTEPS:\n","            ]\n","        ],\n","\n","    \"prediction_threshold\":\n","        PREDICTION_THRESHOLD\n","}\n","\n","metadata_path = os.path.join(\n","    MODEL_DIR,\n","    \"model_metadata.json\"\n",")\n","\n","with open(\n","    metadata_path,\n","    \"w\"\n",") as f:\n","\n","    json.dump(\n","        metadata,\n","        f,\n","        indent=4\n","    )\n","\n","# ============================================================\n","# SAVE FINAL MODEL\n","# ============================================================\n","\n","final_model_path = os.path.join(\n","    MODEL_DIR,\n","    \"ndwi_water_unet.keras\"\n",")\n","\n","model.save(\n","    final_model_path\n",")\n","\n","# ============================================================\n","# FINAL OUTPUT\n","# ============================================================\n","\n","print(\"\\n==============================================\")\n","print(\"PROJECT COMPLETE\")\n","print(\"==============================================\")\n","\n","print(\"\\nModel:\")\n","print(\n","    final_model_path\n",")\n","\n","print(\"\\nPrediction:\")\n","print(\n","    probability_path\n",")\n","\n","print(\n","    mask_path\n",")\n","\n","print(\"\\nMetadata:\")\n","print(\n","    metadata_path\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"Ot0rcNz18enI","executionInfo":{"status":"ok","timestamp":1787125612313,"user_tz":-330,"elapsed":633276,"user":{"displayName":"Naturesworld","userId":"00808670514782698905"}},"outputId":"18d6af74-d15f-42a0-b1fd-c66929e54309"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Project created:\n","/content/NDWI_Water_Forecasting\n","\n","Upload:\n","  - NDWI GeoTIFFs\n","  - CSV/XLSX depth datasets\n","  - XML metadata if available\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","     <input type=\"file\" id=\"files-5fc8853a-8c94-42c9-a97a-c19934f5bb63\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-5fc8853a-8c94-42c9-a97a-c19934f5bb63\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saving NDWI_pixel_depth_dataset_25.csv to NDWI_pixel_depth_dataset_25 (2).csv\n","Saving NDWI_pixel_depth_dataset_24.csv to NDWI_pixel_depth_dataset_24 (2).csv\n","Saving NDWI_pixel_depth_dataset_23.csv to NDWI_pixel_depth_dataset_23 (2).csv\n","Saving NDWI_pixel_depth_dataset_22.csv to NDWI_pixel_depth_dataset_22 (2).csv\n","Saving NDWI_JAN_APR_22.tif to NDWI_JAN_APR_22 (2).tif\n","Saving NDWI_SEP_DEC_25.tif to NDWI_SEP_DEC_25 (2).tif\n","Saving NDWI_MAY_AUG_25.tif to NDWI_MAY_AUG_25 (2).tif\n","Saving NDWI_JAN_APR_25.tif to NDWI_JAN_APR_25 (2).tif\n","Saving NDWI_MAY_AUG_24