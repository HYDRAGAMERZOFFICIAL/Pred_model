_lake_unet.keras\n"]}]},{"cell_type":"code","source":["# ============================================================\n","# NDWI + DEPTH MULTI-TEMPORAL CNN / U-NET\n","# ============================================================\n","#\n","# INPUT:\n","#   Multiple chronological NDWI GeoTIFFs\n","#   Yearly pixel/depth CSV files\n","#\n","# CNN INPUT:\n","#   For each timestep:\n","#       channel 0 = NDWI\n","#       channel 1 = depth\n","#\n","# With INPUT_TIMESTEPS = 2:\n","#\n","#   [NDWI_t-1, Depth_t-1, NDWI_t, Depth_t]\n","#\n","# OUTPUT:\n","#   Next-period water probability\n","#   Next-period water mask\n","#   Water area in km2\n","#\n","# ALSO:\n","#   - Correct chronological sorting\n","#   - CSV/depth matching\n","#   - Otsu pseudo-labels\n","#   - U-Net training\n","#   - Temporal validation\n","#   - Full raster prediction\n","#   - GeoTIFF export\n","#   - Hidden-layer visualization\n","# ============================================================\n","\n","\n","# ============================================================\n","# 0. INSTALL\n","# ============================================================\n","\n","!pip install -q rasterio tensorflow opencv-python pandas openpyxl scikit-learn matplotlib pyproj\n","\n","\n","# ============================================================\n","# 1. IMPORTS\n","# ============================================================\n","\n","import os\n","import re\n","import json\n","import warnings\n","\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","\n","import rasterio\n","from rasterio.transform import rowcol\n","from rasterio.warp import (\n","    calculate_default_transform,\n","    reproject,\n","    Resampling\n",")\n","\n","import tensorflow as tf\n","\n","from tensorflow.keras import layers, models, callbacks\n","\n","from sklearn.metrics import (\n","    mean_absolute_error,\n","    r2_score\n",")\n","\n","from google.colab import files\n","\n","\n","warnings.filterwarnings(\"ignore\")\n","\n","\n","# ============================================================\n","# 2. CONFIGURATION\n","# ============================================================\n","\n","INPUT_TIMESTEPS = 2\n","\n","PATCH_SIZE = 64\n","STRIDE = 16\n","\n","BATCH_SIZE = 16\n","EPOCHS = 40\n","\n","LEARNING_RATE = 1e-4\n","\n","MIN_VALID_FRAC = 0.50\n","\n","LOWER_PERCENTILE = 2\n","UPPER_PERCENTILE = 98\n","\n","PREDICTION_THRESHOLD = 0.50\n","\n","VALIDATION_SEQUENCES = 2\n","\n","SEED = 100\n","\n","np.random.seed(SEED)\n","tf.random.set_seed(SEED)\n","\n","\n","# ============================================================\n","# 3. UPLOAD FILES\n","# ============================================================\n","\n","print(\"=\" * 70)\n","print(\"UPLOAD NDWI + DEPTH FILES\")\n","print(\"=\" * 70)\n","\n","print(\"\"\"\n","Upload:\n","\n","NDWI GeoTIFFs:\n","    NDWI_JAN_APR_22.tif\n","    NDWI_MAY_AUG_22.tif\n","    NDWI_SEP_DEC_22.tif\n","    ...\n","    NDWI_SEP_DEC_25.tif\n","\n","Depth CSVs:\n","    NDWI_pixel_depth_dataset_22.csv\n","    NDWI_pixel_depth_dataset_23.csv\n","    NDWI_pixel_depth_dataset_24.csv\n","    NDWI_pixel_depth_dataset_25.csv\n","\n","Do NOT worry about .aux.xml files.\n","\"\"\")\n","\n","uploaded = files.upload()\n","\n","all_files = list(uploaded.keys())\n","\n","if len(all_files) == 0:\n","    raise ValueError(\"No files uploaded.\")\n","\n","\n","# ============================================================\n","# 4. CLASSIFY FILES\n","# ============================================================\n","\n","tif_paths = [\n","    p for p in all_files\n","    if p.lower().endswith((\".tif\", \".tiff\"))\n","]\n","\n","csv_paths = [\n","    p for p in all_files\n","    if p.lower().endswith((\".csv\", \".xlsx\", \".xls\"))\n","]\n","\n","print(\"\\nUploaded files:\")\n","for p in all_files:\n","    print(\" \", p)\n","\n","print(\"\\nNDWI rasters:\", len(tif_paths))\n","print(\"Depth datasets:\", len(csv_paths))\n","\n","\n","# ============================================================\n","# 5. EXTRACT YEAR + PERIOD FROM NDWI FILE NAME\n","# ============================================================\n","\n","PERIOD_ORDER = {\n","    \"JAN_APR\": 1,\n","    \"MAY_AUG\": 2,\n","    \"SEP_DEC\": 3\n","}\n","\n","\n","def parse_ndwi_filename(path):\n","\n","    name = os.path.basename(path).upper()\n","\n","    year_match = re.search(r\"(20\\d{2})\", name)\n","\n","    if year_match is None:\n","        raise ValueError(\n","            f\"Could not determine year from: {path}\"\n","        )\n","\n","    year = int(year_match.group(1))\n","\n","    period = None\n","\n","    for p in PERIOD_ORDER:\n","        if p in name:\n","            period = p\n","            break\n","\n","    if period is None:\n","        raise ValueError(\n","            f\"Could not determine period from: {path}\"\n","        )\n","\n","    return year, period\n","\n","\n","# ============================================================\n","# 6. CORRECT CHRONOLOGICAL SORTING\n","# ============================================================\n","\n","raster_info = []\n","\n","for path in tif_paths:\n","\n","    year, period = parse_ndwi_filename(path)\n","\n","    raster_info.append({\n","        \"path\": path,\n","        \"year\": year,\n","        \"period\": period,\n","        \"period_number\": PERIOD_ORDER[period]\n","    })\n","\n","\n","raster_info = sorted(\n","    raster_info,\n","    key=lambda x: (\n","        x[\"year\"],\n","        x[\"period_number\"]\n","    )\n",")\n","\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"CORRECT CHRONOLOGICAL ORDER\")\n","print(\"=\" * 70)\n","\n","for i, item in enumerate(raster_info):\n","\n","    print(\n","        f\"{i:02d} | \"\n","        f\"{item['year']} | \"\n","        f\"{item['period']:7s} | \"\n","        f\"{os.path.basename(item['path'])}\"\n","    )\n","\n","\n","uploaded_paths = [\n","    item[\"path\"]\n","    for item in raster_info\n","]\n","\n","\n","# ============================================================\n","# 7. CHECK DUPLICATES / MISSING PERIODS\n","# ============================================================\n","\n","keys = [\n","    (x[\"year\"], x[\"period\"])\n","    for x in raster_info\n","]\n","\n","if len(keys) != len(set(keys)):\n","    raise ValueError(\n","        \"Duplicate year/period NDWI rasters detected.\"\n","    )\n","\n","\n","print(\"\\nTemporal raster count:\", len(raster_info))\n","\n","\n","# ============================================================\n","# 8. LOAD RASTER\n","# ============================================================\n","\n","def load_raster(path):\n","\n","    with rasterio.open(path) as src:\n","\n","        image = src.read(1).astype(np.float32)\n","\n","        valid = np.isfinite(image)\n","\n","        if src.nodata is not None:\n","            valid &= image != src.nodata\n","\n","        valid &= image > -1e30\n","\n","        image = np.where(\n","            valid,\n","            image,\n","            np.nan\n","        ).astype(np.float32)\n","\n","        profile = src.profile.copy()\n","\n","        transform = src.transform\n","\n","        crs = src.crs\n","\n","        height = src.height\n","\n","        width = src.width\n","\n","    return (\n","        image,\n","        valid.astype(np.float32),\n","        profile,\n","        transform,\n","        crs,\n","        height,\n","        width\n","    )\n","\n","\n","# ============================================================\n","# 9. CHECK RASTER GRID\n","# ============================================================\n","\n","def validate_rasters(paths):\n","\n","    reference = None\n","\n","    for path in paths:\n","\n","        (\n","            image,\n","            valid,\n","            profile,\n","            transform,\n","            crs,\n","            height,\n","            width\n","        ) = load_raster(path)\n","\n","        current = {\n","            \"height\": height,\n","            \"width\": width,\n","            \"transform\": transform,\n","            \"crs\": crs\n","        }\n","\n","        if reference is None:\n","\n","            reference = current\n","\n","            continue\n","\n","        if height != reference[\"height\"]:\n","            raise ValueError(\n","                f\"Height mismatch: {path}\"\n","            )\n","\n","        if width != reference[\"width\"]:\n","            raise ValueError(\n","                f\"Width mismatch: {path}\"\n","            )\n","\n","        if transform != reference[\"transform\"]:\n","\n","            raise ValueError(\n","                f\"Transform mismatch:\\n{path}\\n\\n\"\n","                \"All NDWI rasters must use the same pixel grid.\"\n","            )\n","\n","        if crs != reference[\"crs\"]:\n","\n","            raise ValueError(\n","                f\"CRS mismatch:\\n{path}\"\n","            )\n","\n","    return reference\n","\n","\n","REFERENCE = validate_rasters(uploaded_paths)\n","\n","CANVAS_H = REFERENCE[\"height\"]\n","CANVAS_W = REFERENCE[\"width\"]\n","\n","REFERENCE_CRS = REFERENCE[\"crs\"]\n","\n","REFERENCE_TRANSFORM = REFERENCE[\"transform\"]\n","\n","print(\"\\nRaster grid validation PASSED\")\n","\n","print(\"Height:\", CANVAS_H)\n","print(\"Width :\", CANVAS_W)\n","print(\"CRS   :\", REFERENCE_CRS)\n","\n","\n","# ============================================================\n","# 10. NORMALIZATION\n","# ============================================================\n","\n","def normalize_ndwi(image, valid_mask):\n","\n","    result = np.zeros_like(\n","        image,\n","        dtype=np.float32\n","    )\n","\n","    values = image[\n","        valid_mask > 0\n","    ]\n","\n","    if len(values) == 0:\n","        return result\n","\n","    low = np.percentile(\n","        values,\n","        LOWER_PERCENTILE\n","    )\n","\n","    high = np.percentile(\n","        values,\n","        UPPER_PERCENTILE\n","    )\n","\n","    if high <= low:\n","\n","        result[\n","            valid_mask > 0\n","        ] = 0\n","\n","        return result\n","\n","    clipped = np.clip(\n","        image,\n","        low,\n","        high\n","    )\n","\n","    result = (\n","        clipped - low\n","    ) / (\n","        high - low\n","    )\n","\n","    result[\n","        valid_mask <= 0\n","    ] = 0\n","\n","    return result.astype(\n","        np.float32\n","    )\n","\n","\n","# ============================================================\n","# 11. OTSU WATER LABEL\n","# ============================================================\n","\n","def otsu_ndwi(image, valid_mask):\n","\n","    result = np.zeros_like(\n","        image,\n","        dtype=np.float32\n","    )\n","\n","    values = image[\n","        valid_mask > 0\n","    ]\n","\n","    if len(values) < 2:\n","\n","        return result, np.nan\n","\n","    minimum = float(values.min())\n","\n","    maximum = float(values.max())\n","\n","    if maximum <= minimum:\n","\n","        return result, minimum\n","\n","    hist, edges = np.histogram(\n","        values,\n","        bins=1024,\n","        range=(minimum, maximum)\n","    )\n","\n","    hist = hist.astype(\n","        np.float64\n","    )\n","\n","    centers = (\n","        edges[:-1] +\n","        edges[1:]\n","    ) / 2\n","\n","    probability = (\n","        hist /\n","        max(hist.sum(), 1)\n","    )\n","\n","    omega = np.cumsum(\n","        probability\n","    )\n","\n","    mu = np.cumsum(\n","        probability *\n","        centers\n","    )\n","\n","    mu_total = mu[-1]\n","\n","    denominator = (\n","        omega *\n","        (1 - omega)\n","    )\n","\n","    between = np.zeros_like(\n","        denominator\n","    )\n","\n","    valid = denominator > 0\n","\n","    between[valid] = (\n","        (\n","            mu_total * omega[valid]\n","            -\n","            mu[valid]\n","        ) ** 2\n","    ) / denominator[valid]\n","\n","    best = np.argmax(\n","        between\n","    )\n","\n","    threshold = float(\n","        centers[best]\n","    )\n","\n","    result[\n","        valid_mask > 0\n","    ] = (\n","        image[\n","            valid_mask > 0\n","        ] >= threshold\n","    ).astype(np.float32)\n","\n","    return result, threshold\n","\n","\n","# ============================================================\n","# 12. LOAD NDWI TEMPORAL DATA\n","# ============================================================\n","\n","records = []\n","\n","for item in raster_info:\n","\n","    path = item[\"path\"]\n","\n","    (\n","        image,\n","        valid,\n","        profile,\n","        transform,\n","        crs,\n","        height,\n","        width\n","    ) = load_raster(path)\n","\n","    normalized = normalize_ndwi(\n","        image,\n","        valid\n","    )\n","\n","    label, otsu_threshold = otsu_ndwi(\n","        image,\n","        valid\n","    )\n","\n","    records.append({\n","\n","        \"path\": path,\n","\n","        \"year\": item[\"year\"],\n","\n","        \"period\": item[\"period\"],\n","\n","        \"period_number\": item[\"period_number\"],\n","\n","        \"image\": image,\n","\n","        \"normalized\": normalized,\n","\n","        \"valid\": valid,\n","\n","        \"label\": label,\n","\n","        \"otsu\": otsu_threshold\n","    })\n","\n","    print(\n","        f\"{item['year']} \"\n","        f\"{item['period']:7s} | \"\n","        f\"Otsu = {otsu_threshold:.5f}\"\n","    )\n","\n","\n","# ============================================================\n","# 13. LOAD DEPTH CSV DATA\n","# ============================================================\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"LOADING DEPTH DATASETS\")\n","print(\"=\" * 70)\n","\n","\n","depth_tables = {}\n","\n","\n","def extract_year_from_depth_file(path):\n","\n","    name = os.path.basename(path)\n","\n","    match = re.search(\n","        r\"(20\\d{2})\",\n","        name\n","    )\n","\n","    if match is None:\n","        raise ValueError(\n","            f\"Cannot determine year from depth file: {path}\"\n","        )\n","\n","    return int(\n","        match.group(1)\n","    )\n","\n","\n","for path in csv_paths:\n","\n","    year = extract_year_from_depth_file(\n","        path\n","    )\n","\n","    if path.lower().endswith(\".csv\"):\n","\n","        df = pd.read_csv(path)\n","\n","    else:\n","\n","        df = pd.read_excel(path)\n","\n","    depth_tables[year] = df\n","\n","    print(\n","        f\"\\n{os.path.basename(path)}\"\n","    )\n","\n","    print(\n","        \"Rows:\",\n","        len(df)\n","    )\n","\n","    print(\n","        \"Columns:\",\n","        list(df.columns)\n","    )\n","\n","\n","# ============================================================\n","# 14. AUTOMATICALLY FIND DEPTH / POSITION COLUMNS\n","# ============================================================\n","\n","def find_column(\n","    columns,\n","    keywords\n","):\n","\n","    lower = {\n","        str(c).lower(): c\n","        for c in columns\n","    }\n","\n","    # Exact first\n","    for keyword in keywords:\n","\n","        if keyword.lower() in lower:\n","\n","            return lower[\n","                keyword.lower()\n","            ]\n","\n","    # Partial\n","    for c in columns:\n","\n","        c_lower = str(c).lower()\n","\n","        for keyword in keywords:\n","\n","            if keyword.lower() in c_lower:\n","\n","                return c\n","\n","    return None\n","\n","\n","def inspect_depth_columns(df):\n","\n","    x_col = find_column(\n","        df.columns,\n","        [\n","            \"x\",\n","            \"pixel_x\",\n","            \"col\",\n","            \"column\",\n","            \"longitude\",\n","            \"lon\"\n","        ]\n","    )\n","\n","    y_col = find_column(\n","        df.columns,\n","        [\n","            \"y\",\n","            \"pixel_y\",\n","            \"row\",\n","            \"latitude\",\n","            \"lat\"\n","        ]\n","    )\n","\n","    depth_col = find_column(\n","        df.columns,\n","        [\n","            \"depth\",\n","            \"water_depth\",\n","            \"depth_m\",\n","            \"waterdepth\"\n","        ]\n","    )\n","\n","    print(\"\\nDetected columns:\")\n","\n","    print(\"X:\", x_col)\n","    print(\"Y:\", y_col)\n","    print(\"Depth:\", depth_col)\n","\n","    return x_col, y_col, depth_col\n","\n","\n","# ============================================================\n","# 15. CONVERT DEPTH CSV INTO RASTER\n","# ============================================================\n","\n","def create_depth_map(\n","    df,\n","    reference_profile,\n","    reference_transform,\n","    reference_crs,\n","    height,\n","    width\n","):\n","\n","    x_col, y_col, depth_col = (\n","        inspect_depth_columns(df)\n","    )\n","\n","    if depth_col is None:\n","\n","        print(\n","            \"\\nWARNING:\"\n","            \"No depth column detected.\"\n","        )\n","\n","        return np.zeros(\n","            (height, width),\n","            dtype=np.float32\n","        )\n","\n","    if x_col is None or y_col is None:\n","\n","        print(\n","            \"\\nWARNING:\"\n","            \"No spatial X/Y columns detected.\"\n","        )\n","\n","        print(\n","            \"Depth cannot be spatially mapped automatically.\"\n","        )\n","\n","        print(\n","            \"Using zero depth map.\"\n","        )\n","\n","        return np.zeros(\n","            (height, width),\n","            dtype=np.float32\n","        )\n","\n","    temp = df[\n","        [x_col, y_col, depth_col]\n","    ].copy()\n","\n","    temp = temp.replace(\n","        [np.inf, -np.inf],\n","        np.nan\n","    )\n","\n","    temp = temp.dropna()\n","\n","    if len(temp) == 0:\n","\n","        return np.zeros(\n","            (height, width),\n","            dtype=np.float32\n","        )\n","\n","    depth_map = np.zeros(\n","        (height, width),\n","        dtype=np.float32\n","    )\n","\n","    # --------------------------------------------------------\n","    # DETERMINE WHETHER X/Y ARE PIXEL COORDINATES\n","    # --------------------------------------------------------\n","\n","    x_values = temp[x_col].values\n","    y_values = temp[y_col].values\n","\n","    looks_like_pixels = (\n","        x_values.min() >= 0\n","        and\n","        x_values.max() < width\n","        and\n","        y_values.min() >= 0\n","        and\n","        y_values.max() < height\n","    )\n","\n","    if looks_like_pixels:\n","\n","        print(\n","            \"Depth coordinates interpreted as pixel row/column.\"\n","        )\n","\n","        for _, row in temp.iterrows():\n","\n","            x = int(\n","                round(row[x_col])\n","            )\n","\n","            y = int(\n","                round(row[y_col])\n","            )\n","\n","            if (\n","                0 <= x < width\n","                and\n","                0 <= y < height\n","            ):\n","\n","                depth_map[\n","                    y,\n","                    x\n","                ] = float(\n","                    row[depth_col]\n","                )\n","\n","    else:\n","\n","        print(\n","            \"Depth coordinates interpreted as map coordinates.\"\n","        )\n","\n","        for _, row in temp.iterrows():\n","\n","            try:\n","\n","                col, row_idx = rowcol(\n","                    reference_transform,\n","                    float(row[x_col]),\n","                    float(row[y_col])\n","                )\n","\n","                if (\n","                    0 <= row_idx < height\n","                    and\n","                    0 <= col < width\n","                ):\n","\n","                    depth_map[\n","                        row_idx,\n","                        col\n","                    ] = float(\n","                        row[depth_col]\n","                    )\n","\n","            except Exception:\n","                pass\n","\n","    # --------------------------------------------------------\n","    # FILL / NORMALIZE DEPTH\n","    # --------------------------------------------------------\n","\n","    valid_depth = np.isfinite(\n","        depth_map\n","    )\n","\n","    values = depth_map[\n","        valid_depth &\n","        (depth_map != 0)\n","    ]\n","\n","    if len(values) > 0:\n","\n","        low = np.percentile(\n","            values,\n","            2\n","        )\n","\n","        high = np.percentile(\n","            values,\n","            98\n","        )\n","\n","        if high > low:\n","\n","            depth_map = np.clip(\n","                depth_map,\n","                low,\n","                high\n","            )\n","\n","            depth_map = (\n","                depth_map - low\n","            ) / (\n","                high - low\n","            )\n","\n","    return depth_map.astype(\n","        np.float32\n","    )\n","\n","\n","# ============================================================\n","# 16. CREATE DEPTH MAP FOR EACH YEAR\n","# ============================================================\n","\n","depth_maps = {}\n","\n","for year, df in depth_tables.items():\n","\n","    print(\"\\nCreating depth map:\", year)\n","\n","    depth_maps[year] = create_depth_map(\n","        df,\n","        None,\n","        REFERENCE_TRANSFORM,\n","        REFERENCE_CRS,\n","        CANVAS_H,\n","        CANVAS_W\n","    )\n","\n","    print(\n","        \"Depth map:\",\n","        depth_maps[year].shape\n","    )\n","\n","\n","# ============================================================\n","# 17. MATCH DEPTH TO EACH NDWI PERIOD\n","# ============================================================\n","\n","for record in records:\n","\n","    year = record[\"year\"]\n","\n","    if year in depth_maps:\n","\n","        record[\"depth\"] = depth_maps[\n","            year\n","        ]\n","\n","        record[\"depth_available\"] = True\n","\n","    else:\n","\n","        record[\"depth\"] = np.zeros(\n","            (CANVAS_H, CANVAS_W),\n","            dtype=np.float32\n","        )\n","\n","        record[\"depth_available\"] = False\n","\n","        print(\n","            f\"WARNING: no depth dataset for {year}\"\n","        )\n","\n","\n","print(\"\\nTemporal matching:\")\n","\n","for r in records:\n","\n","    print(\n","        f\"{r['year']} \"\n","        f\"{r['period']:7s} -> \"\n","        f\"depth={r['depth_available']}\"\n","    )\n","\n","\n","# ============================================================\n","# 18. BUILD TEMPORAL SEQUENCES\n","# ============================================================\n","\n","def build_sequences(records):\n","\n","    sequences = []\n","\n","    for target_idx in range(\n","        INPUT_TIMESTEPS,\n","        len(records)\n","    ):\n","\n","        input_indices = list(\n","            range(\n","                target_idx - INPUT_TIMESTEPS,\n","                target_idx\n","            )\n","        )\n","\n","        sequences.append({\n","\n","            \"inputs\": input_indices,\n","\n","            \"target\": target_idx\n","        })\n","\n","    return sequences\n","\n","\n","sequences = build_sequences(\n","    records\n",")\n","\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"FORECAST SEQUENCES\")\n","print(\"=\" * 70)\n","\n","for i, seq in enumerate(sequences):\n","\n","    inputs_text = []\n","\n","    for idx in seq[\"inputs\"]:\n","\n","        r = records[idx]\n","\n","        inputs_text.append(\n","            f\"{r['year']}-{r['period']}\"\n","        )\n","\n","    target = records[\n","        seq[\"target\"]\n","    ]\n","\n","    print(\n","        f\"{i}: \"\n","        f\"{inputs_text}\"\n","        f\" -> \"\n","        f\"{target['year']}-{target['period']}\"\n","    )\n","\n","\n","# ============================================================\n","# 19. CNN INPUT CONSTRUCTION\n","# ============================================================\n","#\n","# INPUT_TIMESTEPS = 2\n","#\n","# Input shape:\n","#\n","# 64 x 64 x 4\n","#\n","# Channel:\n","#\n","# 0 = NDWI t-2\n","# 1 = Depth t-2\n","# 2 = NDWI t-1\n","# 3 = Depth t-1\n","#\n","# ============================================================\n","\n","CNN_CHANNELS = (\n","    INPUT_TIMESTEPS * 2\n",")\n","\n","\n","def create_sequence_input(\n","    sequence,\n","    records\n","):\n","\n","    channels = []\n","\n","    for idx in sequence[\"inputs\"]:\n","\n","        record = records[idx]\n","\n","        channels.append(\n","            record[\"normalized\"]\n","        )\n","\n","        channels.append(\n","            record[\"depth\"]\n","        )\n","\n","    return np.stack(\n","        channels,\n","        axis=-1\n","    ).astype(\n","        np.float32\n","    )\n","\n","\n","# ============================================================\n","# 20. PATCH LOCATIONS\n","# ============================================================\n","\n","def patch_positions(\n","    height,\n","    width,\n","    patch_size,\n","    stride\n","):\n","\n","    ys = list(\n","        range(\n","            0,\n","            max(\n","                height - patch_size,\n","                0\n","            ) + 1,\n","            stride\n","        )\n","    )\n","\n","    xs = list(\n","        range(\n","            0,\n","            max(\n","                width - patch_size,\n","                0\n","            ) + 1,\n","            stride\n","        )\n","    )\n","\n","    if height > patch_size:\n","\n","        last_y = (\n","            height -\n","            patch_size\n","        )\n","\n","        if last_y not in ys:\n","            ys.append(last_y)\n","\n","    if width > patch_size:\n","\n","        last_x = (\n","            width -\n","            patch_size\n","        )\n","\n","        if last_x not in xs:\n","            xs.append(last_x)\n","\n","    if height <= patch_size:\n","        ys = [0]\n","\n","    if width <= patch_size:\n","        xs = [0]\n","\n","    return ys, xs\n","\n","\n","# ============================================================\n","# 21. PATCH EXTRACTION\n","# ============================================================\n","\n","def extract_sequence_patches(\n","    sequence,\n","    records\n","):\n","\n","    stack = create_sequence_input(\n","        sequence,\n","        records\n","    )\n","\n","    target_record = records[\n","        sequence[\"target\"]\n","    ]\n","\n","    target = target_record[\n","        \"label\"\n","    ]\n","\n","    valid = target_record[\n","        \"valid\"\n","    ]\n","\n","    X = []\n","\n","    Y = []\n","\n","    ys, xs = patch_positions(\n","        CANVAS_H,\n","        CANVAS_W,\n","        PATCH_SIZE,\n","        STRIDE\n","    )\n","\n","    for y in ys:\n","\n","        for x in xs:\n","\n","            x_patch = stack[\n","                y:y + PATCH_SIZE,\n","                x:x + PATCH_SIZE,\n","                :\n","            ]\n","\n","            y_patch = target[\n","                y:y + PATCH_SIZE,\n","                x:x + PATCH_SIZE\n","            ]\n","\n","            valid_patch = valid[\n","                y:y + PATCH_SIZE,\n","                x:x + PATCH_SIZE\n","            ]\n","\n","            if valid_patch.size == 0:\n","                continue\n","\n","            if valid_patch.mean() < MIN_VALID_FRAC:\n","                continue\n","\n","            ph, pw = y_patch.shape\n","\n","            padded_x = np.zeros(\n","                (\n","                    PATCH_SIZE,\n","                    PATCH_SIZE,\n","                    CNN_CHANNELS\n","                ),\n","                dtype=np.float32\n","            )\n","\n","            padded_y = np.zeros(\n","                (\n","                    PATCH_SIZE,\n","                    PATCH_SIZE,\n","                    2\n","                ),\n","                dtype=np.float32\n","            )\n","\n","            padded_x[\n","                :ph,\n","                :pw,\n","                :\n","            ] = x_patch\n","\n","            padded_y[\n","                :ph,\n","                :pw,\n","                0\n","            ] = y_patch\n","\n","            padded_y[\n","                :ph,\n","                :pw,\n","                1\n","            ] = valid_patch\n","\n","            X.append(\n","                padded_x\n","            )\n","\n","            Y.append(\n","                padded_y\n","            )\n","\n","    return (\n","        np.asarray(X, dtype=np.float32),\n","        np.asarray(Y, dtype=np.float32)\n","    )\n","\n","\n","# ============================================================\n","# 22. TEMPORAL TRAIN / VALIDATION SPLIT\n","# ============================================================\n","\n","if len(sequences) <= VALIDATION_SEQUENCES:\n","\n","    raise ValueError(\n","        \"Not enough temporal sequences for the requested \"\n","        \"validation split.\"\n","    )\n","\n","train_sequences = sequences[\n","    :-VALIDATION_SEQUENCES\n","]\n","\n","val_sequences = sequences[\n","    -VALIDATION_SEQUENCES:\n","]\n","\n","\n","print(\n","    \"\\nTraining sequences:\",\n","    len(train_sequences)\n",")\n","\n","print(\n","    \"Validation sequences:\",\n","    len(val_sequences)\n",")\n","\n","\n","# ============================================================\n","# 23. BUILD DATASETS\n","# ============================================================\n","\n","def build_dataset(\n","    sequence_list\n","):\n","\n","    X_list = []\n","\n","    Y_list = []\n","\n","    for sequence in sequence_list:\n","\n","        X, Y = extract_sequence_patches(\n","            sequence,\n","            records\n","        )\n","\n","        if len(X) == 0:\n","            continue\n","\n","        X_list.append(X)\n","\n","        Y_list.append(Y)\n","\n","    if not X_list:\n","\n","        return (\n","            np.empty(\n","                (\n","                    0,\n","                    PATCH_SIZE,\n","                    PATCH_SIZE,\n","                    CNN_CHANNELS\n","                ),\n","                dtype=np.float32\n","            ),\n","            np.empty(\n","                (\n","                    0,\n","                    PATCH_SIZE,\n","                    PATCH_SIZE,\n","                    2\n","                ),\n","                dtype=np.float32\n","            )\n","        )\n","\n","    return (\n","        np.concatenate(\n","            X_list,\n","            axis=0\n","        ),\n","        np.concatenate(\n","            Y_list,\n","            axis=0\n","        )\n","    )\n","\n","\n","X_train, Y_train = build_dataset(\n","    train_sequences\n",")\n","\n","X_val, Y_val = build_dataset(\n","    val_sequences\n",")\n","\n","\n","print(\"\\nTraining:\")\n","print(\n","    \"X_train:\",\n","    X_train.shape\n",")\n","\n","print(\n","    \"Y_train:\",\n","    Y_train.shape\n",")\n","\n","print(\"\\nValidation:\")\n","print(\n","    \"X_val:\",\n","    X_val.shape\n",")\n","\n","print(\n","    \"Y_val:\",\n","    Y_val.shape\n",")\n","\n","\n","if len(X_train) == 0:\n","\n","    raise ValueError(\n","        \"No training patches generated.\"\n","    )\n","\n","if len(X_val) == 0:\n","\n","    raise ValueError(\n","        \"No validation patches generated.\"\n","    )\n","\n","\n","# ============================================================\n","# 24. DATA AUGMENTATION\n","# ============================================================\n","\n","def augment_pair(\n","    x,\n","    y\n","):\n","\n","    if np.random.rand() < 0.5:\n","\n","        x = np.fliplr(x)\n","        y = np.fliplr(y)\n","\n","    if np.random.rand() < 0.5:\n","\n","        x = np.flipud(x)\n","        y = np.flipud(y)\n","\n","    k = np.random.randint(\n","        0,\n","        4\n","    )\n","\n","    x = np.rot90(\n","        x,\n","        k,\n","        axes=(0, 1)\n","    )\n","\n","    y = np.rot90(\n","        y,\n","        k,\n","        axes=(0, 1)\n","    )\n","\n","    return (\n","        x.copy(),\n","        y.copy()\n","    )\n","\n","\n","augmented = [\n","    augment_pair(x, y)\n","    for x, y in zip(\n","        X_train,\n","        Y_train\n","    )\n","]\n","\n","\n","aug_X = np.asarray(\n","    [\n","        a[0]\n","        for a in augmented\n","    ],\n","    dtype=np.float32\n",")\n","\n","aug_Y = np.asarray(\n","    [\n","        a[1]\n","        for a in augmented\n","    ],\n","    dtype=np.float32\n",")\n","\n","\n","X_train = np.concatenate(\n","    [\n","        X_train,\n","        aug_X\n","    ],\n","    axis=0\n",")\n","\n","Y_train = np.concatenate(\n","    [\n","        Y_train,\n","        aug_Y\n","    ],\n","    axis=0\n",")\n","\n","\n","print(\n","    \"\\nTraining patches after augmentation:\",\n","    len(X_train)\n",")\n","\n","\n","# ============================================================\n","# 25. U-NET CONVOLUTION BLOCK\n","# ============================================================\n","\n","def conv_block(\n","    x,\n","    filters,\n","    dropout\n","):\n","\n","    x = layers.Conv2D(\n","        filters,\n","        3,\n","        padding=\"same\",\n","        use_bias=False\n","    )(x)\n","\n","    x = layers.BatchNormalization()(x)\n","\n","    x = layers.Activation(\n","        \"relu\"\n","    )(x)\n","\n","    x = layers.Conv2D(\n","        filters,\n","        3,\n","        padding=\"same\",\n","        use_bias=False\n","    )(x)\n","\n","    x = layers.BatchNormalization()(x)\n","\n","    x = layers.Activation(\n","        \"relu\"\n","    )(x)\n","\n","    if dropout > 0:\n","\n","        x = layers.Dropout(\n","            dropout\n","        )(x)\n","\n","    return x\n","\n","\n","# ============================================================\n","# 26. U-NET\n","# ============================================================\n","\n","def build_unet():\n","\n","    inputs = layers.Input(\n","        shape=(\n","            PATCH_SIZE,\n","            PATCH_SIZE,\n","            CNN_CHANNELS\n","        ),\n","        name=\"NDWI_DEPTH_INPUT\"\n","    )\n","\n","    # --------------------------------------------------------\n","    # ENCODER\n","    # --------------------------------------------------------\n","\n","    c1 = conv_block(\n","        inputs,\n","        32,\n","        0.05\n","    )\n","\n","    p1 = layers.MaxPooling2D(\n","        name=\"POOL_1\"\n","    )(c1)\n","\n","\n","    c2 = conv_block(\n","        p1,\n","        64,\n","        0.10\n","    )\n","\n","    p2 = layers.MaxPooling2D(\n","        name=\"POOL_2\"\n","    )(c2)\n","\n","\n","    c3 = conv_block(\n","        p2,\n","        128,\n","        0.15\n","    )\n","\n","    p3 = layers.MaxPooling2D(\n","        name=\"POOL_3\"\n","    )(c3)\n","\n","\n","    # --------------------------------------------------------\n","    # BOTTLENECK\n","    # --------------------------------------------------------\n","\n","    bottleneck = conv_block(\n","        p3,\n","        256,\n","        0.20\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # DECODER\n","    # --------------------------------------------------------\n","\n","    u3 = layers.Conv2DTranspose(\n","        128,\n","        2,\n","        strides=2,\n","        padding=\"same\",\n","        name=\"UPSAMPLE_3\"\n","    )(bottleneck)\n","\n","    u3 = layers.Concatenate(\n","        name=\"SKIP_3\"\n","    )([\n","        u3,\n","        c3\n","    ])\n","\n","    c4 = conv_block(\n","        u3,\n","        128,\n","        0.15\n","    )\n","\n","\n","    u2 = layers.Conv2DTranspose(\n","        64,\n","        2,\n","        strides=2,\n","        padding=\"same\",\n","        name=\"UPSAMPLE_2\"\n","    )(c4)\n","\n","    u2 = layers.Concatenate(\n","        name=\"SKIP_2\"\n","    )([\n","        u2,\n","        c2\n","    ])\n","\n","    c5 = conv_block(\n","        u2,\n","        64,\n","        0.10\n","    )\n","\n","\n","    u1 = layers.Conv2DTranspose(\n","        32,\n","        2,\n","        strides=2,\n","        padding=\"same\",\n","        name=\"UPSAMPLE_1\"\n","    )(c5)\n","\n","    u1 = layers.Concatenate(\n","        name=\"SKIP_1\"\n","    )([\n","        u1,\n","        c1\n","    ])\n","\n","    c6 = conv_block(\n","        u1,\n","        32,\n","        0.05\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # OUTPUT\n","    # --------------------------------------------------------\n","\n","    output = layers.Conv2D(\n","        1,\n","        1,\n","        activation=\"sigmoid\",\n","        name=\"WATER_PROBABILITY\"\n","    )(c6)\n","\n","\n","    return models.Model(\n","        inputs,\n","        output,\n","        name=\"NDWI_Depth_MultiTemporal_UNet\"\n","    )\n","\n","\n","model = build_unet()\n","\n","\n","# ============================================================\n","# 27. MASKED BCE + DICE LOSS\n","# ============================================================\n","\n","def masked_bce_dice_loss(\n","    y_true,\n","    y_pred\n","):\n","\n","    label = y_true[..., 0]\n","\n","    mask = y_true[..., 1]\n","\n","    pred = y_pred[..., 0]\n","\n","    pred = tf.clip_by_value(\n","        pred,\n","        1e-7,\n","        1 - 1e-7\n","    )\n","\n","    bce = -(\n","        label *\n","        tf.math.log(pred)\n","        +\n","        (1 - label) *\n","        tf.math.log(1 - pred)\n","    )\n","\n","    bce = tf.reduce_sum(\n","        bce * mask\n","    ) / (\n","        tf.reduce_sum(mask)\n","        +\n","        1e-6\n","    )\n","\n","    intersection = tf.reduce_sum(\n","        label *\n","        pred *\n","        mask\n","    )\n","\n","    denominator = (\n","        tf.reduce_sum(\n","            label * mask\n","        )\n","        +\n","        tf.reduce_sum(\n","            pred * mask\n","        )\n","    )\n","\n","    dice = (\n","        2 * intersection +\n","        1e-6\n","    ) / (\n","        denominator +\n","        1e-6\n","    )\n","\n","    return bce + (\n","        1 - dice\n","    )\n","\n","\n","# ============================================================\n","# 28. METRICS\n","# ============================================================\n","\n","def masked_iou(\n","    y_true,\n","    y_pred\n","):\n","\n","    label = y_true[..., 0]\n","\n","    mask = y_true[..., 1]\n","\n","    pred = y_pred[..., 0]\n","\n","    pred_binary = tf.cast(\n","        pred >= 0.5,\n","        tf.float32\n","    )\n","\n","    intersection = tf.reduce_sum(\n","        label *\n","        pred_binary *\n","        mask\n","    )\n","\n","    union = tf.reduce_sum(\n","        tf.maximum(\n","            label,\n","            pred_binary\n","        ) *\n","        mask\n","    )\n","\n","    return (\n","        intersection + 1e-6\n","    ) / (\n","        union + 1e-6\n","    )\n","\n","\n","def masked_dice(\n","    y_true,\n","    y_pred\n","):\n","\n","    label = y_true[..., 0]\n","\n","    mask = y_true[..., 1]\n","\n","    pred = y_pred[..., 0]\n","\n","    intersection = tf.reduce_sum(\n","        label *\n","        pred *\n","        mask\n","    )\n","\n","    denominator = (\n","        tf.reduce_sum(\n","            label * mask\n","        )\n","        +\n","        tf.reduce_sum(\n","            pred * mask\n","        )\n","    )\n","\n","    return (\n","        2 * intersection +\n","        1e-6\n","    ) / (\n","        denominator +\n","        1e-6\n","    )\n","\n","\n","# ============================================================\n","# 29. COMPILE\n","# ============================================================\n","\n","model.compile(\n","\n","    optimizer=tf.keras.optimizers.Adam(\n","        learning_rate=LEARNING_RATE\n","    ),\n","\n","    loss=masked_bce_dice_loss,\n","\n","    metrics=[\n","        masked_iou,\n","        masked_dice\n","    ]\n",")\n","\n","\n","model.summary()\n","\n","\n","# ============================================================\n","# 30. CALLBACKS\n","# ============================================================\n","\n","training_callbacks = [\n","\n","    callbacks.ModelCheckpoint(\n","        \"best_ndwi_depth_unet.keras\",\n","        monitor=\"val_masked_iou\",\n","        mode=\"max\",\n","        save_best_only=True\n","    ),\n","\n","    callbacks.EarlyStopping(\n","        monitor=\"val_masked_iou\",\n","        mode=\"max\",\n","        patience=8,\n","        restore_best_weights=True\n","    ),\n","\n","    callbacks.ReduceLROnPlateau(\n","        monitor=\"val_loss\",\n","        factor=0.5,\n","        patience=4,\n","        min_lr=1e-7\n","    )\n","]\n","\n","\n","# ============================================================\n","# 31. TRAIN\n","# ============================================================\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"TRAINING CNN\")\n","print(\"=\" * 70)\n","\n","\n","history = model.fit(\n","\n","    X_train,\n","    Y_train,\n","\n","    validation_data=(\n","        X_val,\n","        Y_val\n","    ),\n","\n","    batch_size=BATCH_SIZE,\n","\n","    epochs=EPOCHS,\n","\n","    callbacks=training_callbacks,\n","\n","    shuffle=True,\n","\n","    verbose=1\n",")\n","\n","\n","# ============================================================\n","# 32. TRAINING CURVES\n","# ============================================================\n","\n","plt.figure(\n","    figsize=(10, 5)\n",")\n","\n","plt.plot(\n","    history.history[\"loss\"],\n","    label=\"Training Loss\"\n",")\n","\n","plt.plot(\n","    history.history[\"val_loss\"],\n","    label=\"Validation Loss\"\n",")\n","\n","plt.xlabel(\"Epoch\")\n","\n","plt.ylabel(\"Loss\")\n","\n","plt.title(\n","    \"NDWI + Depth CNN Training\"\n",")\n","\n","plt.legend()\n","\n","plt.grid(True)\n","\n","plt.show()\n","\n","\n","plt.figure(\n","    figsize=(10, 5)\n",")\n","\n","plt.plot(\n","    history.history[\"masked_iou\"],\n","    label=\"Training IoU\"\n",")\n","\n","plt.plot(\n","    history.history[\"val_masked_iou\"],\n","    label=\"Validation IoU\"\n",")\n","\n","plt.xlabel(\"Epoch\")\n","\n","plt.ylabel(\"IoU\")\n","\n","plt.title(\n","    \"Water Segmentation IoU\"\n",")\n","\n","plt.legend()\n","\n","plt.grid(True)\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 33. FULL RASTER PREDICTION\n","# ============================================================\n","\n","def predict_sequence(\n","    model,\n","    sequence\n","):\n","\n","    stack = create_sequence_input(\n","        sequence,\n","        records\n","    )\n","\n","    probability = np.zeros(\n","        (\n","            CANVAS_H,\n","            CANVAS_W\n","        ),\n","        dtype=np.float32\n","    )\n","\n","    count = np.zeros(\n","        (\n","            CANVAS_H,\n","            CANVAS_W\n","        ),\n","        dtype=np.float32\n","    )\n","\n","    ys, xs = patch_positions(\n","        CANVAS_H,\n","        CANVAS_W,\n","        PATCH_SIZE,\n","        PATCH_SIZE // 2\n","    )\n","\n","    for y in ys:\n","\n","        for x in xs:\n","\n","            patch = stack[\n","                y:y + PATCH_SIZE,\n","                x:x + PATCH_SIZE,\n","                :\n","            ]\n","\n","            ph, pw = patch.shape[:2]\n","\n","            padded = np.zeros(\n","                (\n","                    1,\n","                    PATCH_SIZE,\n","                    PATCH_SIZE,\n","                    CNN_CHANNELS\n","                ),\n","                dtype=np.float32\n","            )\n","\n","            padded[\n","                0,\n","                :ph,\n","                :pw,\n","                :\n","            ] = patch\n","\n","            prediction = model.predict(\n","                padded,\n","                verbose=0\n","            )[0, :ph, :pw, 0]\n","\n","            probability[\n","                y:y + ph,\n","                x:x + pw\n","            ] += prediction\n","\n","            count[\n","                y:y + ph,\n","                x:x + pw\n","            ] += 1\n","\n","    probability /= np.maximum(\n","        count,\n","        1\n","    )\n","\n","    binary = (\n","        probability >=\n","        PREDICTION_THRESHOLD\n","    ).astype(\n","        np.uint8\n","    )\n","\n","    return (\n","        probability,\n","        binary\n","    )\n","\n","\n","# ============================================================\n","# 34. PREDICT NEXT PERIOD\n","# ============================================================\n","\n","latest_sequence = sequences[-1]\n","\n","probability_map, water_mask = predict_sequence(\n","    model,\n","    latest_sequence\n",")\n","\n","\n","target_record = records[\n","    latest_sequence[\"target\"]\n","]\n","\n","\n","print(\"\\n\" + \"=\" * 70)\n","\n","print(\n","    \"PREDICTION TARGET:\",\n","    target_record[\"year\"],\n","    target_record[\"period\"]\n",")\n","\n","print(\"=\" * 70)\n","\n","\n","# ============================================================\n","# 35. DISPLAY PREDICTION\n","# ============================================================\n","\n","last_input = records[\n","    latest_sequence[\"inputs\"][-1]\n","]\n","\n","\n","plt.figure(\n","    figsize=(16, 5)\n",")\n","\n","\n","plt.subplot(\n","    1,\n","    3,\n","    1\n",")\n","\n","plt.imshow(\n","    last_input[\"normalized\"],\n","    cmap=\"viridis\",\n","    vmin=0,\n","    vmax=1\n",")\n","\n","plt.title(\n","    f\"Latest NDWI\\n\"\n","    f\"{last_input['year']} \"\n","    f\"{last_input['period']}\"\n",")\n","\n","plt.colorbar()\n","\n","\n","plt.subplot(\n","    1,\n","    3,\n","    2\n",")\n","\n","plt.imshow(\n","    probability_map,\n","    cmap=\"Blues\",\n","    vmin=0,\n","    vmax=1\n",")\n","\n","plt.title(\n","    f\"Forecast Water Probability\\n\"\n","    f\"{target_record['year']} \"\n","    f\"{target_record['period']}\"\n",")\n","\n","plt.colorbar()\n","\n","\n","plt.subplot(\n","    1,\n","    3,\n","    3\n",")\n","\n","plt.imshow(\n","    water_mask,\n","    cmap=\"gray\",\n","    vmin=0,\n","    vmax=1\n",")\n","\n","plt.title(\n","    \"Forecast Water Mask\"\n",")\n","\n","plt.colorbar()\n","\n","\n","plt.tight_layout()\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 36. WATER AREA CALCULATION\n","# ============================================================\n","\n","def calculate_water_area_km2(\n","    mask,\n","    transform,\n","    crs\n","):\n","\n","    if crs is None:\n","\n","        print(\n","            \"CRS missing.\"\n","        )\n","\n","        return np.nan\n","\n","\n","    # --------------------------------------------------------\n","    # PROJECTED CRS\n","    # --------------------------------------------------------\n","\n","    if not crs.is_geographic:\n","\n","        pixel_width = abs(\n","            transform.a\n","        )\n","\n","        pixel_height = abs(\n","            transform.e\n","        )\n","\n","        pixel_area = (\n","            pixel_width *\n","            pixel_height\n","        )\n","\n","        water_pixels = np.sum(\n","            mask == 1\n","        )\n","\n","        area_m2 = (\n","            water_pixels *\n","            pixel_area\n","        )\n","\n","        return (\n","            area_m2 /\n","            1e6\n","        )\n","\n","\n","    # --------------------------------------------------------\n","    # GEOGRAPHIC CRS\n","    # --------------------------------------------------------\n","    # Automatically reproject binary mask to UTM.\n","    # This fixes the \"CRS is geographic (degrees)\" problem.\n","    # --------------------------------------------------------\n","\n","    print(\n","        \"Geographic CRS detected.\"\n","    )\n","\n","    print(\n","        \"Automatically projecting mask to a metre-based UTM CRS...\"\n","    )\n","\n","\n","    bounds = rasterio.transform.array_bounds(\n","        CANVAS_H,\n","        CANVAS_W,\n","        transform\n","    )\n","\n","    left, bottom, right, top = bounds\n","\n","\n","    center_lon = (\n","        left + right\n","    ) / 2\n","\n","    center_lat = (\n","        bottom + top\n","    ) / 2\n","\n","\n","    zone = int(\n","        (\n","            center_lon +\n","            180\n","        ) / 6\n","    ) + 1\n","\n","\n","    if center_lat >= 0:\n","\n","        epsg = 32600 + zone\n","\n","    else:\n","\n","        epsg = 32700 + zone\n","\n","\n","    dst_crs = f\"EPSG:{epsg}\"\n","\n","\n","    dst_transform, dst_width, dst_height = (\n","        calculate_default_transform(\n","            crs,\n","            dst_crs,\n","            CANVAS_W,\n","            CANVAS_H,\n","            left=left,\n","            bottom=bottom,\n","            right=right,\n","            top=top\n","        )\n","    )\n","\n","\n","    dst_mask = np.zeros(\n","        (\n","            dst_height,\n","            dst_width\n","        ),\n","        dtype=np.uint8\n","    )\n","\n","\n","    reproject(\n","        source=mask.astype(\n","            np.uint8\n","        ),\n","\n","        destination=dst_mask,\n","\n","        src_transform=transform,\n","\n","        src_crs=crs,\n","\n","        dst_transform=dst_transform,\n","\n","        dst_crs=dst_crs,\n","\n","        resampling=Resampling.nearest\n","    )\n","\n","\n","    pixel_area = (\n","        abs(dst_transform.a) *\n","        abs(dst_transform.e)\n","    )\n","\n","\n","    water_pixels = np.sum(\n","        dst_mask == 1\n","    )\n","\n","\n","    area_m2 = (\n","        water_pixels *\n","        pixel_area\n","    )\n","\n","\n","    area_km2 = (\n","        area_m2 /\n","        1e6\n","    )\n","\n","\n","    print(\n","        \"Area CRS:\",\n","        dst_crs\n","    )\n","\n","    return area_km2\n","\n","\n","water_area_km2 = calculate_water_area_km2(\n","    water_mask,\n","    REFERENCE_TRANSFORM,\n","    REFERENCE_CRS\n",")\n","\n","\n","print(\n","    f\"\\nPredicted water area: \"\n","    f\"{water_area_km2:.4f} km²\"\n",")\n","\n","\n","# ============================================================\n","# 37. EXPORT GEOTIFF\n","# ============================================================\n","\n","def export_geotiff(\n","    filename,\n","    array,\n","    profile,\n","    dtype\n","):\n","\n","    output_profile = profile.copy()\n","\n","\n","    # Remove incompatible block/tile settings\n","    for key in [\n","        \"nodata\",\n","        \"blockxsize\",\n","        \"blockysize\",\n","        \"tiled\"\n","    ]:\n","\n","        output_profile.pop(\n","            key,\n","            None\n","        )\n","\n","\n","    output_profile.update({\n","\n","        \"driver\": \"GTiff\",\n","\n","        \"height\": array.shape[0],\n","\n","        \"width\": array.shape[1],\n","\n","        \"count\": 1,\n","\n","        \"dtype\": dtype,\n","\n","        \"compress\": \"deflate\"\n","\n","    })\n","\n","\n","    with rasterio.open(\n","        filename,\n","        \"w\",\n","        **output_profile\n","    ) as dst:\n","\n","        dst.write(\n","            array.astype(dtype),\n","            1\n","        )\n","\n","\n","reference_profile = load_raster(\n","    uploaded_paths[0]\n",")[2]\n","\n","\n","export_geotiff(\n","    \"forecast_water_probability.tif\",\n","    probability_map,\n","    reference_profile,\n","    \"float32\"\n",")\n","\n","\n","export_geotiff(\n","    \"forecast_water_mask.tif\",\n","    water_mask,\n","    reference_profile,\n","    \"uint8\"\n",")\n","\n","\n","print(\n","    \"\\nGeoTIFF outputs saved.\"\n",")\n","\n","\n","# ============================================================\n","# 38. SAVE MODEL\n","# ============================================================\n","\n","model.save(\n","    \"NDWI_Depth_UNet.keras\"\n",")\n","\n","\n","# ============================================================\n","# 39. SAVE METADATA\n","# ============================================================\n","\n","metadata = {\n","\n","    \"model\":\n","        \"NDWI_Depth_MultiTemporal_UNet\",\n","\n","    \"input_timesteps\":\n","        INPUT_TIMESTEPS,\n","\n","    \"cnn_channels\":\n","        CNN_CHANNELS,\n","\n","    \"channel_definition\": [\n","        \"NDWI_t-2\",\n","        \"Depth_t-2\",\n","        \"NDWI_t-1\",\n","        \"Depth_t-1\"\n","    ],\n","\n","    \"patch_size\":\n","        PATCH_SIZE,\n","\n","    \"training_sequences\":\n","        len(train_sequences),\n","\n","    \"validation_sequences\":\n","        len(val_sequences),\n","\n","    \"training_patches\":\n","        int(len(X_train)),\n","\n","    \"validation_patches\":\n","        int(len(X_val)),\n","\n","    \"prediction_threshold\":\n","        PREDICTION_THRESHOLD,\n","\n","    \"prediction_target\":\n","        {\n","            \"year\":\n","                target_record[\"year\"],\n","\n","            \"period\":\n","                target_record[\"period\"]\n","        },\n","\n","    \"water_area_km2\":\n","        float(water_area_km2),\n","\n","    \"chronological_files\":\n","        [\n","            os.path.basename(\n","                r[\"path\"]\n","            )\n","            for r in records\n","        ]\n","\n","}\n","\n","\n","with open(\n","    \"NDWI_Depth_UNet_metadata.json\",\n","    \"w\"\n",") as f:\n","\n","    json.dump(\n","        metadata,\n","        f,\n","        indent=2\n","    )\n","\n","\n","# ============================================================\n","# 40. HIDDEN-LAYER VISUALIZATION\n","# ============================================================\n","#\n","# This visualizes:\n","#\n","# Encoder:\n","#   Conv block 1\n","#   Pool 1\n","#   Conv block 2\n","#   Pool 2\n","#   Conv block 3\n","#   Pool 3\n","#\n","# Bottleneck:\n","#   Bottleneck convolution\n","#\n","# Decoder:\n","#   Upsample 3\n","#   Decoder block 3\n","#   Upsample 2\n","#   Decoder block 2\n","#   Upsample 1\n","#   Decoder block 1\n","#\n","# ============================================================\n","\n","def visualize_hidden_layers(\n","    model,\n","    sequence,\n","    max_feature_maps=8\n","):\n","\n","    print(\"\\n\" + \"=\" * 70)\n","    print(\"CNN HIDDEN-LAYER VISUALIZATION\")\n","    print(\"=\" * 70)\n","\n","\n","    # --------------------------------------------------------\n","    # CREATE SAMPLE INPUT\n","    # --------------------------------------------------------\n","\n","    stack = create_sequence_input(\n","        sequence,\n","        records\n","    )\n","\n","\n","    sample = stack[\n","        0:PATCH_SIZE,\n","        0:PATCH_SIZE,\n","        :\n","    ]\n","\n","\n","    sample = sample[\n","        np.newaxis,\n","        ...\n","    ]\n","\n","\n","    print(\n","        \"Visualization input:\",\n","        sample.shape\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # SELECT INTERNAL LAYERS\n","    # --------------------------------------------------------\n","\n","    hidden_layers = []\n","\n","    for layer in model.layers:\n","\n","        if isinstance(\n","            layer,\n","            (\n","                layers.Conv2D,\n","                layers.Conv2DTranspose,\n","                layers.MaxPooling2D,\n","                layers.Concatenate\n","            )\n","        ):\n","\n","            if layer.name != \"WATER_PROBABILITY\":\n","\n","                hidden_layers.append(\n","                    layer\n","                )\n","\n","\n","    # --------------------------------------------------------\n","    # BUILD ACTIVATION MODEL\n","    # --------------------------------------------------------\n","\n","    activation_model = models.Model(\n","\n","        inputs=model.input,\n","\n","        outputs=[\n","            layer.output\n","            for layer in hidden_layers\n","        ]\n","\n","    )\n","\n","\n","    activations = activation_model.predict(\n","        sample,\n","        verbose=0\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # VISUALIZE EACH LAYER\n","    # --------------------------------------------------------\n","\n","    for layer, activation in zip(\n","        hidden_layers,\n","        activations\n","    ):\n","\n","        print(\n","            f\"\\nLayer: {layer.name}\"\n","        )\n","\n","        print(\n","            \"Shape:\",\n","            activation.shape\n","        )\n","\n","\n","        feature_maps = activation[0]\n","\n","\n","        if feature_maps.ndim != 3:\n","\n","            continue\n","\n","\n","        channels = feature_maps.shape[-1]\n","\n","\n","        number_maps = min(\n","            channels,\n","            max_feature_maps\n","        )\n","\n","\n","        cols = 4\n","\n","        rows = int(\n","            np.ceil(\n","                number_maps /\n","                cols\n","            )\n","        )\n","\n","\n","        plt.figure(\n","            figsize=(\n","                12,\n","                3 * rows\n","            )\n","        )\n","\n","\n","        for i in range(\n","            number_maps\n","        ):\n","\n","            plt.subplot(\n","                rows,\n","                cols,\n","                i + 1\n","            )\n","\n","\n","            plt.imshow(\n","                feature_maps[..., i],\n","                cmap=\"gray\"\n","            )\n","\n","\n","            plt.title(\n","                f\"{layer.name}\\n\"\n","                f\"Feature {i + 1}\"\n","            )\n","\n","\n","            plt.axis(\n","                \"off\"\n","            )\n","\n","\n","        plt.suptitle(\n","            f\"Hidden Layer: {layer.name}\",\n","            fontsize=14\n","        )\n","\n","\n","        plt.tight_layout()\n","\n","        plt.show()\n","\n","\n","# ============================================================\n","# 41. RUN HIDDEN-LAYER VISUALIZATION\n","# ============================================================\n","\n","visualize_hidden_layers(\n","    model,\n","    latest_sequence,\n","    max_feature_maps=8\n",")\n","\n","\n","# ============================================================\n","# 42. VISUALIZE INPUT CHANNELS\n","# ============================================================\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"CNN INPUT CHANNEL VISUALIZATION\")\n","print(\"=\" * 70)\n","\n","\n","sample_stack = create_sequence_input(\n","    latest_sequence,\n","    records\n",")\n","\n","\n","plt.figure(\n","    figsize=(16, 8)\n",")\n","\n","\n","for i in range(\n","    CNN_CHANNELS\n","):\n","\n","    plt.subplot(\n","        2,\n","        2,\n","        i + 1\n","    )\n","\n","    plt.imshow(\n","        sample_stack[..., i],\n","        cmap=\"viridis\"\n","    )\n","\n","    plt.colorbar()\n","\n","    if i == 0:\n","\n","        title = \"NDWI t-2\"\n","\n","    elif i == 1:\n","\n","        title = \"Depth t-2\"\n","\n","    elif i == 2:\n","\n","        title = \"NDWI t-1\"\n","\n","    else:\n","\n","        title = \"Depth t-1\"\n","\n","\n","    plt.title(\n","        title\n","    )\n","\n","\n","plt.tight_layout()\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 43. FINAL OUTPUT SUMMARY\n","# ============================================================\n","\n","print(\"\\n\")\n","print(\"=\" * 70)\n","print(\"PROCESS COMPLETE\")\n","print(\"=\" * 70)\n","\n","print(\n","    \"\\nTemporal NDWI images:\",\n","    len(records)\n",")\n","\n","print(\n","    \"Forecast sequences:\",\n","    