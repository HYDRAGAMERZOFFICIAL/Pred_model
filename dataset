n    {\n      \"column\": \"NDWI\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.1031699653802697,\n        \"min\": -0.6279407739639282,\n        \"max\": -0.32611310482025146,\n        \"num_unique_values\": 10,\n        \"samples\": [\n          -0.4953889846801758\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"water\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0,\n        \"min\": 0,\n        \"max\": 0,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"depth_class\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0,\n        \"min\": 0,\n        \"max\": 0,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"depth_label\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\": 1,\n        \"samples\": [\n          \"Non-water\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Dataset saved as:\n","NDWI_pixel_depth_dataset.csv\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["\n","    async function download(id, filename, size) {\n","      if (!google.colab.kernel.accessAllowed) {\n","        return;\n","      }\n","      const div = document.createElement('div');\n","      const label = document.createElement('label');\n","      label.textContent = `Downloading \"${filename}\": `;\n","      div.appendChild(label);\n","      const progress = document.createElement('progress');\n","      progress.max = size;\n","      div.appendChild(progress);\n","      document.body.appendChild(div);\n","\n","      const buffers = [];\n","      let downloaded = 0;\n","\n","      const channel = await google.colab.kernel.comms.open(id);\n","      // Send a message to notify the kernel that we're ready.\n","      channel.send({})\n","\n","      for await (const message of channel.messages) {\n","        // Send a message to notify the kernel that we're ready.\n","        channel.send({})\n","        if (message.buffers) {\n","          for (const buffer of message.buffers) {\n","            buffers.push(buffer);\n","            downloaded += buffer.byteLength;\n","            progress.value = downloaded;\n","          }\n","        }\n","      }\n","      const blob = new Blob(buffers, {type: 'application/binary'});\n","      const a = document.createElement('a');\n","      a.href = window.URL.createObjectURL(blob);\n","      a.download = filename;\n","      div.appendChild(a);\n","      a.click();\n","      div.remove();\n","    }\n","  "]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["download(\"download_286dd342-236f-42d6-bd61-738ca9d5123b\", \"NDWI_pixel_depth_dataset.csv\", 2296184)"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# ============================================================\n","# PIXEL-BASED DEPTH CLASSIFICATION\n","# AND DATASET GENERATION FROM NDWI TIFF IMAGES\n","#\n","# Classes:\n","# 0 = Non-water\n","# 1 = Shallow\n","# 2 = Moderate\n","# 3 = Deep\n","#\n","# NOTE:\n","# These are RELATIVE depth classes based on NDWI.\n","# They are NOT actual water depth in meters.\n","# ============================================================\n","\n","\n","# ------------------------------------------------------------\n","# 1. INSTALL LIBRARIES\n","# ------------------------------------------------------------\n","\n","!pip install rasterio opencv-python pandas matplotlib -q\n","\n","\n","# ------------------------------------------------------------\n","# 2. IMPORT LIBRARIES\n","# ------------------------------------------------------------\n","\n","import os\n","import numpy as np\n","import pandas as pd\n","import rasterio\n","import cv2\n","import matplotlib.pyplot as plt\n","\n","from google.colab import files\n","\n","\n","# ------------------------------------------------------------\n","# 3. UPLOAD TIFF FILES\n","# ------------------------------------------------------------\n","\n","print(\"Upload your NDWI TIFF files:\")\n","print(\"NDWI_JAN_APR_22.tif\")\n","print(\"NDWI_MAY_AUG_22.tif\")\n","print(\"NDWI_SEP_DEC_22.tif\")\n","\n","uploaded = files.upload()\n","\n","tif_files = [\n","    filename for filename in uploaded.keys()\n","    if filename.lower().endswith(\".tif\")\n","]\n","\n","print(\"\\nTIFF files uploaded:\")\n","for f in tif_files:\n","    print(\" -\", f)\n","\n","\n","# ------------------------------------------------------------\n","# 4. FUNCTION FOR PROCESSING ONE TIFF\n","# ------------------------------------------------------------\n","\n","def process_ndwi_tif(image_path):\n","\n","    print(\"\\n==============================================\")\n","    print(\"Processing:\", image_path)\n","    print(\"==============================================\")\n","\n","    # --------------------------------------------------------\n","    # Read raster\n","    # --------------------------------------------------------\n","\n","    with rasterio.open(image_path) as src:\n","\n","        image = src.read(1).astype(np.float32)\n","\n","        transform = src.transform\n","        crs = src.crs\n","        nodata = src.nodata\n","\n","        height = src.height\n","        width = src.width\n","\n","    print(\"Image size:\", width, \"x\", height)\n","    print(\"Total pixels:\", image.size)\n","\n","    # --------------------------------------------------------\n","    # Valid pixel mask\n","    # --------------------------------------------------------\n","\n","    valid_mask = np.isfinite(image)\n","\n","    if nodata is not None:\n","        valid_mask &= (image != nodata)\n","\n","    valid_pixels = image[valid_mask]\n","\n","    print(\"Valid pixels:\", len(valid_pixels))\n","\n","    if len(valid_pixels) == 0:\n","        raise ValueError(\"No valid pixels found.\")\n","\n","    min_ndwi = np.min(valid_pixels)\n","    max_ndwi = np.max(valid_pixels)\n","\n","    print(\"Minimum NDWI:\", min_ndwi)\n","    print(\"Maximum NDWI:\", max_ndwi)\n","\n","\n","    # --------------------------------------------------------\n","    # Convert NDWI to 8-bit\n","    # --------------------------------------------------------\n","\n","    gray_image = np.zeros_like(image, dtype=np.uint8)\n","\n","    gray_image[valid_mask] = (\n","        (image[valid_mask] - min_ndwi)\n","        / (max_ndwi - min_ndwi)\n","        * 255\n","    ).astype(np.uint8)\n","\n","    gray_valid = gray_image[valid_mask]\n","\n","\n","    # --------------------------------------------------------\n","    # OTSU THRESHOLD\n","    # --------------------------------------------------------\n","\n","    otsu_8bit, _ = cv2.threshold(\n","        gray_valid,\n","        0,\n","        255,\n","        cv2.THRESH_BINARY + cv2.THRESH_OTSU\n","    )\n","\n","    # Convert Otsu threshold back to original NDWI\n","    otsu_ndwi = (\n","        (otsu_8bit / 255.0)\n","        * (max_ndwi - min_ndwi)\n","        + min_ndwi\n","    )\n","\n","    print(\"Otsu threshold (8-bit):\", otsu_8bit)\n","    print(\"Otsu threshold (NDWI):\", otsu_ndwi)\n","\n","\n","    # --------------------------------------------------------\n","    # WATER MASK\n","    # --------------------------------------------------------\n","\n","    water_mask = (\n","        valid_mask &\n","        (image >= otsu_ndwi)\n","    )\n","\n","    water_pixels = image[water_mask]\n","\n","    print(\"Water pixels:\", len(water_pixels))\n","\n","\n","    # --------------------------------------------------------\n","    # DEPTH CLASSIFICATION\n","    #\n","    # Water pixels are divided into:\n","    #\n","    # 1 = Shallow\n","    # 2 = Moderate\n","    # 3 = Deep\n","    #\n","    # using 33% and 66% NDWI quantiles.\n","    # --------------------------------------------------------\n","\n","    depth_class = np.zeros_like(image, dtype=np.uint8)\n","\n","    if len(water_pixels) > 0:\n","\n","        q33 = np.percentile(water_pixels, 33.33)\n","        q66 = np.percentile(water_pixels, 66.67)\n","\n","        print(\"Shallow/Moderate boundary:\", q33)\n","        print(\"Moderate/Deep boundary:\", q66)\n","\n","        # Shallow\n","        depth_class[\n","            water_mask &\n","            (image < q33)\n","        ] = 1\n","\n","        # Moderate\n","        depth_class[\n","            water_mask &\n","            (image >= q33) &\n","            (image < q66)\n","        ] = 2\n","\n","        # Deep\n","        depth_class[\n","            water_mask &\n","            (image >= q66)\n","        ] = 3\n","\n","\n","    # --------------------------------------------------------\n","    # CREATE PIXEL DATASET\n","    # --------------------------------------------------------\n","\n","    rows, cols = np.where(valid_mask)\n","\n","    records = []\n","\n","    for row, col in zip(rows, cols):\n","\n","        ndwi_value = float(image[row, col])\n","\n","        # Get geographic coordinates\n","        x, y = rasterio.transform.xy(\n","            transform,\n","            row,\n","            col\n","        )\n","\n","        pixel_class = int(depth_class[row, col])\n","\n","        # Class name\n","        if pixel_class == 0:\n","            class_name = \"Non-water\"\n","\n","        elif pixel_class == 1:\n","            class_name = \"Shallow\"\n","\n","        elif pixel_class == 2:\n","            class_name = \"Moderate\"\n","\n","        else:\n","            class_name = \"Deep\"\n","\n","        records.append({\n","            \"image\": os.path.basename(image_path),\n","            \"row\": row,\n","            \"column\": col,\n","            \"x\": x,\n","            \"y\": y,\n","            \"NDWI\": ndwi_value,\n","            \"water\": 1 if pixel_class > 0 else 0,\n","            \"depth_class\": pixel_class,\n","            \"depth_label\": class_name\n","        })\n","\n","\n","    dataset = pd.DataFrame(records)\n","\n","    return (\n","        dataset,\n","        depth_class,\n","        otsu_ndwi,\n","        q33,\n","        q66\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 5. PROCESS ALL TIFF FILES\n","# ------------------------------------------------------------\n","\n","all_datasets = []\n","\n","classification_results = {}\n","\n","for tif_file in tif_files:\n","\n","    dataset, depth_map, otsu, q33, q66 = process_ndwi_tif(\n","        tif_file\n","    )\n","\n","    all_datasets.append(dataset)\n","\n","    classification_results[tif_file] = {\n","        \"depth_map\": depth_map,\n","        \"otsu\": otsu,\n","        \"q33\": q33,\n","        \"q66\": q66\n","    }\n","\n","\n","# ------------------------------------------------------------\n","# 6. COMBINE ALL PIXELS INTO ONE DATASET\n","# ------------------------------------------------------------\n","\n","final_dataset = pd.concat(\n","    all_datasets,\n","    ignore_index=True\n",")\n","\n","print(\"\\n==============================================\")\n","print(\"FINAL DATASET\")\n","print(\"==============================================\")\n","\n","print(\"Total dataset rows:\", len(final_dataset))\n","\n","print(\"\\nColumns:\")\n","print(final_dataset.columns.tolist())\n","\n","print(\"\\nClass distribution:\")\n","print(\n","    final_dataset[\"depth_label\"].value_counts()\n",")\n","\n","print(\"\\nFirst 10 rows:\")\n","display(final_dataset.head(10))\n","\n","\n","# ------------------------------------------------------------\n","# 7. SAVE DATASET AS CSV\n","# ------------------------------------------------------------\n","\n","csv_filename = \"NDWI_pixel_depth_dataset.csv\"\n","\n","final_dataset.to_csv(\n","    csv_filename,\n","    index=False\n",")\n","\n","print(\"\\nDataset saved as:\")\n","print(csv_filename)\n","\n","\n","# ------------------------------------------------------------\n","# 8. DOWNLOAD CSV\n","# ------------------------------------------------------------\n","\n","files.download(csv_filename)\n","\n","\n","# ------------------------------------------------------------\n","# 9. DISPLAY CLASSIFICATION MAPS\n","# ------------------------------------------------------------\n","\n","for tif_file, result in classification_results.items():\n","\n","    depth_map = result[\"depth_map\"]\n","    otsu = result[\"otsu\"]\n","\n","    plt.figure(figsize=(8, 6))\n","\n","    plt.imshow(\n","        depth_map,\n","        cmap=\"viridis\",\n","        vmin=0,\n","        vmax=3\n","    )\n","\n","    plt.colorbar(\n","        ticks=[0, 1, 2, 3],\n","        label=\"Class\"\n","    )\n","\n","    plt.title(\n","        f\"Pixel-Based Depth Classification\\n\"\n","        f\"{tif_file}\\n\"\n","        f\"Otsu NDWI = {otsu:.6f}\"\n","    )\n","\n","    plt.xlabel(\"Column\")\n","    plt.ylabel(\"Row\")\n","\n","    plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"xhgusxD5kIf2","executionInfo":{"status":"ok","timestamp":1787034670678,"user_tz":-330,"elapsed":29118,"user":{"displayName":"Naturesworld","userId":"00808670514782698905"}},"outputId":"