\n","LOWER_PERCENTILE = 2.0\n","UPPER_PERCENTILE = 98.0\n","\n","VALIDATION_SEQUENCES = 1\n","PREDICTION_THRESHOLD = 0.5\n","\n","SEED = 100\n","\n","np.random.seed(SEED)\n","tf.random.set_seed(SEED)\n","\n","# ------------------------------------------------------------\n","# 1. UPLOAD FILES\n","# ------------------------------------------------------------\n","\n","print(\"Upload chronological NDWI GeoTIFF files.\")\n","print(\"Example:\")\n","print(\"  2022_Jan_Apr.tif\")\n","print(\"  2022_May_Aug.tif\")\n","print(\"  2022_Sep_Dec.tif\")\n","print(\"  2023_Jan_Apr.tif\")\n","\n","uploaded = files.upload()\n","uploaded_paths = list(uploaded.keys())\n","\n","if len(uploaded_paths) == 0:\n","    raise ValueError(\"No files were uploaded.\")\n","\n","# Keep upload order because temporal order matters.\n","for path in uploaded_paths:\n","    if not path.lower().endswith((\".tif\", \".tiff\")):\n","        raise ValueError(\n","            f\"{path} is not a GeoTIFF. \"\n","            \"This U-Net NDWI branch requires .tif/.tiff files.\"\n","        )\n","\n","print(\"\\nUploaded files:\")\n","for i, path in enumerate(uploaded_paths):\n","    print(f\"{i}: {path}\")\n","\n","if len(uploaded_paths) < INPUT_TIMESTEPS + 1:\n","    raise ValueError(\n","        f\"At least {INPUT_TIMESTEPS + 1} chronological files are required \"\n","        f\"for true next-period forecasting.\"\n","    )\n","\n","# ------------------------------------------------------------\n","# 2. LOAD RASTER\n","# ------------------------------------------------------------\n","\n","def load_raster(path):\n","    with rasterio.open(path) as src:\n","\n","        image = src.read(1).astype(np.float32)\n","\n","        valid_mask = np.isfinite(image)\n","\n","        if src.nodata is not None:\n","            valid_mask &= image != src.nodata\n","\n","        profile = src.profile.copy()\n","        transform = src.transform\n","        crs = src.crs\n","\n","        height = src.height\n","        width = src.width\n","\n","    valid_mask &= image > -1e30\n","\n","    image = np.where(\n","        valid_mask,\n","        image,\n","        np.nan\n","    ).astype(np.float32)\n","\n","    return image, valid_mask, profile, transform, crs, height, width\n","\n","\n","# ------------------------------------------------------------\n","# 3. CHECK ALL RASTERS SHARE THE SAME GRID\n","# ------------------------------------------------------------\n","\n","def validate_raster_stack(paths):\n","\n","    reference = None\n","\n","    for path in paths:\n","\n","        (\n","            image,\n","            valid_mask,\n","            profile,\n","            transform,\n","            crs,\n","            height,\n","            width\n","        ) = load_raster(path)\n","\n","        current = {\n","            \"height\": height,\n","            \"width\": width,\n","            \"transform\": transform,\n","            \"crs\": crs\n","        }\n","\n","        if reference is None:\n","            reference = current\n","            continue\n","\n","        if current[\"height\"] != reference[\"height\"]:\n","            raise ValueError(\n","                f\"Height mismatch: {path}\"\n","            )\n","\n","        if current[\"width\"] != reference[\"width\"]:\n","            raise ValueError(\n","                f\"Width mismatch: {path}\"\n","            )\n","\n","        if current[\"transform\"] != reference[\"transform\"]:\n","            raise ValueError(\n","                f\"Pixel-grid transform mismatch: {path}\\n\"\n","                \"All temporal rasters must be spatially aligned.\"\n","            )\n","\n","        if current[\"crs\"] != reference[\"crs\"]:\n","            raise ValueError(\n","                f\"CRS mismatch: {path}\\n\"\n","                \"Reproject all rasters to one CRS before training.\"\n","            )\n","\n","    print(\"\\nRaster grid validation: PASSED\")\n","    print(f\"Canvas: {reference['height']} x {reference['width']}\")\n","    print(f\"CRS: {reference['crs']}\")\n","\n","    return reference\n","\n","\n","REFERENCE = validate_raster_stack(uploaded_paths)\n","\n","CANVAS_H = REFERENCE[\"height\"]\n","CANVAS_W = REFERENCE[\"width\"]\n","REFERENCE_CRS = REFERENCE[\"crs\"]\n","REFERENCE_TRANSFORM = REFERENCE[\"transform\"]\n","\n","# ------------------------------------------------------------\n","# 4. ROBUST NORMALIZATION\n","# ------------------------------------------------------------\n","# Uses actual NDWI values.\n","# No fixed NDWI threshold is introduced.\n","\n","def normalize_robust(image, valid_mask):\n","    result = np.zeros_like(image, dtype=np.float32)\n","\n","    values = image[valid_mask]\n","\n","    if values.size == 0:\n","        return result\n","\n","    lo = np.percentile(values, LOWER_PERCENTILE)\n","    hi = np.percentile(values, UPPER_PERCENTILE)\n","\n","    if hi <= lo:\n","        result[valid_mask] = 0.0\n","        return result\n","\n","    clipped = np.clip(\n","        image[valid_mask],\n","        lo,\n","        hi\n","    )\n","\n","    result[valid_mask] = (\n","        (clipped - lo) /\n","        (hi - lo)\n","    ).astype(np.float32)\n","\n","    return result\n","\n","\n","# ------------------------------------------------------------\n","# 5. OTSU PSEUDO-LABEL USING ORIGINAL NDWI VALUES\n","# ------------------------------------------------------------\n","\n","def otsu_binary_mask(image, valid_mask, bins=1024):\n","\n","    result = np.zeros_like(\n","        image,\n","        dtype=np.float32\n","    )\n","\n","    values = image[valid_mask]\n","\n","    if values.size < 2:\n","        return result, np.nan\n","\n","    value_min = float(values.min())\n","    value_max = float(values.max())\n","\n","    if value_max <= value_min:\n","        return result, value_min\n","\n","    # Histogram is in the original NDWI range.\n","    hist, edges = np.histogram(\n","        values,\n","        bins=bins,\n","        range=(value_min, value_max)\n","    )\n","\n","    hist = hist.astype(np.float64)\n","\n","    centers = (\n","        edges[:-1] +\n","        edges[1:]\n","    ) / 2.0\n","\n","    total = hist.sum()\n","\n","    if total <= 0:\n","        return result, np.nan\n","\n","    probability = hist / total\n","\n","    omega = np.cumsum(probability)\n","\n","    mu = np.cumsum(\n","        probability * centers\n","    )\n","\n","    mu_total = mu[-1]\n","\n","    denominator = (\n","        omega *\n","        (1.0 - omega)\n","    )\n","\n","    between = np.zeros_like(\n","        denominator\n","    )\n","\n","    valid = denominator > 0\n","\n","    between[valid] = (\n","        (mu_total * omega[valid] - mu[valid]) ** 2\n","        /\n","        denominator[valid]\n","    )\n","\n","    best_index = int(\n","        np.argmax(between)\n","    )\n","\n","    threshold = float(\n","        centers[best_index]\n","    )\n","\n","    result[valid_mask] = (\n","        image[valid_mask] >= threshold\n","    ).astype(np.float32)\n","\n","    return result, threshold\n","\n","\n","# ------------------------------------------------------------\n","# 6. LOAD ALL TEMPORAL DATA\n","# ------------------------------------------------------------\n","\n","def load_temporal_data(paths):\n","\n","    records = []\n","\n","    for path in paths:\n","\n","        (\n","            image,\n","            valid_mask,\n","            profile,\n","            transform,\n","            crs,\n","            height,\n","            width\n","        ) = load_raster(path)\n","\n","        normalized = normalize_robust(\n","            image,\n","            valid_mask\n","        )\n","\n","        label, otsu_threshold = otsu_binary_mask(\n","            image,\n","            valid_mask\n","        )\n","\n","        records.append({\n","            \"path\": path,\n","            \"image\": image,\n","            \"normalized\": normalized,\n","            \"valid_mask\": valid_mask.astype(np.float32),\n","            \"label\": label,\n","            \"otsu_threshold\": otsu_threshold\n","        })\n","\n","        print(\n","            f\"{os.path.basename(path)} | \"\n","            f\"Otsu NDWI = {otsu_threshold:.6f}\"\n","        )\n","\n","    return records\n","\n","\n","records = load_temporal_data(\n","    uploaded_paths\n",")\n","\n","# ------------------------------------------------------------\n","# 7. BUILD TRUE FORECAST SEQUENCES\n","# ------------------------------------------------------------\n","# Example with 4 rasters and INPUT_TIMESTEPS = 2:\n","#\n","# Sequence 1:\n","#   input = [t0, t1]\n","#   target = t2\n","#\n","# Sequence 2:\n","#   input = [t1, t2]\n","#   target = t3\n","#\n","# This is real next-period forecasting.\n","# The target raster is NEVER included in its own input.\n","\n","def build_sequences(records):\n","\n","    sequences = []\n","\n","    total = len(records)\n","\n","    for target_index in range(\n","        INPUT_TIMESTEPS,\n","        total\n","    ):\n","\n","        input_indices = list(\n","            range(\n","                target_index - INPUT_TIMESTEPS,\n","                target_index\n","            )\n","        )\n","\n","        sequences.append({\n","            \"input_indices\": input_indices,\n","            \"target_index\": target_index\n","        })\n","\n","    return sequences\n","\n","\n","sequences = build_sequences(records)\n","\n","print(\n","    f\"\\nGenerated forecast sequences: {len(sequences)}\"\n",")\n","\n","for i, seq in enumerate(sequences):\n","    print(\n","        f\"Sequence {i}: \"\n","        f\"inputs={seq['input_indices']} \"\n","        f\"-> target={seq['target_index']}\"\n","    )\n","\n","# ------------------------------------------------------------\n","# 8. PATCH EXTRACTION\n","# ------------------------------------------------------------\n","\n","def patch_positions(\n","    height,\n","    width,\n","    patch_size,\n","    stride\n","):\n","\n","    ys = list(\n","        range(\n","            0,\n","            max(height - patch_size, 0) + 1,\n","            stride\n","        )\n","    )\n","\n","    xs = list(\n","        range(\n","            0,\n","            max(width - patch_size, 0) + 1,\n","            stride\n","        )\n","    )\n","\n","    if height > patch_size:\n","        last_y = height - patch_size\n","        if last_y not in ys:\n","            ys.append(last_y)\n","\n","    if width > patch_size:\n","        last_x = width - patch_size\n","        if last_x not in xs:\n","            xs.append(last_x)\n","\n","    if height <= patch_size:\n","        ys = [0]\n","\n","    if width <= patch_size:\n","        xs = [0]\n","\n","    return ys, xs\n","\n","\n","def extract_patches_from_sequence(\n","    sequence,\n","    records,\n","    patch_size=PATCH_SIZE,\n","    stride=STRIDE\n","):\n","\n","    inputs = [\n","        records[i][\"normalized\"]\n","        for i in sequence[\"input_indices\"]\n","    ]\n","\n","    target = records[\n","        sequence[\"target_index\"]\n","    ][\"label\"]\n","\n","    valid = records[\n","        sequence[\"target_index\"]\n","    ][\"valid_mask\"]\n","\n","    X = []\n","    Y = []\n","\n","    ys, xs = patch_positions(\n","        CANVAS_H,\n","        CANVAS_W,\n","        patch_size,\n","        stride\n","    )\n","\n","    for y in ys:\n","        for x in xs:\n","\n","            x_patch_list = []\n","\n","            for image in inputs:\n","\n","                patch = image[\n","                    y:y + patch_size,\n","                    x:x + patch_size\n","                ]\n","\n","                x_patch_list.append(\n","                    patch\n","                )\n","\n","            x_patch = np.stack(\n","                x_patch_list,\n","                axis=-1\n","            )\n","\n","            y_patch = target[\n","                y:y + patch_size,\n","                x:x + patch_size\n","            ]\n","\n","            valid_patch = valid[\n","                y:y + patch_size,\n","                x:x + patch_size\n","            ]\n","\n","            if valid_patch.size == 0:\n","                continue\n","\n","            if valid_patch.mean() < MIN_VALID_FRAC:\n","                continue\n","\n","            ph, pw = y_patch.shape\n","\n","            # Padding for edge patches\n","            if (\n","                ph != patch_size\n","                or\n","                pw != patch_size\n","            ):\n","\n","                padded_x = np.zeros(\n","                    (\n","                        patch_size,\n","                        patch_size,\n","                        INPUT_TIMESTEPS\n","                    ),\n","                    dtype=np.float32\n","                )\n","\n","                padded_y = np.zeros(\n","                    (\n","                        patch_size,\n","                        patch_size\n","                    ),\n","                    dtype=np.float32\n","                )\n","\n","                padded_x[\n","                    :ph,\n","                    :pw,\n","                    :\n","                ] = x_patch\n","\n","                padded_y[\n","                    :ph,\n","                    :pw\n","                ] = y_patch\n","\n","                x_patch = padded_x\n","                y_patch = padded_y\n","\n","            X.append(\n","                x_patch.astype(\n","                    np.float32\n","                )\n","            )\n","\n","            # y channel 0 = label\n","            # y channel 1 = valid mask\n","            Y.append(\n","                np.stack(\n","                    [\n","                        y_patch,\n","                        valid_patch\n","                    ],\n","                    axis=-1\n","                ).astype(np.float32)\n","            )\n","\n","    return (\n","        np.asarray(X, dtype=np.float32),\n","        np.asarray(Y, dtype=np.float32)\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 9. AUGMENTATION\n","# ------------------------------------------------------------\n","\n","def augment_pair(x, y):\n","\n","    if np.random.rand() < 0.5:\n","        x = np.fliplr(x)\n","        y = np.fliplr(y)\n","\n","    if np.random.rand() < 0.5:\n","        x = np.flipud(x)\n","        y = np.flipud(y)\n","\n","    rotations = np.random.randint(\n","        0,\n","        4\n","    )\n","\n","    x = np.rot90(\n","        x,\n","        rotations,\n","        axes=(0, 1)\n","    )\n","\n","    y = np.rot90(\n","        y,\n","        rotations,\n","        axes=(0, 1)\n","    )\n","\n","    return (\n","        x.copy(),\n","        y.copy()\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 10. TEMPORAL VALIDATION SPLIT\n","# ------------------------------------------------------------\n","# Do NOT randomly split overlapping spatial patches from the\n","# same image into train and validation sets.\n","#\n","# The latest sequence(s) are reserved for validation.\n","\n","if len(sequences) <= VALIDATION_SEQUENCES:\n","\n","    raise ValueError(\n","        \"Not enough temporal sequences for training and validation. \"\n","        \"Upload more chronological periods.\"\n","    )\n","\n","train_sequences = sequences[\n","    :-VALIDATION_SEQUENCES\n","]\n","\n","val_sequences = sequences[\n","    -VALIDATION_SEQUENCES:\n","]\n","\n","print(\n","    f\"\\nTraining sequences: {len(train_sequences)}\"\n",")\n","\n","print(\n","    f\"Validation sequences: {len(val_sequences)}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 11. BUILD TRAINING DATA\n","# ------------------------------------------------------------\n","\n","def build_dataset(sequence_list):\n","\n","    X_all = []\n","    Y_all = []\n","\n","    for sequence in sequence_list:\n","\n","        X_seq, Y_seq = (\n","            extract_patches_from_sequence(\n","                sequence,\n","                records\n","            )\n","        )\n","\n","        if len(X_seq) == 0:\n","            continue\n","\n","        X_all.append(X_seq)\n","        Y_all.append(Y_seq)\n","\n","    if not X_all:\n","\n","        return (\n","            np.empty(\n","                (\n","                    0,\n","                    PATCH_SIZE,\n","                    PATCH_SIZE,\n","                    INPUT_TIMESTEPS\n","                ),\n","                dtype=np.float32\n","            ),\n","            np.empty(\n","                (\n","                    0,\n","                    PATCH_SIZE,\n","                    PATCH_SIZE,\n","                    2\n","                ),\n","                dtype=np.float32\n","            )\n","        )\n","\n","    X = np.concatenate(\n","        X_all,\n","        axis=0\n","    )\n","\n","    Y = np.concatenate(\n","        Y_all,\n","        axis=0\n","    )\n","\n","    return X, Y\n","\n","\n","X_train, Y_train = build_dataset(\n","    train_sequences\n",")\n","\n","X_val, Y_val = build_dataset(\n","    val_sequences\n",")\n","\n","print(\"\\nTRAIN\")\n","print(\"X:\", X_train.shape)\n","print(\"Y:\", Y_train.shape)\n","\n","print(\"\\nVALIDATION\")\n","print(\"X:\", X_val.shape)\n","print(\"Y:\", Y_val.shape)\n","\n","if len(X_train) == 0:\n","    raise ValueError(\n","        \"No training patches were generated. \"\n","        \"Check raster validity and MIN_VALID_FRAC.\"\n","    )\n","\n","if len(X_val) == 0:\n","    raise ValueError(\n","        \"No validation patches were generated.\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 12. AUGMENT TRAINING DATA\n","# ------------------------------------------------------------\n","\n","augmented = [\n","    augment_pair(x, y)\n","    for x, y in zip(\n","        X_train,\n","        Y_train\n","    )\n","]\n","\n","aug_X = np.asarray(\n","    [item[0] for item in augmented],\n","    dtype=np.float32\n",")\n","\n","aug_Y = np.asarray(\n","    [item[1] for item in augmented],\n","    dtype=np.float32\n",")\n","\n","X_train = np.concatenate(\n","    [\n","        X_train,\n","        aug_X\n","    ],\n","    axis=0\n",")\n","\n","Y_train = np.concatenate(\n","    [\n","        Y_train,\n","        aug_Y\n","    ],\n","    axis=0\n",")\n","\n","print(\n","    \"\\nTraining patches after augmentation:\",\n","    len(X_train)\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 13. U-NET BLOCK\n","# ------------------------------------------------------------\n","\n","def conv_block(\n","    x,\n","    filters,\n","    dropout=0.10\n","):\n","\n","    x = layers.Conv2D(\n","        filters,\n","        3,\n","        padding=\"same\",\n","        use_bias=False\n","    )(x)\n","\n","    x = layers.BatchNormalization()(x)\n","    x = layers.Activation(\"relu\")(x)\n","\n","    x = layers.Conv2D(\n","        filters,\n","        3,\n","        padding=\"same\",\n","        use_bias=False\n","    )(x)\n","\n","    x = layers.BatchNormalization()(x)\n","    x = layers.Activation(\"relu\")(x)\n","\n","    if dropout > 0:\n","        x = layers.Dropout(dropout)(x)\n","\n","    return x\n","\n","\n","# ------------------------------------------------------------\n","# 14. IMPROVED U-NET\n","# ------------------------------------------------------------\n","\n","def build_unet(input_shape):\n","\n","    inputs = layers.Input(\n","        shape=input_shape,\n","        name=\"NDWI_TEMPORAL_INPUT\"\n","    )\n","\n","    # Encoder\n","    c1 = conv_block(\n","        inputs,\n","        32,\n","        0.05\n","    )\n","\n","    p1 = layers.MaxPooling2D()(\n","        c1\n","    )\n","\n","    c2 = conv_block(\n","        p1,\n","        64,\n","        0.10\n","    )\n","\n","    p2 = layers.MaxPooling2D()(\n","        c2\n","    )\n","\n","    c3 = conv_block(\n","        p2,\n","        128,\n","        0.15\n","    )\n","\n","    p3 = layers.MaxPooling2D()(\n","        c3\n","    )\n","\n","    bottleneck = conv_block(\n","        p3,\n","        256,\n","        0.20\n","    )\n","\n","    # Decoder\n","    u3 = layers.Conv2DTranspose(\n","        128,\n","        2,\n","        strides=2,\n","        padding=\"same\"\n","    )(bottleneck)\n","\n","    u3 = layers.Concatenate()(\n","        [u3, c3]\n","    )\n","\n","    c4 = conv_block(\n","        u3,\n","        128,\n","        0.15\n","    )\n","\n","    u2 = layers.Conv2DTranspose(\n","        64,\n","        2,\n","        strides=2,\n","        padding=\"same\"\n","    )(c4)\n","\n","    u2 = layers.Concatenate()(\n","        [u2, c2]\n","    )\n","\n","    c5 = conv_block(\n","        u2,\n","        64,\n","        0.10\n","    )\n","\n","    u1 = layers.Conv2DTranspose(\n","        32,\n","        2,\n","        strides=2,\n","        padding=\"same\"\n","    )(c5)\n","\n","    u1 = layers.Concatenate()(\n","        [u1, c1]\n","    )\n","\n","    c6 = conv_block(\n","        u1,\n","        32,\n","        0.05\n","    )\n","\n","    output = layers.Conv2D(\n","        1,\n","        1,\n","        activation=\"sigmoid\",\n","        name=\"WATER_PROBABILITY\"\n","    )(c6)\n","\n","    return models.Model(\n","        inputs,\n","        output,\n","        name=\"Improved_MultiTemporal_UNet\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 15. MASKED BCE + DICE LOSS\n","# ------------------------------------------------------------\n","\n","def unpack_true(\n","    y_true,\n","    y_pred\n","):\n","\n","    label = y_true[..., 0]\n","    valid_mask = y_true[..., 1]\n","    prediction = y_pred[..., 0]\n","\n","    return (\n","        label,\n","        valid_mask,\n","        prediction\n","    )\n","\n","\n","def masked_bce_dice_loss(\n","    y_true,\n","    y_pred\n","):\n","\n","    label, mask, pred = unpack_true(\n","        y_true,\n","        y_pred\n","    )\n","\n","    pred = tf.clip_by_value(\n","        pred,\n","        1e-7,\n","        1.0 - 1e-7\n","    )\n","\n","    # Binary cross entropy\n","    bce = -(\n","        label * tf.math.log(pred)\n","        +\n","        (1.0 - label)\n","        *\n","        tf.math.log(1.0 - pred)\n","    )\n","\n","    bce = tf.reduce_sum(\n","        bce * mask\n","    ) / (\n","        tf.reduce_sum(mask)\n","        +\n","        1e-6\n","    )\n","\n","    # Dice\n","    intersection = tf.reduce_sum(\n","        label * pred * mask\n","    )\n","\n","    denominator = (\n","        tf.reduce_sum(label * mask)\n","        +\n","        tf.reduce_sum(pred * mask)\n","    )\n","\n","    dice = (\n","        2.0 * intersection\n","        +\n","        1e-6\n","    ) / (\n","        denominator\n","        +\n","        1e-6\n","    )\n","\n","    return bce + (\n","        1.0 - dice\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 16. METRICS\n","# ------------------------------------------------------------\n","\n","def masked_iou(\n","    y_true,\n","    y_pred\n","):\n","\n","    label, mask, pred = unpack_true(\n","        y_true,\n","        y_pred\n","    )\n","\n","    prediction = tf.cast(\n","        pred >= 0.5,\n","        tf.float32\n","    )\n","\n","    intersection = tf.reduce_sum(\n","        label *\n","        prediction *\n","        mask\n","    )\n","\n","    union = tf.reduce_sum(\n","        tf.maximum(\n","            label,\n","            prediction\n","        )\n","        *\n","        mask\n","    )\n","\n","    return (\n","        intersection + 1e-6\n","    ) / (\n","        union + 1e-6\n","    )\n","\n","\n","def masked_dice(\n","    y_true,\n","    y_pred\n","):\n","\n","    label, mask, pred = unpack_true(\n","        y_true,\n","        y_pred\n","    )\n","\n","    intersection = tf.reduce_sum(\n","        label *\n","        pred *\n","        mask\n","    )\n","\n","    denominator = (\n","        tf.reduce_sum(\n","            label * mask\n","        )\n","        +\n","        tf.reduce_sum(\n","            pred * mask\n","        )\n","    )\n","\n","    return (\n","        2.0 * intersection +\n","        1e-6\n","    ) / (\n","        denominator +\n","        1e-6\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 17. BUILD + COMPILE\n","# ------------------------------------------------------------\n","\n","model = build_unet(\n","    (\n","        PATCH_SIZE,\n","        PATCH_SIZE,\n","        INPUT_TIMESTEPS\n","    )\n",")\n","\n","model.compile(\n","    optimizer=tf.keras.optimizers.Adam(\n","        learning_rate=LEARNING_RATE\n","    ),\n","    loss=masked_bce_dice_loss,\n","    metrics=[\n","        masked_iou,\n","        masked_dice\n","    ]\n",")\n","\n","model.summary()\n","\n","\n","# ------------------------------------------------------------\n","# 18. CALLBACKS\n","# ------------------------------------------------------------\n","\n","training_callbacks = [\n","\n","    callbacks.ModelCheckpoint(\n","        \"best_unet.keras\",\n","        monitor=\"val_masked_iou\",\n","        mode=\"max\",\n","        save_best_only=True\n","    ),\n","\n","    callbacks.EarlyStopping(\n","        monitor=\"val_masked_iou\",\n","        mode=\"max\",\n","        patience=8,\n","        restore_best_weights=True\n","    ),\n","\n","    callbacks.ReduceLROnPlateau(\n","        monitor=\"val_loss\",\n","        factor=0.5,\n","        patience=4,\n","        min_lr=1e-7\n","    )\n","]\n","\n","\n","# ------------------------------------------------------------\n","# 19. TRAIN\n","# ------------------------------------------------------------\n","\n","history = model.fit(\n","    X_train,\n","    Y_train,\n","    validation_data=(\n","        X_val,\n","        Y_val\n","    ),\n","    batch_size=BATCH_SIZE,\n","    epochs=EPOCHS,\n","    callbacks=training_callbacks,\n","    shuffle=True,\n","    verbose=1\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 20. TRAINING CURVES\n","# ------------------------------------------------------------\n","\n","plt.figure(figsize=(10, 5))\n","\n","plt.plot(\n","    history.history[\"loss\"],\n","    label=\"Training Loss\"\n",")\n","\n","plt.plot(\n","    history.history[\"val_loss\"],\n","    label=\"Validation Loss\"\n",")\n","\n","plt.xlabel(\"Epoch\")\n","plt.ylabel(\"Loss\")\n","plt.title(\"Training / Validation Loss\")\n","plt.legend()\n","plt.grid(True)\n","plt.show()\n","\n","\n","plt.figure(figsize=(10, 5))\n","\n","plt.plot(\n","    history.history[\"masked_iou\"],\n","    label=\"Training IoU\"\n",")\n","\n","plt.plot(\n","    history.history[\"val_masked_iou\"],\n","    label=\"Validation IoU\"\n",")\n","\n","plt.xlabel(\"Epoch\")\n","plt.ylabel(\"IoU\")\n","plt.title(\"Water Segmentation IoU\")\n","plt.legend()\n","plt.grid(True)\n","plt.show()\n","\n","\n","# ------------------------------------------------------------\n","# 21. FULL-RASTER PREDICTION\n","# ------------------------------------------------------------\n","# Uses the latest INPUT_TIMESTEPS rasters to predict the NEXT period.\n","\n","def predict_next_period(\n","    model,\n","    records\n","):\n","\n","    input_records = records[\n","        -INPUT_TIMESTEPS:\n","    ]\n","\n","    stack = np.stack(\n","        [\n","            r[\"normalized\"]\n","            for r in input_records\n","        ],\n","        axis=-1\n","    )\n","\n","    probability = np.zeros(\n","        (\n","            CANVAS_H,\n","            CANVAS_W\n","        ),\n","        dtype=np.float32\n","    )\n","\n","    count = np.zeros(\n","        (\n","            CANVAS_H,\n","            CANVAS_W\n","        ),\n","        dtype=np.float32\n","    )\n","\n","    ys, xs = patch_positions(\n","        CANVAS_H,\n","        CANVAS_W,\n","        PATCH_SIZE,\n","        max(\n","            PATCH_SIZE // 2,\n","            1\n","        )\n","    )\n","\n","    for y in ys:\n","\n","        for x in xs:\n","\n","            patch = stack[\n","                y:y + PATCH_SIZE,\n","                x:x + PATCH_SIZE,\n","                :\n","            ]\n","\n","            ph, pw = patch.shape[:2]\n","\n","            padded = np.zeros(\n","                (\n","                    1,\n","                    PATCH_SIZE,\n","                    PATCH_SIZE,\n","                    INPUT_TIMESTEPS\n","                ),\n","                dtype=np.float32\n","            )\n","\n","            padded[\n","                0,\n","                :ph,\n","                :pw,\n","                :\n","            ] = patch\n","\n","            prediction = model.predict(\n","                padded,\n","                verbose=0\n","            )[0, :ph, :pw, 0]\n","\n","            probability[\n","                y:y + ph,\n","                x:x + pw\n","            ] += prediction\n","\n","            count[\n","                y:y + ph,\n","                x:x + pw\n","            ] += 1.0\n","\n","    probability /= np.maximum(\n","        count,\n","        1.0\n","    )\n","\n","    binary = (\n","        probability >=\n","        PREDICTION_THRESHOLD\n","    ).astype(np.uint8)\n","\n","    return (\n","        probability,\n","        binary\n","    )\n","\n","\n","probability_map, water_mask = (\n","    predict_next_period(\n","        model,\n","        records\n","    )\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 22. DISPLAY PREDICTION\n","# ------------------------------------------------------------\n","\n","plt.figure(\n","    figsize=(14, 5)\n",")\n","\n","plt.subplot(\n","    1,\n","    3,\n","    1\n",")\n","\n","plt.imshow(\n","    records[-1][\"normalized\"],\n","    cmap=\"viridis\",\n","    vmin=0,\n","    vmax=1\n",")\n","\n","plt.title(\n","    \"Latest Input NDWI\"\n",")\n","\n","plt.colorbar()\n","\n","\n","plt.subplot(\n","    1,\n","    3,\n","    2\n",")\n","\n","plt.imshow(\n","    probability_map,\n","    cmap=\"Blues\",\n","    vmin=0,\n","    vmax=1\n",")\n","\n","plt.title(\n","    \"Predicted Water Probability\"\n",")\n","\n","plt.colorbar()\n","\n","\n","plt.subplot(\n","    1,\n","    3,\n","    3\n",")\n","\n","plt.imshow(\n","    water_mask,\n","    cmap=\"gray\",\n","    vmin=0,\n","    vmax=1\n",")\n","\n","plt.title(\n","    \"Predicted Water Mask\"\n",")\n","\n","plt.colorbar()\n","\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# ------------------------------------------------------------\n","# 23. AREA CALCULATION\n","# ------------------------------------------------------------\n","\n","def calculate_area_km2(\n","    mask,\n","    transform,\n","    crs\n","):\n","\n","    if crs is None:\n","        print(\n","            \"CRS missing: area cannot be calculated reliably.\"\n","        )\n","        return np.nan\n","\n","    if crs.is_geographic:\n","        print(\n","            \"CRS is geographic (degrees). \"\n","            \"Reproject to a metre-based projected CRS \"\n","            \"before using pixel-area calculation.\"\n","        )\n","        return np.nan\n","\n","    pixel_width = abs(\n","        transform.a\n","    )\n","\n","    pixel_height = abs(\n","        transform.e\n","    )\n","\n","    pixel_area_m2 = (\n","        pixel_width *\n","        pixel_height\n","    )\n","\n","    water_pixels = int(\n","        np.sum(mask == 1)\n","    )\n","\n","    area_m2 = (\n","        water_pixels *\n","        pixel_area_m2\n","    )\n","\n","    area_km2 = (\n","        area_m2 /\n","        1e6\n","    )\n","\n","    return area_km2\n","\n","\n","water_area_km2 = calculate_area_km2(\n","    water_mask,\n","    REFERENCE_TRANSFORM,\n","    REFERENCE_CRS\n",")\n","\n","if np.isfinite(water_area_km2):\n","\n","    print(\n","        f\"\\nPredicted water area: \"\n","        f\"{water_area_km2:.4f} km²\"\n","    )\n","\n","\n","# ------------------------------------------------------------\n","# 24. EXPORT GEOTIFF RESULTS\n","# ------------------------------------------------------------\n","\n","def export_geotiff(\n","    path,\n","    array,\n","    profile,\n","    dtype\n","):\n","\n","    out_profile = profile.copy()\n","\n","    out_profile.update(\n","        {\n","            \"count\": 1,\n","            \"dtype\": dtype,\n","            \"compress\": \"deflate\"\n","        }\n","    )\n","\n","    with rasterio.open(\n","        path,\n","        \"w\",\n","        **out_profile\n","    ) as dst:\n","\n","        dst.write(\n","            array.astype(dtype),\n","            1\n","        )\n","\n","\n","reference_profile = load_raster(\n","    uploaded_paths[0]\n",")[2]\n","\n","export_geotiff(\n","    \"predicted_water_probability.tif\",\n","    probability_map,\n","    reference_profile,\n","    \"float32\"\n",")\n","\n","export_geotiff(\n","    \"predicted_water_mask.tif\",\n","    water_mask,\n","    reference_profile,\n","    \"uint8\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 25. SAVE MODEL + METADATA\n","# ------------------------------------------------------------\n","\n","model.save(\n","    \"best_unet.keras\"\n",")\n","\n","metadata = {\n","    \"model\": \"Improved_MultiTemporal_UNet\",\n","    \"input_timesteps\": INPUT_TIMESTEPS,\n","    \"patch_size\": PATCH_SIZE,\n","    \"stride\": STRIDE,\n","    \"training_sequences\": len(train_sequences),\n","    \"validation_sequences\": len(val_sequences),\n","    \"training_patches\": int(len(X_train)),\n","    \"validation_patches\": int(len(X_val)),\n","    \"prediction_threshold\": PREDICTION_THRESHOLD,\n","    \"latest_input_files\": [\n","        r[\"path\"]\n","        for r in records[-INPUT_TIMESTEPS:]\n","    ],\n","    \"otsu_thresholds\": {\n","        os.path.basename(r[\"path\"]):\n","        (\n","            None\n","            if np.isnan(r[\"otsu_threshold\"])\n","            else float(r[\"otsu_threshold\"])\n","        )\n","        for r in records\n","    },\n","    \"predicted_water_area_km2\": (\n","        None\n","        if not np.isfinite(water_area_km2)\n","        else float(water_area_km2)\n","    )\n","}\n","\n","with open(\n","    \"model_metadata.json\",\n","    \"w\"\n",") as f:\n","    json.dump(\n","        metadata,\n","        f,\n","        indent=2\n","    )\n","\n","print(\"\\nSaved:\")\n","print(\"  best_unet.keras\")\n","print(\"  predicted_water_probability.tif\")\n","print(\"  predicted_water_mask.tif\")\n","print(\"  model_metadata.json\")\n","\n","\n","# ------------------------------------------------------------\n","# 26. SIMPLE FEATURE-MAP VISUALIZER\n","# ------------------------------------------------------------\n","# Shows what an early convolutional layer is learning.\n","\n","def visualize_feature_maps(\n","    model,\n","    sample\n","):\n","\n","    conv_layers = [\n","        layer\n","        for layer in model.layers\n","        if isinstance(\n","            layer,\n","            layers.Conv2D\n","        )\n","    ]\n","\n","    if not conv_layers:\n","        print(\n","            \"No Conv2D layers found.\"\n","        )\n","        return\n","\n","    feature_model = models.Model(\n","        inputs=model.input,\n","        outputs=conv_layers[0].output\n","    )\n","\n","    activation = feature_model.predict(\n","        sample[None, ...],\n","        verbose=0\n","    )[0]\n","\n","    number_maps = min(\n","        activation.shape[-1],\n","        16\n","    )\n","\n","    plt.figure(\n","        figsize=(12, 10)\n","    )\n","\n","    for i in range(\n","        number_maps\n","    ):\n","\n","        plt.subplot(\n","            4,\n","            4,\n","            i + 1\n","        )\n","\n","        plt.imshow(\n","            activation[..., i],\n","            cmap=\"gray\"\n","        )\n","\n","        plt.title(\n","            f\"Feature {i + 1}\"\n","        )\n","\n","        plt.axis(\"off\")\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n","\n","# sample = np.stack(\n","#     [\n","#         r[\"normalized\"]\n","#         for r in records[-INPUT_TIMESTEPS:]\n","#     ],\n","#     axis=-1\n","# )\n","\n","# visualize_feature_maps(\n","#     model,\n","#     sample\n","# )\n","\n","print(\"\\nFinished.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"bvF7jRpfNLRa","executionInfo":{"status":"error","timestamp":1787064860826,"user_tz":-330,"elapsed":2552061,"user":{"displayName":"Naturesworld","userId":"00808670514782698905"}},"outputId":"5b8f1b9c-57f3-4441-ed3c-2095f4aa12e6"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Upload chronological NDWI GeoTIFF files.\n","Example:\n","  2022_Jan_Apr.tif\n","  2022_May_Aug.tif\n","  2022_Sep_Dec.tif\n","  2023_Jan_Apr.tif\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","     <input type=\"file\" id=\"files-1d0f4502-cbaf-4c3c-9813-c82a5db72ee5\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-1d0f4502-cbaf-4c3c-9813-c82a5db72ee5\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saving NDWI_JAN_APR_22.tif to NDWI_JAN_APR_22 (1).tif\n","Saving NDWI_SEP_DEC_25.tif to NDWI_SEP_DEC_25.tif\n","Saving NDWI_MAY_AUG_25.tif to NDWI_MAY_AUG_25.tif\n","Saving NDWI_JAN_APR_25.tif to NDWI_JAN_APR_25.tif\n","Saving NDWI_MAY_AUG_24.tif to NDWI_MAY_AUG_24.tif\n","Saving NDWI_JAN_APR_24.tif to NDWI_JAN_APR_24.tif\n","Saving NDWI_SEP_DEC_23.tif to NDWI_SEP_DEC_23.tif\n","Saving NDWI_MAY_AUG_23.tif to NDWI_MAY_AUG_23.tif\n","Saving NDWI_JAN_APR_23.