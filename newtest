\n        \"num_unique_values\": 1,\n        \"samples\": [\n          0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Otsu_threshold\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.0,\n        \"min\": -0.22221077932044864,\n        \"max\": -0.22221077932044864,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          -0.22221077932044864\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["\n","    async function download(id, filename, size) {\n","      if (!google.colab.kernel.accessAllowed) {\n","        return;\n","      }\n","      const div = document.createElement('div');\n","      const label = document.createElement('label');\n","      label.textContent = `Downloading \"${filename}\": `;\n","      div.appendChild(label);\n","      const progress = document.createElement('progress');\n","      progress.max = size;\n","      div.appendChild(progress);\n","      document.body.appendChild(div);\n","\n","      const buffers = [];\n","      let downloaded = 0;\n","\n","      const channel = await google.colab.kernel.comms.open(id);\n","      // Send a message to notify the kernel that we're ready.\n","      channel.send({})\n","\n","      for await (const message of channel.messages) {\n","        // Send a message to notify the kernel that we're ready.\n","        channel.send({})\n","        if (message.buffers) {\n","          for (const buffer of message.buffers) {\n","            buffers.push(buffer);\n","            downloaded += buffer.byteLength;\n","            progress.value = downloaded;\n","          }\n","        }\n","      }\n","      const blob = new Blob(buffers, {type: 'application/binary'});\n","      const a = document.createElement('a');\n","      a.href = window.URL.createObjectURL(blob);\n","      a.download = filename;\n","      div.appendChild(a);\n","      a.click();\n","      div.remove();\n","    }\n","  "]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["download(\"download_59f58d1b-197d-49c7-a146-15d8bcb5c887\", \"NDWI_MAY_AUG_22_pixel_dataset.csv\", 578610)"]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","\n","============================================================\n","FINAL SUMMARY\n","============================================================\n","File                    : NDWI_MAY_AUG_22.tif\n","Total pixels            : 15714\n","Valid pixels            : 7991\n","Water pixels            : 4345\n","Non-water pixels        : 3646\n","Minimum NDWI            : -0.8259310722\n","Maximum NDWI            : 0.3063209057\n","Otsu NDWI threshold     : -0.2222107793\n","Pixel resolution        : 8.98315360824157e-05 × 8.983153086419803e-05\n","Water area              : 0.00000000 km²\n","============================================================\n"]}],"source":["# ============================================================\n","# NDWI OTSU THRESHOLDING + WATER AREA ANALYSIS\n","#\n","# Outputs:\n","# 1. Original NDWI Image\n","# 2. NDWI Histogram\n","# 3. Binary Water / Non-Water Image\n","# 4. Histogram with Otsu Threshold\n","# 5. Pixel counts\n","# 6. Actual TIFF pixel resolution\n","# 7. Water area in m² and km²\n","#\n","# IMPORTANT:\n","# - Original NDWI values are preserved\n","# - No 0-255 conversion\n","# - No fixed 0-1 range\n","# - No fixed histogram range\n","# - No fixed spatial resolution\n","# - NoData pixels are excluded\n","# ============================================================\n","\n","\n","# ------------------------------------------------------------\n","# 1. INSTALL REQUIRED LIBRARIES\n","# ------------------------------------------------------------\n","\n","!pip install rasterio scikit-image matplotlib pandas -q\n","\n","\n","# ------------------------------------------------------------\n","# 2. IMPORT LIBRARIES\n","# ------------------------------------------------------------\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import rasterio\n","import pandas as pd\n","\n","from skimage.filters import threshold_otsu\n","from google.colab import files\n","\n","\n","# ------------------------------------------------------------\n","# 3. UPLOAD TIFF\n","# ------------------------------------------------------------\n","\n","print(\"Upload your NDWI TIFF file\")\n","\n","uploaded = files.upload()\n","\n","tif_files = [\n","    f for f in uploaded.keys()\n","    if f.lower().endswith((\".tif\", \".tiff\"))\n","]\n","\n","if len(tif_files) == 0:\n","    raise ValueError(\"No TIFF file was uploaded.\")\n","\n","print(\"\\nUploaded TIFF file:\")\n","for f in tif_files:\n","    print(f)\n","\n","\n","# ------------------------------------------------------------\n","# 4. PROCESS EACH TIFF\n","# ------------------------------------------------------------\n","\n","for image_path in tif_files:\n","\n","    print(\"\\n\")\n","    print(\"=\" * 60)\n","    print(\"PROCESSING:\", image_path)\n","    print(\"=\" * 60)\n","\n","\n","    # --------------------------------------------------------\n","    # 5. READ TIFF\n","    # --------------------------------------------------------\n","\n","    with rasterio.open(image_path) as src:\n","\n","        image = src.read(1).astype(np.float64)\n","\n","        nodata = src.nodata\n","\n","        width = src.width\n","        height = src.height\n","\n","        transform = src.transform\n","        crs = src.crs\n","\n","        # Actual pixel resolution from TIFF\n","        pixel_width = abs(src.transform.a)\n","        pixel_height = abs(src.transform.e)\n","\n","\n","    # --------------------------------------------------------\n","    # 6. CREATE VALID PIXEL MASK\n","    # --------------------------------------------------------\n","\n","    valid_mask = np.isfinite(image)\n","\n","    if nodata is not None:\n","        valid_mask &= (image != nodata)\n","\n","\n","    # Original NDWI values only\n","    valid_pixels = image[valid_mask]\n","\n","\n","    if len(valid_pixels) == 0:\n","        raise ValueError(\"No valid pixels found in the TIFF.\")\n","\n","\n","    # --------------------------------------------------------\n","    # 7. IMAGE INFORMATION\n","    # --------------------------------------------------------\n","\n","    total_pixels = image.size\n","    valid_pixel_count = len(valid_pixels)\n","\n","    min_ndwi = np.min(valid_pixels)\n","    max_ndwi = np.max(valid_pixels)\n","    mean_ndwi = np.mean(valid_pixels)\n","\n","\n","    print(\"\\nIMAGE INFORMATION\")\n","    print(\"-\" * 40)\n","\n","    print(f\"Image width             : {width} pixels\")\n","    print(f\"Image height            : {height} pixels\")\n","    print(f\"Total pixels            : {total_pixels}\")\n","    print(f\"Valid pixels            : {valid_pixel_count}\")\n","\n","    print(f\"Minimum NDWI            : {min_ndwi:.10f}\")\n","    print(f\"Maximum NDWI            : {max_ndwi:.10f}\")\n","    print(f\"Mean NDWI               : {mean_ndwi:.10f}\")\n","\n","    print(f\"Pixel width             : {pixel_width}\")\n","    print(f\"Pixel height            : {pixel_height}\")\n","\n","    print(f\"CRS                     : {crs}\")\n","\n","\n","    # --------------------------------------------------------\n","    # 8. OTSU THRESHOLD\n","    #\n","    # IMPORTANT:\n","    # threshold_otsu() receives the ORIGINAL NDWI values.\n","    #\n","    # No:\n","    # 0-255 conversion\n","    # 0-1 normalization\n","    # fixed threshold\n","    # --------------------------------------------------------\n","\n","    otsu_threshold = threshold_otsu(valid_pixels)\n","\n","\n","    print(\"\\nOTSU RESULT\")\n","    print(\"-\" * 40)\n","\n","    print(\n","        f\"Otsu NDWI threshold     : \"\n","        f\"{otsu_threshold:.10f}\"\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # 9. CREATE BINARY WATER IMAGE\n","    #\n","    # Water:\n","    # NDWI >= Otsu threshold\n","    #\n","    # Non-water:\n","    # NDWI < Otsu threshold\n","    #\n","    # NoData remains 0.\n","    # --------------------------------------------------------\n","\n","    binary_image = np.zeros(\n","        image.shape,\n","        dtype=np.uint8\n","    )\n","\n","\n","    water_mask = (\n","        valid_mask &\n","        (image >= otsu_threshold)\n","    )\n","\n","\n","    non_water_mask = (\n","        valid_mask &\n","        (image < otsu_threshold)\n","    )\n","\n","\n","    binary_image[water_mask] = 255\n","    binary_image[non_water_mask] = 0\n","\n","\n","    # --------------------------------------------------------\n","    # 10. COUNT PIXELS\n","    # --------------------------------------------------------\n","\n","    water_pixel_count = np.sum(water_mask)\n","\n","    non_water_pixel_count = np.sum(non_water_mask)\n","\n","    excluded_pixel_count = (\n","        total_pixels -\n","        valid_pixel_count\n","    )\n","\n","\n","    print(\"\\nPIXEL CLASSIFICATION\")\n","    print(\"-\" * 40)\n","\n","    print(\n","        f\"Water pixels            : \"\n","        f\"{water_pixel_count}\"\n","    )\n","\n","    print(\n","        f\"Non-water pixels        : \"\n","        f\"{non_water_pixel_count}\"\n","    )\n","\n","    print(\n","        f\"NoData / invalid pixels : \"\n","        f\"{excluded_pixel_count}\"\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # 11. CALCULATE ACTUAL PIXEL AREA\n","    # --------------------------------------------------------\n","\n","    pixel_area_m2 = (\n","        pixel_width *\n","        pixel_height\n","    )\n","\n","    pixel_area_km2 = (\n","        pixel_area_m2 /\n","        1_000_000\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # 12. WATER AREA\n","    # --------------------------------------------------------\n","\n","    water_area_m2 = (\n","        water_pixel_count *\n","        pixel_area_m2\n","    )\n","\n","    water_area_km2 = (\n","        water_pixel_count *\n","        pixel_area_km2\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # 13. NON-WATER AREA\n","    # --------------------------------------------------------\n","\n","    non_water_area_m2 = (\n","        non_water_pixel_count *\n","        pixel_area_m2\n","    )\n","\n","    non_water_area_km2 = (\n","        non_water_pixel_count *\n","        pixel_area_km2\n","    )\n","\n","\n","    print(\"\\nAREA CALCULATION\")\n","    print(\"-\" * 40)\n","\n","    print(\n","        f\"Area of one pixel       : \"\n","        f\"{pixel_area_m2:.4f} m²\"\n","    )\n","\n","    print(\n","        f\"Water area              : \"\n","        f\"{water_area_m2:.4f} m²\"\n","    )\n","\n","    print(\n","        f\"Water area              : \"\n","        f\"{water_area_km2:.8f} km²\"\n","    )\n","\n","    print(\n","        f\"Non-water area          : \"\n","        f\"{non_water_area_m2:.4f} m²\"\n","    )\n","\n","    print(\n","        f\"Non-water area          : \"\n","        f\"{non_water_area_km2:.8f} km²\"\n","    )\n","\n","\n","    # ========================================================\n","    # 14. HISTOGRAM\n","    # ========================================================\n","\n","    # Let NumPy determine the histogram bins from\n","    # the actual NDWI data.\n","    histogram_bins = \"auto\"\n","\n","\n","    # ========================================================\n","    # 15. CREATE FOUR REQUIRED OUTPUTS\n","    # ========================================================\n","\n","    fig, axes = plt.subplots(\n","        2,\n","        2,\n","        figsize=(16, 12)\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # IMAGE 1 — ORIGINAL NDWI IMAGE\n","    # --------------------------------------------------------\n","\n","    original_display = np.where(\n","        valid_mask,\n","        image,\n","        np.nan\n","    )\n","\n","\n","    im1 = axes[0, 0].imshow(\n","        original_display,\n","        cmap=\"gray\"\n","    )\n","\n","\n","    axes[0, 0].set_title(\n","        \"Original NDWI Image\"\n","    )\n","\n","    axes[0, 0].set_xlabel(\n","        \"Column\"\n","    )\n","\n","    axes[0, 0].set_ylabel(\n","        \"Row\"\n","    )\n","\n","\n","    fig.colorbar(\n","        im1,\n","        ax=axes[0, 0],\n","        label=\"NDWI\"\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # IMAGE 2 — NDWI HISTOGRAM\n","    # --------------------------------------------------------\n","\n","    axes[0, 1].hist(\n","        valid_pixels,\n","        bins=histogram_bins\n","    )\n","\n","\n","    axes[0, 1].set_title(\n","        \"NDWI Histogram\"\n","    )\n","\n","    axes[0, 1].set_xlabel(\n","        \"NDWI Value\"\n","    )\n","\n","    axes[0, 1].set_ylabel(\n","        \"Pixel Count\"\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # IMAGE 3 — BINARY IMAGE\n","    # --------------------------------------------------------\n","\n","    axes[1, 0].imshow(\n","        binary_image,\n","        cmap=\"gray\",\n","        vmin=0,\n","        vmax=255\n","    )\n","\n","\n","    axes[1, 0].set_title(\n","        f\"Binary Water Image\\n\"\n","        f\"Otsu Threshold = \"\n","        f\"{otsu_threshold:.6f}\"\n","    )\n","\n","    axes[1, 0].set_xlabel(\n","        \"Column\"\n","    )\n","\n","    axes[1, 0].set_ylabel(\n","        \"Row\"\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # IMAGE 4 — HISTOGRAM + OTSU\n","    # --------------------------------------------------------\n","\n","    axes[1, 1].hist(\n","        valid_pixels,\n","        bins=histogram_bins\n","    )\n","\n","\n","    axes[1, 1].axvline(\n","        otsu_threshold,\n","        linestyle=\"--\",\n","        linewidth=2,\n","        label=(\n","            f\"Otsu = \"\n","            f\"{otsu_threshold:.6f}\"\n","        )\n","    )\n","\n","\n","    axes[1, 1].set_title(\n","        \"NDWI Histogram with Otsu Threshold\"\n","    )\n","\n","    axes[1, 1].set_xlabel(\n","        \"NDWI Value\"\n","    )\n","\n","    axes[1, 1].set_ylabel(\n","        \"Pixel Count\"\n","    )\n","\n","    axes[1, 1].legend()\n","\n","\n","    plt.suptitle(\n","        f\"NDWI Otsu Analysis\\n{image_path}\",\n","        fontsize=16\n","    )\n","\n","\n","    plt.tight_layout()\n","\n","    plt.show()\n","\n","\n","    # --------------------------------------------------------\n","    # 16. CREATE PIXEL DATASET\n","    # --------------------------------------------------------\n","\n","    rows, columns = np.where(valid_mask)\n","\n","\n","    dataset = pd.DataFrame({\n","\n","        \"image\":\n","            image_path,\n","\n","        \"row\":\n","            rows,\n","\n","        \"column\":\n","            columns,\n","\n","        \"NDWI\":\n","            image[valid_mask],\n","\n","        \"water\":\n","            water_mask[valid_mask].astype(int),\n","\n","        \"binary_value\":\n","            binary_image[valid_mask],\n","\n","        \"Otsu_threshold\":\n","            otsu_threshold\n","\n","    })\n","\n","\n","    # --------------------------------------------------------\n","    # 17. SAVE PIXEL DATASET\n","    # --------------------------------------------------------\n","\n","    dataset_filename = (\n","        image_path.rsplit(\".\", 1)[0]\n","        + \"_pixel_dataset.csv\"\n","    )\n","\n","\n","    dataset.to_csv(\n","        dataset_filename,\n","        index=False\n","    )\n","\n","\n","    print(\"\\nPIXEL DATASET\")\n","    print(\"-\" * 40)\n","\n","    print(\n","        \"Dataset saved as:\",\n","        dataset_filename\n","    )\n","\n","    print(\n","        \"Dataset rows:\",\n","        len(dataset)\n","    )\n","\n","\n","    print(\"\\nFirst 10 pixels:\")\n","\n","    display(\n","        dataset.head(10)\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # 18. DOWNLOAD DATASET\n","    # --------------------------------------------------------\n","\n","    files.download(\n","        dataset_filename\n","    )\n","\n","\n","    # --------------------------------------------------------\n","    # 19. FINAL SUMMARY\n","    # --------------------------------------------------------\n","\n","    print(\"\\n\")\n","    print(\"=\" * 60)\n","    print(\"FINAL SUMMARY\")\n","    print(\"=\" * 60)\n","\n","    print(f\"File                    : {image_path}\")\n","    print(f\"Total pixels            : {total_pixels}\")\n","    print(f\"Valid pixels            : {valid_pixel_count}\")\n","    print(f\"Water pixels            : {water_pixel_count}\")\n","    print(f\"Non-water pixels        : {non_water_pixel_count}\")\n","\n","    print(\n","        f\"Minimum NDWI            : \"\n","        f\"{min_ndwi:.10f}\"\n","    )\n","\n","    print(\n","        f\"Maximum NDWI            : \"\n","        f\"{max_ndwi:.10f}\"\n","    )\n","\n","    print(\n","        f\"Otsu NDWI threshold     : \"\n","        f\"{otsu_threshold:.10f}\"\n","    )\n","\n","    print(\n","        f\"Pixel resolution        : \"\n","        f\"{pixel_width} × {pixel_height}\"\n","    )\n","\n","    print(\n","        f\"Water area              : \"\n","        f\"{water_area_km2:.8f} km²\"\n","    )\n","\n","    print(\"=\" * 60)"]},{"cell_type":"code","source":["# ============================================================\n","# NDWI -> OTSU -> PIXEL ANALYSIS -> 3D RELATIVE DEPTH MODEL\n","#\n","# INPUT:\n","#   .tif\n","#   .xml / .aux.xml\n","#\n","# OUTPUT:\n","#   1. TIFF information\n","#   2. XML information\n","#   3. Original NDWI image\n","#   4. NDWI histogram\n","#   5. Otsu threshold\n","#   6. Binary water mask\n","#   7. Water area\n","#   8. Pixel-by-pixel CSV\n","#   9. 3D NDWI surface\n","#  10. 3D relative-depth surface\n","#\n","# IMPORTANT:\n","# Relative depth is NOT physical depth in metres.\n","# Actual depth requires measured/calibrated depth data.\n","# ============================================================\n","\n","\n","# ============================================================\n","# 1. INSTALL\n","# ============================================================\n","\n","!pip install rasterio scikit-image matplotlib pandas -q\n","\n","\n","# ============================================================\n","# 2. IMPORTS\n","# ============================================================\n","\n","import os\n","import re\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import rasterio\n","import xml.etree.ElementTree as ET\n","\n","from skimage.filters import threshold_otsu\n","from google.colab import files\n","\n","from mpl_toolkits.mplot3d import Axes3D\n","\n","\n","# ============================================================\n","# 3. UPLOAD TIFF + XML\n","# ============================================================\n","\n","print(\"Upload your TIFF and matching XML/AUX.XML file.\")\n","print()\n","print(\"Example:\")\n","print(\"  NDWI_JAN_APR_22.tif\")\n","print(\"  NDWI_JAN_APR_22.tif.aux.xml\")\n","\n","uploaded = files.upload()\n","\n","uploaded_files = list(uploaded.keys())\n","\n","print(\"\\nUploaded files:\")\n","for f in uploaded_files:\n","    print(\"  \", f)\n","\n","\n","# ============================================================\n","# 4. FIND TIFF\n","# ============================================================\n","\n","tif_files = [\n","    f for f in uploaded_files\n","    if f.lower().endswith((\".tif\", \".tiff\"))\n","]\n","\n","if len(tif_files) == 0:\n","    raise ValueError(\n","        \"No TIFF file found. Please upload a .tif file.\"\n","    )\n","\n","tif_path = tif_files[0]\n","\n","print(\"\\nUsing TIFF:\")\n","print(tif_path)\n","\n","\n","# ============================================================\n","# 5. FIND XML\n","# ============================================================\n","\n","xml_files = [\n","    f for f in uploaded_files\n","    if f.lower().endswith(\".xml\")\n","]\n","\n","xml_path = None\n","\n","# First try to find matching XML\n","for f in xml_files:\n","\n","    tif_base = os.path.basename(tif_path)\n","\n","    if tif_base in f:\n","        xml_path = f\n","        break\n","\n","\n","# If exact match not found, use first XML\n","if xml_path is None and len(xml_files) > 0:\n","    xml_path = xml_files[0]\n","\n","\n","print(\"\\nXML file:\")\n","\n","if xml_path is not None:\n","    print(xml_path)\n","else:\n","    print(\"No XML uploaded.\")\n","\n","\n","# ============================================================\n","# 6. READ TIFF\n","# ============================================================\n","\n","with rasterio.open(tif_path) as src:\n","\n","    image = src.read(1).astype(np.float64)\n","\n","    nodata = src.nodata\n","\n","    width = src.width\n","    height = src.height\n","\n","    count = src.count\n","\n","    dtype = src.dtypes[0]\n","\n","    crs = src.crs\n","\n","    transform = src.transform\n","\n","    pixel_width = abs(transform.a)\n","    pixel_height = abs(transform.e)\n","\n","    bounds = src.bounds\n","\n","\n","# ============================================================\n","# 7. VALID PIXELS\n","# ============================================================\n","\n","valid_mask = np.isfinite(image)\n","\n","if nodata is not None:\n","    valid_mask &= (image != nodata)\n","\n","valid_pixels = image[valid_mask]\n","\n","\n","if len(valid_pixels) == 0:\n","\n","    raise ValueError(\n","        \"The TIFF contains no valid pixels.\"\n","    )\n","\n","\n","# ============================================================\n","# 8. BASIC TIFF INFORMATION\n","# ============================================================\n","\n","minimum = np.min(valid_pixels)\n","maximum = np.max(valid_pixels)\n","mean = np.mean(valid_pixels)\n","median = np.median(valid_pixels)\n","std = np.std(valid_pixels)\n","\n","total_pixels = image.size\n","valid_count = len(valid_pixels)\n","invalid_count = total_pixels - valid_count\n","\n","\n","print(\"\\n\")\n","print(\"=\" * 70)\n","print(\"                 TIFF INFORMATION\")\n","print(\"=\" * 70)\n","\n","print(f\"File name              : {tif_path}\")\n","print(f\"Width                  : {width} pixels\")\n","print(f\"Height                 : {height} pixels\")\n","print(f\"Total pixels           : {total_pixels}\")\n","print(f\"Valid pixels           : {valid_count}\")\n","print(f\"Invalid / NoData       : {invalid_count}\")\n","\n","print(f\"Data type              : {dtype}\")\n","print(f\"Number of bands        : {count}\")\n","\n","print(f\"Minimum NDWI           : {minimum:.12f}\")\n","print(f\"Maximum NDWI           : {maximum:.12f}\")\n","print(f\"Mean NDWI              : {mean:.12f}\")\n","print(f\"Median NDWI            : {median:.12f}\")\n","print(f\"Standard deviation     : {std:.12f}\")\n","\n","print(f\"Pixel width            : {pixel_width}\")\n","print(f\"Pixel height           : {pixel_height}\")\n","\n","print(f\"CRS                    : {crs}\")\n","\n","print(f\"Bounds                 : {bounds}\")\n","\n","print(\"=\" * 70)\n","\n","\n","# ============================================================\n","# 9. READ XML\n","# ============================================================\n","\n","xml_values = {}\n","\n","if xml_path is not None:\n","\n","    print(\"\\n\")\n","    print(\"=\" * 70)\n","    print(\"                    XML INFORMATION\")\n","    print(\"=\" * 70)\n","\n","    try:\n","\n","        tree = ET.parse(xml_path)\n","        root = tree.getroot()\n","\n","        # Read all MDI key/value pairs\n","        for element in root.iter():\n","\n","            key = element.attrib.get(\"key\")\n","\n","            if key is not None:\n","\n","                value = element.text\n","\n","                if value is not None:\n","\n","                    xml_values[key] = value.strip()\n","\n","\n","        if len(xml_values) > 0:\n","\n","            for key, value in xml_values.items():\n","\n","                print(\n","                    f\"{key:30s}: {value}\"\n","                )\n","\n","        else:\n","\n","            print(\n","                \"XML file was read, but no MDI \"\n","                \"statistics were found.\"\n","            )\n","\n","    except Exception as e:\n","\n","        print(\n","            \"Could not parse XML:\",\n","            e\n","        )\n","\n","else:\n","\n","    print(\"\\nNo XML file available.\")\n","\n","\n","print(\"=\" * 70)\n","\n","\n","# ============================================================\n","# 10. OTSU THRESHOLD\n","# ============================================================\n","\n","otsu_threshold = threshold_otsu(\n","    valid_pixels\n",")\n","\n","\n","print(\"\\n\")\n","print(\"=\" * 70)\n","print(\"                    OTSU ANALYSIS\")\n","print(\"=\" * 70)\n","\n","print(\n","    f\"Otsu NDWI threshold   : \"\n","    f\"{otsu_threshold:.12f}\"\n",")\n","\n","print(\n","    f\"Water condition       : \"\n","    f\"NDWI >= {otsu_threshold:.12f}\"\n",")\n","\n","print(\n","    f\"Non-water condition   : \"\n","    f\"NDWI < {otsu_threshold:.12f}\"\n",")\n","\n","print(\"=\" * 70)\n","\n","\n","# ============================================================\n","# 11. WATER / NON-WATER MASK\n","# ============================================================\n","\n","water_mask = (\n","    valid_mask &\n","    (image >= otsu_threshold)\n",")\n","\n","non_water_mask = (\n","    valid_mask &\n","    (image < otsu_threshold)\n",")\n","\n","\n","water_count = np.sum(water_mask)\n","\n","non_water_count = np.sum(non_water_mask)\n","\n","\n","# ============================================================\n","# 12. BINARY IMAGE\n","# ============================================================\n","\n","binary_image = np.zeros_like(\n","    image,\n","    dtype=np.uint8\n",")\n","\n","binary_image[water_mask] = 255\n","\n","\n","# ============================================================\n","# 13. AREA\n","# ============================================================\n","\n","pixel_area_m2 = (\n","    pixel_width *\n","    pixel_height\n",")\n","\n","water_area_m2 = (\n","    water_count *\n","    pixel_area_m2\n",")\n","\n","water_area_km2 = (\n","    water_area_m2 /\n","    1_000_000\n",")\n","\n","non_water_area_m2 = (\n","    non_water_count *\n","    pixel_area_m2\n",")\n","\n","non_water_area_km2 = (\n","    non_water_area_m2 /\n","    1_000_000\n",")\n","\n","\n","print(\"\\n\")\n","print(\"=\" * 70)\n","print(\"                  WATER AREA\")\n","print(\"=\" * 70)\n","\n","print(\n","    f\"Water pixels          : \"\n","    f\"{water_count}\"\n",")\n","\n","print(\n","    f\"Non-water pixels      : \"\n","    f\"{non_water_count}\"\n",")\n","\n","print(\n","    f\"Pixel area            : \"\n","    f\"{pixel_area_m2:.4f} m²\"\n",")\n","\n","print(\n","    f\"Water area            : \"\n","    f\"{water_area_m2:.4f} m²\"\n",")\n","\n","print(\n","    f\"Water area            : \"\n","    f\"{water_area_km2:.8f} km²\"\n",")\n","\n","print(\n","    f\"Non-water area        : \"\n","    f\"{non_water_area_m2:.4f} m²\"\n",")\n","\n","print(\n","    f\"Non-water area        : \"\n","    f\"{non_water_area_km2:.8f} km²\"\n",")\n","\n","print(\"=\" * 70)\n","\n","\n","# ============================================================\n","# 14. CREATE RELATIVE DEPTH MODEL\n","# ============================================================\n","#\n","# IMPORTANT:\n","#\n","# This is NOT physical water depth.\n","#\n","# We create a relative water-depth index:\n","#\n","# minimum water NDWI -> 0\n","# maximum water NDWI -> 1\n","#\n","# It represents relative position within the detected\n","# water-NDWI range.\n","# ============================================================\n","\n","relative_depth = np.full(\n","    image.shape,\n","    np.nan,\n","    dtype=np.float64\n",")\n","\n","water_ndwi = image[water_mask]\n","\n","\n","if len(water_ndwi) > 0:\n","\n","    water_min = np.min(water_ndwi)\n","    water_max = np.max(water_ndwi)\n","\n","    if water_max > water_min:\n","\n","        relative_depth[water_mask] = (\n","            (image[water_mask] - water_min)\n","            /\n","            (water_max - water_min)\n","        )\n","\n","    else:\n","\n","        relative_depth[water_mask] = 0.0\n","\n","\n","print(\"\\n\")\n","print(\"=\" * 70)\n","print(\"              RELATIVE DEPTH MODEL\")\n","print(\"=\" * 70)\n","\n","if len(water_ndwi) > 0:\n","\n","    print(\n","        f\"Minimum water NDWI    : \"\n","        f\"{water_min:.12f}\"\n","    )\n","\n","    print(\n","        f\"Maximum water NDWI    : \"\n","        f\"{water_max:.12f}\"\n","    )\n","\n","    print(\n","        \"Relative depth range  : 0 to 1\"\n","    )\n","\n","    print()\n","    print(\n","        \"0 = lowest NDWI within detected water\"\n","    )\n","\n","    print(\n","        \"1 = highest NDWI within detected water\"\n","    )\n","\n","print()\n","print(\n","    \"WARNING: This is a relative NDWI-derived \"\n","    \"depth proxy, NOT metres.\"\n",")\n","\n","print(\"=\" * 70)\n","\n","\n","# ============================================================\n","# 15. PIXEL-BY-PIXEL DATASET\n","# ============================================================\n","\n","rows, columns = np.where(valid_mask)\n","\n","\n","pixel_ndwi = image[\n","    valid_mask\n","]\n","\n","\n","pixel_water = water_mask[\n","    valid_mask\n","].astype(int)\n","\n","\n","pixel_relative_depth = relative_depth[\n","    valid_mask\n","]\n","\n","\n","# Coordinates\n","xs = []\n","ys = []\n","\n","\n","for row, col in zip(rows, columns):\n","\n","    x, y = rasterio.transform.xy(\n","        transform,\n","        row,\n","        col\n","    )\n","\n","    xs.append(x)\n","    ys.append(y)\n","\n","\n","dataset = pd.DataFrame({\n","\n","    \"row\":\n","        rows,\n","\n","    \"column\":\n","        columns,\n","\n","    \"x\":\n","        xs,\n","\n","    \"y\":\n","        ys,\n","\n","    \"NDWI\":\n","        pixel_ndwi,\n","\n","    \"water\":\n","        pixel_water,\n","\n","    \"relative_depth\":\n","        pixel_relative_depth,\n","\n","    \"Otsu_threshold\":\n","        otsu_threshold\n","\n","})\n","\n","\n","# ============================================================\n","# 16. DEPTH CLASS\n","# ============================================================\n","#\n","# Again:\n","# these are RELATIVE classes, not actual metres.\n","#\n","# 0 = Non-water\n","# 1 = Low relative depth\n","# 2 = Medium relative depth\n","# 3 = High relative depth\n","# ============================================================\n","\n","dataset[\"depth_class\"] = 0\n","\n","water_rows = (\n","    dataset[\"water\"] == 1\n",")\n","\n","\n","dataset.loc[\n","    water_rows &\n","    (dataset[\"relative_depth\"] < 0.333333),\n","    \"depth_class\"\n","] = 1\n","\n","\n","dataset.loc[\n","    water_rows &\n","    (dataset[\"relative_depth\"] >= 0.333333) &\n","    (dataset[\"relative_depth\"] < 0.666667),\n","    \"depth_class\"\n","] = 2\n","\n","\n","dataset.loc[\n","    water_rows &\n","    (dataset[\"relative_depth\"] >= 0.666667),\n","    \"depth_class\"\n","] = 3\n","\n","\n","dataset[\"depth_label\"] = dataset[\n","    \"depth_class\"\n","].map({\n","\n","    0: \"Non-water\",\n","\n","    1: \"Low relative depth\",\n","\n","    2: \"Medium relative depth\",\n","\n","    3: \"High relative depth\"\n","\n","})\n","\n","\n","# ============================================================\n","# 17. DISPLAY DATASET\n","# ============================================================\n","\n","print(\"\\n\")\n","print(\"=\" * 70)\n","print(\"                 PIXEL DATASET\")\n","print(\"=\" * 70)\n","\n","print(\n","    \"Number of dataset rows:\",\n","    len(dataset)\n",")\n","\n","display(\n","    dataset.head(20)\n",")\n","\n","\n","print(\"\\nDepth class distribution:\")\n","\n","print(\n","    dataset[\"depth_label\"].value_counts()\n",")\n","\n","\n","# ============================================================\n","# 18. SAVE CSV\n","# ============================================================\n","\n","csv_filename = (\n","    os.path.splitext(\n","        os.path.basename(tif_path)\n","    )[0]\n","    + \"_3D_pixel_depth_dataset.csv\"\n",")\n","\n","\n","dataset.to_csv(\n","    csv_filename,\n","    index=False\n",")\n","\n","\n","print(\"\\nCSV saved:\")\n","print(csv_filename)\n","\n","\n","# ============================================================\n","# 19. ORIGINAL NDWI IMAGE\n","# ============================================================\n","\n","plt.figure(\n","    figsize=(9, 7)\n",")\n","\n","display_image = np.where(\n","    valid_mask,\n","    image,\n","    np.nan\n",")\n","\n","plt.imshow(\n","    display_image,\n","    cmap=\"gray\"\n",")\n","\n","plt.colorbar(\n","    label=\"NDWI\"\n",")\n","\n","plt.title(\n","    \"Original NDWI Image\"\n",")\n","\n","plt.xlabel(\"Column\")\n","plt.ylabel(\"Row\")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 20. NDWI HISTOGRAM + OTSU\n","# ============================================================\n","\n","plt.figure(\n","    figsize=(10, 6)\n",")\n","\n","plt.hist(\n","    valid_pixels,\n","    bins=\"auto\"\n",")\n","\n","plt.axvline(\n","    otsu_threshold,\n","    linestyle=\"--\",\n","    linewidth=2,\n","    label=(\n","        f\"Otsu = \"\n","        f\"{otsu_threshold:.6f}\"\n","    )\n",")\n","\n","plt.xlabel(\n","    \"Original NDWI Value\"\n",")\n","\n","plt.ylabel(\n","    \"Pixel Count\"\n",")\n","\n","plt.title(\n","    \"NDWI Histogram with Otsu Threshold\"\n",")\n","\n","plt.legend()\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 21. BINARY WATER MAP\n","# ============================================================\n","\n","plt.figure(\n","    figsize=(9, 7)\n",")\n","\n","plt.imshow(\n","    binary_image,\n","    cmap=\"gray\",\n","    vmin=0,\n","    vmax=255\n",")\n","\n","plt.title(\n","    \"Otsu Binary Water / Non-Water Map\"\n",")\n","\n","plt.xlabel(\"Column\")\n","plt.ylabel(\"Row\")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 22. RELATIVE DEPTH MAP\n","# ============================================================\n","\n","plt.figure(\n","    figsize=(9, 7)\n",")\n","\n","plt.imshow(\n","    relative_depth,\n","    cmap=\"viridis\",\n","    vmin=0,\n","    vmax=1\n",")\n","\n","plt.colorbar(\n","    label=\"Relative Depth Index\"\n",")\n","\n","plt.title(\n","    \"Relative NDWI-Based Depth Map\"\n",")\n","\n","plt.xlabel(\"Column\")\n","plt.ylabel(\"Row\")\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 23. 3D NDWI SURFACE\n","# ============================================================\n","\n","Y, X = np.indices(\n","    image.shape\n",")\n","\n","\n","Z_ndwi = np.where(\n","    valid_mask,\n","    image,\n","    np.nan\n",")\n","\n","\n","fig = plt.figure(\n","    figsize=(14, 10)\n",")\n","\n","ax = fig.add_subplot(\n","    111,\n","    projection=\"3d\"\n",")\n","\n","\n","surface = ax.plot_surface(\n","    X,\n","    Y,\n","    Z_ndwi,\n","    cmap=\"viridis\",\n","    linewidth=0,\n","    antialiased=True\n",")\n","\n","\n","ax.set_title(\n","    \"3D NDWI Surface\"\n",")\