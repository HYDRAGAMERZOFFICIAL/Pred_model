: `;\n","      div.appendChild(label);\n","      const progress = document.createElement('progress');\n","      progress.max = size;\n","      div.appendChild(progress);\n","      document.body.appendChild(div);\n","\n","      const buffers = [];\n","      let downloaded = 0;\n","\n","      const channel = await google.colab.kernel.comms.open(id);\n","      // Send a message to notify the kernel that we're ready.\n","      channel.send({})\n","\n","      for await (const message of channel.messages) {\n","        // Send a message to notify the kernel that we're ready.\n","        channel.send({})\n","        if (message.buffers) {\n","          for (const buffer of message.buffers) {\n","            buffers.push(buffer);\n","            downloaded += buffer.byteLength;\n","            progress.value = downloaded;\n","          }\n","        }\n","      }\n","      const blob = new Blob(buffers, {type: 'application/binary'});\n","      const a = document.createElement('a');\n","      a.href = window.URL.createObjectURL(blob);\n","      a.download = filename;\n","      div.appendChild(a);\n","      a.click();\n","      div.remove();\n","    }\n","  "]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["download(\"download_fa25291a-3d9f-4201-a1a4-851a85cb0fef\", \"NDWI_JAN_APR_22 (1)_3D_pixel_depth_dataset.csv\", 925463)"]},"metadata":{}}]},{"cell_type":"code","source":["# ============================================================\n","# JAKKUR LAKE - PIXEL BASED CNN / U-NET\n","# NDWI TIFF -> OTSU MASK -> CNN SEGMENTATION\n","# ============================================================\n","\n","!pip install rasterio scikit-image tensorflow -q\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import rasterio\n","import tensorflow as tf\n","\n","from skimage.filters import threshold_otsu\n","from google.colab import files\n","\n","print(\"TensorFlow version:\", tf.__version__)\n","\n","\n","# ============================================================\n","# 1. UPLOAD NDWI TIFF\n","# ============================================================\n","\n","uploaded = files.upload()\n","\n","tif_files = [\n","    f for f in uploaded.keys()\n","    if f.lower().endswith((\".tif\", \".tiff\"))\n","]\n","\n","if not tif_files:\n","    raise ValueError(\"Please upload an NDWI TIFF file.\")\n","\n","image_path = tif_files[0]\n","\n","print(\"Uploaded:\", image_path)\n","\n","\n","# ============================================================\n","# 2. READ TIFF\n","# ============================================================\n","\n","with rasterio.open(image_path) as src:\n","\n","    ndwi = src.read(1).astype(np.float32)\n","\n","    nodata = src.nodata\n","\n","    profile = src.profile\n","\n","    transform = src.transform\n","\n","    crs = src.crs\n","\n","print(\"Image shape:\", ndwi.shape)\n","print(\"CRS:\", crs)\n","\n","\n","# ============================================================\n","# 3. VALID PIXELS\n","# ============================================================\n","\n","valid_mask = np.isfinite(ndwi)\n","\n","if nodata is not None:\n","    valid_mask &= ndwi != nodata\n","\n","valid_pixels = ndwi[valid_mask]\n","\n","print(\"Valid pixels:\", len(valid_pixels))\n","print(\"Minimum NDWI:\", valid_pixels.min())\n","print(\"Maximum NDWI:\", valid_pixels.max())\n","\n","\n","# ============================================================\n","# 4. OTSU THRESHOLD\n","# ============================================================\n","\n","otsu_threshold = threshold_otsu(\n","    valid_pixels\n",")\n","\n","print()\n","print(\"====================================\")\n","print(\"OTSU RESULT\")\n","print(\"====================================\")\n","print(\"Otsu NDWI threshold:\", otsu_threshold)\n","\n","\n","# ============================================================\n","# 5. CREATE WATER MASK\n","# ============================================================\n","\n","water_mask = (\n","    ndwi >= otsu_threshold\n",") & valid_mask\n","\n","\n","# CNN target:\n","#\n","# 0 = non-water\n","# 1 = water\n","\n","target_mask = water_mask.astype(\n","    np.float32\n",")\n","\n","\n","# ============================================================\n","# 6. NORMALIZE NDWI\n","# ============================================================\n","\n","min_ndwi = valid_pixels.min()\n","max_ndwi = valid_pixels.max()\n","\n","ndwi_normalized = np.zeros_like(\n","    ndwi,\n","    dtype=np.float32\n",")\n","\n","ndwi_normalized[valid_mask] = (\n","    (ndwi[valid_mask] - min_ndwi)\n","    /\n","    (max_ndwi - min_ndwi)\n",")\n","\n","\n","# Invalid pixels remain zero.\n","\n","\n","# ============================================================\n","# 7. CREATE CNN INPUT\n","# ============================================================\n","\n","# Add channel dimension\n","#\n","# Original:\n","#       H × W\n","#\n","# CNN:\n","#       H × W × 1\n","\n","X_image = ndwi_normalized[\n","    ..., np.newaxis\n","]\n","\n","Y_image = target_mask[\n","    ..., np.newaxis\n","]\n","\n","print()\n","print(\"CNN input shape :\", X_image.shape)\n","print(\"CNN target shape:\", Y_image.shape)\n","\n","\n","# ============================================================\n","# 8. CREATE PATCHES\n","# ============================================================\n","\n","PATCH_SIZE = 32\n","\n","STRIDE = 16\n","\n","\n","def create_patches(\n","    image,\n","    mask,\n","    patch_size=32,\n","    stride=16\n","):\n","\n","    X = []\n","    Y = []\n","\n","    height = image.shape[0]\n","    width = image.shape[1]\n","\n","    for row in range(\n","        0,\n","        height - patch_size + 1,\n","        stride\n","    ):\n","\n","        for col in range(\n","            0,\n","            width - patch_size + 1,\n","            stride\n","        ):\n","\n","            image_patch = image[\n","                row:row + patch_size,\n","                col:col + patch_size\n","            ]\n","\n","            mask_patch = mask[\n","                row:row + patch_size,\n","                col:col + patch_size\n","            ]\n","\n","            X.append(image_patch)\n","            Y.append(mask_patch)\n","\n","    return (\n","        np.array(X),\n","        np.array(Y)\n","    )\n","\n","\n","X, Y = create_patches(\n","    X_image,\n","    Y_image,\n","    PATCH_SIZE,\n","    STRIDE\n",")\n","\n","print()\n","print(\"====================================\")\n","print(\"PATCH DATASET\")\n","print(\"====================================\")\n","\n","print(\"X shape:\", X.shape)\n","print(\"Y shape:\", Y.shape)\n","\n","\n","# ============================================================\n","# 9. REMOVE EMPTY PATCHES\n","# ============================================================\n","\n","# Keep patches containing at least\n","# some water.\n","\n","water_fraction = Y.mean(\n","    axis=(1, 2, 3)\n",")\n","\n","keep = (\n","    water_fraction > 0\n",")\n","\n","X = X[keep]\n","Y = Y[keep]\n","\n","print()\n","print(\"Patches containing water:\", len(X))\n","\n","\n","# ============================================================\n","# 10. TRAIN / VALIDATION SPLIT\n","# ============================================================\n","\n","indices = np.arange(\n","    len(X)\n",")\n","\n","np.random.seed(42)\n","\n","np.random.shuffle(\n","    indices\n",")\n","\n","split = int(\n","    0.8 * len(indices)\n",")\n","\n","train_idx = indices[:split]\n","\n","val_idx = indices[split:]\n","\n","\n","X_train = X[train_idx]\n","Y_train = Y[train_idx]\n","\n","X_val = X[val_idx]\n","Y_val = Y[val_idx]\n","\n","\n","print()\n","print(\"Training samples  :\", len(X_train))\n","print(\"Validation samples:\", len(X_val))\n","\n","\n","# ============================================================\n","# 11. U-NET BLOCK\n","# ============================================================\n","\n","def conv_block(\n","    x,\n","    filters\n","):\n","\n","    x = tf.keras.layers.Conv2D(\n","        filters,\n","        3,\n","        padding=\"same\",\n","        activation=\"relu\"\n","    )(x)\n","\n","    x = tf.keras.layers.BatchNormalization()(x)\n","\n","    x = tf.keras.layers.Conv2D(\n","        filters,\n","        3,\n","        padding=\"same\",\n","        activation=\"relu\"\n","    )(x)\n","\n","    x = tf.keras.layers.BatchNormalization()(x)\n","\n","    return x\n","\n","\n","# ============================================================\n","# 12. BUILD U-NET\n","# ============================================================\n","\n","inputs = tf.keras.Input(\n","    shape=(\n","        PATCH_SIZE,\n","        PATCH_SIZE,\n","        1\n","    )\n",")\n","\n","\n","# ---------------- ENCODER ----------------\n","\n","c1 = conv_block(\n","    inputs,\n","    32\n",")\n","\n","p1 = tf.keras.layers.MaxPooling2D(\n","    2\n",")(c1)\n","\n","\n","c2 = conv_block(\n","    p1,\n","    64\n",")\n","\n","p2 = tf.keras.layers.MaxPooling2D(\n","    2\n",")(c2)\n","\n","\n","c3 = conv_block(\n","    p2,\n","    128\n",")\n","\n","p3 = tf.keras.layers.MaxPooling2D(\n","    2\n",")(c3)\n","\n","\n","# ---------------- BOTTLENECK ----------------\n","\n","b = conv_block(\n","    p3,\n","    256\n",")\n","\n","\n","# ---------------- DECODER ----------------\n","\n","u3 = tf.keras.layers.UpSampling2D(\n","    2\n",")(b)\n","\n","u3 = tf.keras.layers.Concatenate()(\n","    [u3, c3]\n",")\n","\n","c4 = conv_block(\n","    u3,\n","    128\n",")\n","\n","\n","u2 = tf.keras.layers.UpSampling2D(\n","    2\n",")(c4)\n","\n","u2 = tf.keras.layers.Concatenate()(\n","    [u2, c2]\n",")\n","\n","c5 = conv_block(\n","    u2,\n","    64\n",")\n","\n","\n","u1 = tf.keras.layers.UpSampling2D(\n","    2\n",")(c5)\n","\n","u1 = tf.keras.layers.Concatenate()(\n","    [u1, c1]\n",")\n","\n","c6 = conv_block(\n","    u1,\n","    32\n",")\n","\n","\n","# ============================================================\n","# 13. PIXEL-WISE OUTPUT\n","# ============================================================\n","\n","outputs = tf.keras.layers.Conv2D(\n","    1,\n","    1,\n","    activation=\"sigmoid\"\n",")(c6)\n","\n","\n","model = tf.keras.Model(\n","    inputs,\n","    outputs\n",")\n","\n","\n","# ============================================================\n","# 14. COMPILE\n","# ============================================================\n","\n","model.compile(\n","\n","    optimizer=tf.keras.optimizers.Adam(\n","        learning_rate=1e-3\n","    ),\n","\n","    loss=\"binary_crossentropy\",\n","\n","    metrics=[\n","        \"accuracy\"\n","    ]\n",")\n","\n","\n","model.summary()\n","\n","\n","# ============================================================\n","# 15. TRAIN CNN\n","# ============================================================\n","\n","history = model.fit(\n","\n","    X_train,\n","    Y_train,\n","\n","    validation_data=(\n","        X_val,\n","        Y_val\n","    ),\n","\n","    epochs=30,\n","\n","    batch_size=16,\n","\n","    verbose=1\n",")\n","\n","\n","# ============================================================\n","# 16. TRAINING GRAPH\n","# ============================================================\n","\n","plt.figure(\n","    figsize=(12, 5)\n",")\n","\n","plt.plot(\n","    history.history[\"loss\"],\n","    label=\"Training Loss\"\n",")\n","\n","plt.plot(\n","    history.history[\"val_loss\"],\n","    label=\"Validation Loss\"\n",")\n","\n","plt.xlabel(\"Epoch\")\n","\n","plt.ylabel(\"Loss\")\n","\n","plt.title(\n","    \"CNN Training / Validation Loss\"\n",")\n","\n","plt.legend()\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 17. TEST CNN ON VALIDATION PATCH\n","# ============================================================\n","\n","prediction = model.predict(\n","    X_val[:1]\n",")[0, :, :, 0]\n","\n","\n","# Convert probability to binary\n","prediction_binary = (\n","    prediction >= 0.5\n",")\n","\n","\n","# ============================================================\n","# 18. DISPLAY CNN RESULT\n","# ============================================================\n","\n","plt.figure(\n","    figsize=(15, 5)\n",")\n","\n","\n","plt.subplot(\n","    1, 3, 1\n",")\n","\n","plt.imshow(\n","    X_val[0, :, :, 0],\n","    cmap=\"gray\"\n",")\n","\n","plt.title(\n","    \"NDWI Input\"\n",")\n","\n","plt.axis(\"off\")\n","\n","\n","plt.subplot(\n","    1, 3, 2\n",")\n","\n","plt.imshow(\n","    Y_val[0, :, :, 0],\n","    cmap=\"gray\"\n",")\n","\n","plt.title(\n","    \"Otsu Target\"\n",")\n","\n","plt.axis(\"off\")\n","\n","\n","plt.subplot(\n","    1, 3, 3\n",")\n","\n","plt.imshow(\n","    prediction_binary,\n","    cmap=\"gray\"\n",")\n","\n","plt.title(\n","    \"CNN Prediction\"\n",")\n","\n","plt.axis(\"off\")\n","\n","\n","plt.tight_layout()\n","\n","plt.show()\n","\n","\n","# ============================================================\n","# 19. SAVE MODEL\n","# ============================================================\n","\n","model.save(\n","    \"jakkur_lake_unet.keras\"\n",")\n","\n","print()\n","print(\"CNN model saved as:\")\n","print(\"jakkur_lake_unet.keras\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"iy0AjwK_kEhF","executionInfo":{"status":"ok","timestamp":1787118807183,"user_tz":-330,"elapsed":70571,"user":{"displayName":"Naturesworld","userId":"00808670514782698905"}},"outputId":"332aeb03-e85f-4be7-9324-565df5fba7a5"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["TensorFlow version: 2.20.0\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","     <input type=\"file\" id=\"files-7e2a3f30-990a-4750-a7e2-f2b00b1261cc\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-7e2a3f3